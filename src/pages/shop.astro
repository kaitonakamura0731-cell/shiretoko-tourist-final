    <script is:inline>
      document.querySelectorAll('[data-add-slug]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = btn.dataset.addSlug;
          const name = btn.dataset.addName;
          const price = parseInt(btn.dataset.addPrice, 10);
          if (window.cart && slug && name && Number.isFinite(price)) {
            window.cart.add(slug, name, price, 1);
          }
        });
      });

      // 送料無料カウンター
      (function () {
        const THRESHOLD = 5000;
        const remainEl = document.querySelector('[data-shipping-remain]');
        const remainAmount = document.querySelector('[data-remain-amount]');
        const doneEl = document.querySelector('[data-shipping-done]');
        function fmtYen(n) { return '¥' + n.toLocaleString('ja-JP'); }
        function update() {
          const sub = window.cart && window.cart.subtotal ? window.cart.subtotal() : 0;
          if (sub <= 0) {
            if (remainEl) { remainEl.hidden = true; }
            if (doneEl) doneEl.hidden = true;
            return;
          }
          const remain = THRESHOLD - sub;
          if (remain > 0) {
            if (remainAmount) remainAmount.textContent = fmtYen(remain);
            if (remainEl) remainEl.hidden = false;
            if (doneEl) doneEl.hidden = true;
          } else {
            if (remainEl) remainEl.hidden = true;
            if (doneEl) doneEl.hidden = false;
          }
        }
        update();
        document.addEventListener('cart:change', update);
        window.addEventListener('storage', update);
      })();
    </script>

