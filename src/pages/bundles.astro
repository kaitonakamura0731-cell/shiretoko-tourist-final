---
// セット販売 — 店主が組む5つのバンドル
import "../styles/global.css";
import { bundles } from "../data/bundles";
import { productImageForKey } from "../data/sourceImages";
import { products } from "../data/products";

const meta = {
  title: "セット販売｜北の逸品堂 (知床ツーリスト)",
  description:
    "店主が組む、5つのセット。北海道の旬を組み合わせた割引バンドル。アスパラ + じゃがいも、Patagonia レイヤリング、家族便など。",
};

const yen = (n: number) => `¥${n.toLocaleString("ja-JP")}`;

const cards = bundles.map((b) => {
  const img = productImageForKey(b.imageKey, b.title);
  const itemTitles = b.items.map((slug) => {
    const p = products.find((x) => x.slug === slug);
    return p ? p.title : slug;
  });
  return { ...b, img, itemTitles };
});
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
<script src="/cart.js" is:inline></script>
</head>
<body class="page-listing">

<div class="topbar">6月限定 / アスパラ・じゃがいも・玉ねぎを北海道から直送中 ・ ¥5,000以上で<b>送料無料</b></div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark">北の逸品堂</span>
      <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
    </a>
    <nav class="gnav" aria-label="主要メニュー">
      <a href="/products/specialty/">産直</a>
      <a href="/products/apparel/">アパレル</a>
      <a href="/bundles/" class="is-tour">セット</a>
      <a href="/gift/">ギフト</a>
      <a href="/#story">ストーリー</a>
    </nav>
    <div class="header-utility">
      <a href="/cart" class="utility-cart" data-cart-link>カート (0)</a>
      <details class="mobile-nav">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <ul>
          <li><a href="/products/specialty/">産直</a></li>
          <li><a href="/products/apparel/">アパレル</a></li>
          <li><a href="/bundles/">セット</a></li>
          <li><a href="/gift/">ギフト</a></li>
          <li><a href="/#story">ストーリー</a></li>
          <li><a href="/cart">カート</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<section class="listing-hero">
  <div class="listing-hero__inner">
    <span class="eyebrow">COLLECTIONS ・ セット販売</span>
    <h1 class="mincho">店主が組む、<br />5つのセット。</h1>
    <p>
      畑とアパレル、家族便とギフト。北海道・知床/オホーツクの旬を、店主の視点で組み合わせました。
      単品で揃えるよりお得な、5種類のバンドルです。
    </p>
  </div>
</section>

<section class="bundles">
  <div class="bundles__inner">
    {cards.map((b, idx) => (
      <article class="bundle-card" id={b.slug}>
        <div class="bundle-card__media">
          {b.img.src ? (
            <img src={b.img.src} alt={b.img.alt} loading="lazy" decoding="async" />
          ) : (
            <div class="bundle-card__placeholder" aria-hidden="true">no image</div>
          )}
          <span class="bundle-card__no">{String(idx + 1).padStart(2, "0")}</span>
        </div>
        <div class="bundle-card__body">
          <div class="bundle-card__tags">
            {b.gift && <span class="tag tag--brand">ギフト対応</span>}
            <span class="tag">{b.seasonNote}</span>
          </div>
          <h2 class="mincho bundle-card__title">{b.title}</h2>
          <p class="bundle-card__desc">{b.description}</p>

          <ul class="bundle-card__items">
            {b.itemTitles.map((t) => (
              <li><span aria-hidden="true">・</span>{t}</li>
            ))}
          </ul>

          <div class="bundle-card__price">
            {b.discount > 0 ? (
              <>
                <span class="bundle-card__price-orig">{yen(b.originalPrice)}</span>
                <span class="bundle-card__price-now">{yen(b.bundlePrice)}</span>
                <span class="bundle-card__badge">{yen(b.discount)} OFF</span>
              </>
            ) : (
              <>
                <span class="bundle-card__price-now">{yen(b.bundlePrice)}</span>
                <span class="bundle-card__badge bundle-card__badge--gift">化粧箱 + のし込み</span>
              </>
            )}
          </div>

          <blockquote class="bundle-card__memo">
            <span class="bundle-card__memo-mark" aria-hidden="true">”</span>
            {b.storyMemo}
            <footer>— 店主より</footer>
          </blockquote>

          <div class="bundle-card__actions">
            <button
              type="button"
              class="btn btn--primary"
              data-add-bundle={b.slug}
              data-bundle-title={b.title}
              data-bundle-price={b.bundlePrice}
            >
              カゴに追加
            </button>
            <a href="/gift/" class="btn btn--ghost">ギフト対応を見る →</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="bundle-rules">
  <div class="bundle-rules__inner">
    <span class="eyebrow">SET DISCOUNT ・ 同梱割引のご案内</span>
    <h2 class="mincho">セットで買うほど、お得に。</h2>
    <ul class="bundle-rules__list">
      <li>
        <span class="bundle-rules__no">01</span>
        <div>
          <b>3点以上の同時購入で 5% OFF</b>
          <p>セット商品 / 単品問わず、カート合計3点以上で自動的に5%引きになります。</p>
        </div>
      </li>
      <li>
        <span class="bundle-rules__no">02</span>
        <div>
          <b>5点以上の同時購入で 送料無料</b>
          <p>北海道・沖縄を含む全国一律で送料無料。クール便も対象です。</p>
        </div>
      </li>
      <li>
        <span class="bundle-rules__no">03</span>
        <div>
          <b>ギフト対応セットは のし・メッセージカード無料</b>
          <p>「ギフト対応」表示のあるセットは、のし・メッセージカード・配送日指定が標準で含まれます。</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__legal">
      <span>(c) 1992-2026 株式会社 知床ツーリスト. All rights reserved.</span>
      <span class="payments">クレジットカード / コード決済 / 銀行振込</span>
    </div>
  </div>
</footer>

<style>
  .bundles { padding: clamp(40px, 6vw, 80px) 0; background: #F6F3EC; }
  .bundles__inner { max-width: 1120px; margin: 0 auto; padding: 0 24px; display: grid; gap: clamp(32px, 5vw, 56px); }
  .bundle-card {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) 1.2fr;
    gap: clamp(24px, 4vw, 48px);
    background: #fff;
    border: 1px solid rgba(26,26,26,0.08);
    border-radius: 4px;
    overflow: hidden;
    align-items: stretch;
  }
  @media (max-width: 820px) {
    .bundle-card { grid-template-columns: 1fr; }
  }
  .bundle-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #EEEAE0;
  }
  .bundle-card__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 600ms cubic-bezier(.2,.7,.2,1);
  }
  .bundle-card:hover .bundle-card__media img { transform: scale(1.06); }
  .bundle-card__placeholder {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    color: rgba(26,26,26,0.4); font-size: 14px;
  }
  .bundle-card__no {
    position: absolute; top: 16px; left: 16px;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #fff;
    background: rgba(26,26,26,0.7);
    padding: 4px 10px;
    border-radius: 2px;
  }
  .bundle-card__body {
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bundle-card__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    display: inline-block; padding: 4px 10px;
    font-size: 12px; letter-spacing: 0.04em;
    background: #EEEAE0; color: #1A1A1A;
    border-radius: 2px;
  }
  .tag--brand { background: #B99253; color: #fff; }
  .bundle-card__title {
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.4;
    color: #1A1A1A;
    margin: 0;
  }
  .bundle-card__desc { font-size: 15px; line-height: 1.8; color: #444; margin: 0; }
  .bundle-card__items {
    list-style: none; padding: 16px; margin: 0;
    background: #F6F3EC;
    border-left: 2px solid #B99253;
    display: grid; gap: 8px;
    font-size: 14px; color: #1A1A1A;
  }
  .bundle-card__items li span { color: #B99253; margin-right: 6px; }
  .bundle-card__price {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px;
    padding: 16px 0;
    border-top: 1px solid rgba(26,26,26,0.08);
    border-bottom: 1px solid rgba(26,26,26,0.08);
  }
  .bundle-card__price-orig {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    color: rgba(26,26,26,0.5);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }
  .bundle-card__price-now {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3vw, 32px);
    color: #C0392B;
    font-variant-numeric: tabular-nums;
  }
  .bundle-card__badge {
    display: inline-block;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    background: #C0392B;
    border-radius: 2px;
    letter-spacing: 0.04em;
  }
  .bundle-card__badge--gift { background: #B99253; }
  .bundle-card__memo {
    position: relative;
    margin: 0;
    padding: 12px 16px 12px 28px;
    font-size: 14px;
    color: #444;
    background: rgba(60, 129, 134, 0.06);
    border-left: 2px solid #3C8186;
    font-family: "Noto Serif JP", serif;
    line-height: 1.7;
  }
  .bundle-card__memo-mark {
    position: absolute; left: 8px; top: 8px;
    font-size: 24px; color: #3C8186;
    line-height: 1;
  }
  .bundle-card__memo footer {
    margin-top: 6px;
    font-size: 12px;
    color: #3C8186;
    font-family: "Noto Sans JP", sans-serif;
  }
  .bundle-card__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 12px 20px;
    font-size: 14px; font-weight: 600;
    border-radius: 2px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 200ms, color 200ms;
    text-decoration: none;
  }
  .btn--primary { background: #1A1A1A; color: #fff; }
  .btn--primary:hover { background: #3C8186; }
  .btn--ghost { background: transparent; color: #1A1A1A; border-color: #1A1A1A; }
  .btn--ghost:hover { background: #1A1A1A; color: #fff; }

  .bundle-rules {
    background: #1A1A1A; color: #F6F3EC;
    padding: clamp(48px, 7vw, 96px) 0;
  }
  .bundle-rules__inner {
    max-width: 880px; margin: 0 auto; padding: 0 24px;
  }
  .bundle-rules .eyebrow { color: #B99253; }
  .bundle-rules h2 {
    color: #F6F3EC;
    font-size: clamp(24px, 3vw, 36px);
    margin: 8px 0 32px;
  }
  .bundle-rules__list {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 20px;
  }
  .bundle-rules__list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid rgba(246,243,236,0.12);
  }
  .bundle-rules__list li:last-child { border-bottom: 1px solid rgba(246,243,236,0.12); }
  .bundle-rules__no {
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #B99253;
    letter-spacing: 0.08em;
  }
  .bundle-rules__list b {
    display: block;
    font-size: 16px;
    color: #F6F3EC;
    margin-bottom: 6px;
  }
  .bundle-rules__list p {
    margin: 0; font-size: 14px; line-height: 1.7;
    color: rgba(246,243,236,0.7);
  }
</style>

<script is:inline>
(() => {
  document.querySelectorAll('[data-add-bundle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.addBundle;
      const title = btn.dataset.bundleTitle;
      const price = Number(btn.dataset.bundlePrice);
      if (window.cart && typeof window.cart.add === 'function') {
        window.cart.add({ slug, title, price, qty: 1, type: 'bundle' });
      } else {
        try {
          const key = 'cart';
          const cur = JSON.parse(localStorage.getItem(key) || '[]');
          cur.push({ slug, title, price, qty: 1, type: 'bundle' });
          localStorage.setItem(key, JSON.stringify(cur));
        } catch (e) {}
      }
      const orig = btn.textContent;
      btn.textContent = 'カゴに追加しました ✓';
      btn.disabled = true;
      setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 1600);
    });
  });
})();
</script>
</body>
</html>
