---
// ふるさと納税案内 — 清里町 / 斜里町
import "../styles/global.css";
import { municipalities, items, intro, itemsByMunic, findMunic } from "../data/furusato";

const meta = {
  title: "ふるさと納税｜清里町・斜里町への寄付案内｜北の逸品堂",
  description:
    "知床の麓、清里町と斜里町。北の逸品堂が普段お付き合いしている生産者の品を、ふるさと納税の返礼品としてご案内します。",
};

const yen = (n: number) => `¥${n.toLocaleString("ja-JP")}`;
const num = (n: number) => n.toLocaleString("ja-JP");

const cards = items.map((it) => {
  const m = findMunic(it.munic);
  return { ...it, municName: m?.name ?? "" };
});
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="page-listing">

<div class="topbar">FURUSATO ・ 清里町 / 斜里町 への寄付返礼品ご案内 ・ 北の逸品堂が仲介します</div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark">北の逸品堂</span>
      <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
    </a>
    <nav class="gnav" aria-label="主要メニュー">
      <a href="/products/specialty/">産直</a>
      <a href="/products/apparel/">アパレル</a>
      <a href="/bundles/">セット</a>
      <a href="/stories/">ストーリー</a>
      <a href="/ranking/">ランキング</a>
    </nav>
    <div class="header-utility">
      <a href="/account/" class="utility-link">マイページ</a>
      <a href="/cart" class="utility-cart" data-cart-link>カート (0)</a>
      <details class="mobile-nav">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <ul>
          <li><a href="/products/specialty/">産直</a></li>
          <li><a href="/products/apparel/">アパレル</a></li>
          <li><a href="/bundles/">セット</a></li>
          <li><a href="/stories/">ストーリー</a></li>
          <li><a href="/ranking/">ランキング</a></li>
          <li><a href="/gift/">ギフト</a></li>
          <li><a href="/furusato/" class="is-tour">ふるさと納税</a></li>
          <li><a href="/account/">マイページ</a></li>
          <li><a href="/cart">カート</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<main>
  <nav class="breadcrumbs" aria-label="パンくず">
    <div class="breadcrumbs__inner">
      <a href="/">トップ</a> <span class="sep">/</span>
      <span class="current">FURUSATO</span>
    </div>
  </nav>

  <section class="listing-hero">
    <div class="listing-hero__inner">
      <span class="eyebrow">FURUSATO ・ ふるさと納税</span>
      <h1 class="mincho">知床から、ふるさとへ。</h1>
      <p>
        清里町と斜里町。北の逸品堂が33年お付き合いしてきた、ふたつの町。
        畑と港の景色を、ふるさと納税という形でお届けします。
      </p>
    </div>
  </section>

  <section class="why-here">
    <div class="why-here__inner">
      <span class="section-eyebrow">WHY HERE ・ なぜこの二町か</span>
      <h2 class="mincho why-here__title">{intro.whyHere.title}</h2>
      <div class="why-here__body">
        {intro.whyHere.body.split("\n").map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <h3 class="mincho why-here__sub">{intro.relationship.title}</h3>
      <div class="why-here__body">
        {intro.relationship.body.split("\n").map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="munic-section">
    <div class="munic-section__inner">
      <span class="section-eyebrow">MUNICIPALITIES ・ 寄付先のふたつの町</span>
      <h2 class="mincho munic-section__title">清里町 と 斜里町。</h2>
      <p class="munic-section__lead">
        北海道オホーツク管内、知床半島の付け根に隣り合うふたつの町。北の逸品堂は清里町に本社を置き、斜里町の漁師・農家とも日々顔を合わせています。
      </p>

      <div class="munic-grid">
        {municipalities.map((m) => (
          <article class="munic-card">
            <div class="munic-card__head">
              <span class="munic-card__code">CODE {m.code}</span>
              <h3 class="mincho munic-card__name">{m.name}</h3>
              <p class="munic-card__tag">{m.tagline}</p>
            </div>
            <dl class="munic-card__stats">
              <div>
                <dt>人口</dt>
                <dd><span class="tnum">{num(m.population)}</span> 人</dd>
              </div>
              <div>
                <dt>位置</dt>
                <dd><span class="tnum">{m.lat.toFixed(2)}°N / {m.lng.toFixed(2)}°E</span></dd>
              </div>
            </dl>
            <div class="munic-card__spec">
              <span class="munic-card__spec-label">主な特産品</span>
              <ul>
                {m.specialties.map((s) => (
                  <li><span aria-hidden="true">・</span>{s}</li>
                ))}
              </ul>
            </div>
            <a href={`#munic-${m.code}`} class="munic-card__link">この町の返礼品を見る →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="items-section">
    <div class="items-section__inner">
      <span class="section-eyebrow">RETURN GIFTS ・ 返礼品一覧</span>
      <h2 class="mincho items-section__title">返礼品 <span class="tnum">{items.length}</span> 品。</h2>
      <p class="items-section__lead">
        北の逸品堂が日頃から仕入れている、清里町・斜里町の生産者の品。寄付額・配送条件は各自治体ポータルで最終確認をお願いします。
      </p>

      {municipalities.map((m) => (
        <div class="items-block" id={`munic-${m.code}`}>
          <div class="items-block__head">
            <span class="items-block__badge">{m.name}</span>
            <h3 class="mincho items-block__title">{m.name} の返礼品</h3>
            <span class="items-block__count tnum">{itemsByMunic(m.code).length} 品</span>
          </div>
          <div class="items-grid">
            {itemsByMunic(m.code).map((it) => (
              <article class="item-card">
                <div class="item-card__media" aria-hidden="true">
                  <span class="item-card__placeholder">{m.name}</span>
                </div>
                <div class="item-card__body">
                  <span class="item-card__munic">{m.name}</span>
                  <h4 class="mincho item-card__title">{it.title}</h4>
                  <p class="item-card__desc">{it.description}</p>
                  <div class="item-card__foot">
                    <div class="item-card__donation">
                      <span class="item-card__donation-label">寄付額</span>
                      <span class="item-card__donation-value tnum">{yen(it.donation)}</span>
                    </div>
                    <a href="#portals" class="item-card__cta">ポータルで申し込む →</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="steps-section">
    <div class="steps-section__inner">
      <span class="section-eyebrow">HOW IT WORKS ・ 寄付控除の使い方</span>
      <h2 class="mincho steps-section__title">寄付から控除まで、3ステップ。</h2>

      <ol class="steps">
        <li class="step">
          <span class="step__no">01</span>
          <h3 class="mincho step__title">寄付する</h3>
          <p class="step__desc">
            さとふる・楽天ふるさと納税など各ポータルから、清里町または斜里町を選んで寄付。
            返礼品 (返礼率の目安は寄付額の3割前後) を選択します。
          </p>
        </li>
        <li class="step step--arrow" aria-hidden="true">→</li>
        <li class="step">
          <span class="step__no">02</span>
          <h3 class="mincho step__title">返礼品を受け取る</h3>
          <p class="step__desc">
            自治体から「寄附金受領証明書」が郵送されます。
            返礼品は生産者・北の逸品堂などから、季節に合わせて発送されます (商品により時期が異なります)。
          </p>
        </li>
        <li class="step step--arrow" aria-hidden="true">→</li>
        <li class="step">
          <span class="step__no">03</span>
          <h3 class="mincho step__title">確定申告または ワンストップ特例</h3>
          <p class="step__desc">
            寄附金受領証明書を使って確定申告するか、条件を満たせばワンストップ特例制度で申告不要。
            寄付額のうち <span class="tnum">2,000</span> 円を超える部分が、所得税・住民税から控除される場合があります。
          </p>
        </li>
      </ol>

      <div class="tax-note">
        <h3 class="mincho">{intro.taxNote.title}</h3>
        {intro.taxNote.body.split("\n").map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="portals" id="portals">
    <div class="portals__inner">
      <span class="eyebrow">PORTALS ・ ふるさと納税ポータルへ</span>
      <h2 class="mincho">実際のお申し込みは、各ポータルから。</h2>
      <p class="portals__lead">
        北の逸品堂は仲介事業者として、生産者と寄付者の間をつなぐ役割を担います。
        実際の寄付・決済・受領証明書の発行は、各自治体提携のポータルサイトを通じて行ってください。
      </p>
      <div class="portals__cards">
        <a href="#" class="portal-card" rel="noopener" aria-label="さとふる (モック)">
          <span class="portal-card__name">さとふる</span>
          <span class="portal-card__desc">清里町・斜里町 取扱あり</span>
          <span class="portal-card__cta">ポータルへ →</span>
        </a>
        <a href="#" class="portal-card" rel="noopener" aria-label="楽天ふるさと納税 (モック)">
          <span class="portal-card__name">楽天ふるさと納税</span>
          <span class="portal-card__desc">楽天ポイント還元あり</span>
          <span class="portal-card__cta">ポータルへ →</span>
        </a>
        <a href="#" class="portal-card" rel="noopener" aria-label="ふるなび (モック)">
          <span class="portal-card__name">ふるなび</span>
          <span class="portal-card__desc">家電・特産品ラインナップ</span>
          <span class="portal-card__cta">ポータルへ →</span>
        </a>
      </div>
      <p class="portals__caveat">
        ※ 上記リンクは本サイト内では遷移しないモック表示です。実際の寄付申し込み先は各自治体公式ページよりご確認ください。
      </p>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__legal">
      <span>(c) 1992-2026 株式会社 知床ツーリスト. All rights reserved.</span>
      <span class="payments">クレジットカード / コード決済 / 銀行振込</span>
    </div>
  </div>
</footer>

<style>
  /* breadcrumbs */
  .breadcrumbs { background: #F6F3EC; padding: 16px 24px 0; }
  .breadcrumbs__inner {
    max-width: 1120px; margin: 0 auto;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(26,26,26,0.6);
  }
  .breadcrumbs a { color: rgba(26,26,26,0.6); text-decoration: none; }
  .breadcrumbs a:hover { color: #3C8186; }
  .breadcrumbs .sep { margin: 0 10px; }
  .breadcrumbs .current { color: #1A1A1A; font-weight: 600; }

  .section-eyebrow,
  .eyebrow {
    display: inline-block;
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #B99253;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .tnum { font-family: "Inter", "Noto Sans JP", sans-serif; font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }

  /* WHY HERE */
  .why-here { background: #F6F3EC; padding: clamp(56px, 8vw, 96px) 24px; }
  .why-here__inner { max-width: 820px; margin: 0 auto; }
  .why-here__title {
    font-size: clamp(24px, 3.2vw, 36px);
    line-height: 1.5;
    color: #1A1A1A;
    margin: 0 0 24px;
  }
  .why-here__sub {
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.5;
    color: #1A1A1A;
    margin: 40px 0 16px;
    padding-top: 32px;
    border-top: 1px solid rgba(26,26,26,0.12);
  }
  .why-here__body p {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 15px;
    line-height: 1.95;
    color: #1A1A1A;
    opacity: 0.82;
    margin: 0 0 16px;
  }

  /* MUNIC */
  .munic-section { background: #fff; padding: clamp(56px, 8vw, 96px) 24px; }
  .munic-section__inner { max-width: 1120px; margin: 0 auto; }
  .munic-section__title {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.5;
    color: #1A1A1A;
    margin: 0 0 16px;
  }
  .munic-section__lead {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 15px;
    line-height: 1.9;
    color: #1A1A1A;
    opacity: 0.78;
    max-width: 720px;
    margin: 0 0 40px;
  }
  .munic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 32px);
  }
  @media (max-width: 760px) {
    .munic-grid { grid-template-columns: 1fr; }
  }
  .munic-card {
    background: #F6F3EC;
    border: 1px solid rgba(26,26,26,0.08);
    border-radius: 4px;
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .munic-card__head { border-bottom: 1px solid rgba(26,26,26,0.1); padding-bottom: 16px; }
  .munic-card__code {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: #B99253;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .munic-card__name {
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.3;
    color: #1A1A1A;
    margin: 0 0 8px;
  }
  .munic-card__tag {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 13.5px;
    line-height: 1.7;
    color: #1A1A1A;
    opacity: 0.72;
    margin: 0;
  }
  .munic-card__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0;
  }
  .munic-card__stats dt {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(26,26,26,0.5);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .munic-card__stats dd {
    font-family: "Noto Serif JP", serif;
    font-size: 16px;
    color: #1A1A1A;
    margin: 0;
    font-weight: 600;
  }
  .munic-card__spec-label {
    display: block;
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(26,26,26,0.5);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .munic-card__spec ul {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 6px;
  }
  .munic-card__spec li {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #1A1A1A;
    opacity: 0.85;
  }
  .munic-card__spec li span { color: #B99253; margin-right: 6px; }
  .munic-card__link {
    align-self: flex-start;
    margin-top: auto;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #3C8186;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #3C8186;
    padding-bottom: 2px;
    text-decoration: none;
  }

  /* ITEMS */
  .items-section { background: #F6F3EC; padding: clamp(56px, 8vw, 96px) 24px; }
  .items-section__inner { max-width: 1120px; margin: 0 auto; }
  .items-section__title {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.4;
    color: #1A1A1A;
    margin: 0 0 16px;
  }
  .items-section__lead {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 15px;
    line-height: 1.9;
    color: #1A1A1A;
    opacity: 0.78;
    max-width: 720px;
    margin: 0 0 48px;
  }
  .items-block { margin-top: 56px; scroll-margin-top: 32px; }
  .items-block:first-of-type { margin-top: 0; }
  .items-block__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(26,26,26,0.12);
  }
  .items-block__badge {
    display: inline-block;
    padding: 4px 12px;
    background: #B99253;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 2px;
  }
  .items-block__title {
    font-size: clamp(20px, 2.4vw, 26px);
    color: #1A1A1A;
    margin: 0;
    flex: 1;
  }
  .items-block__count {
    font-size: 13px;
    color: rgba(26,26,26,0.6);
  }
  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: clamp(20px, 3vw, 32px);
  }
  .item-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(26,26,26,0.08);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 240ms cubic-bezier(.2,.7,.2,1);
  }
  .item-card:hover { transform: translateY(-2px); }
  .item-card__media {
    aspect-ratio: 1 / 1;
    background: #EEEAE0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .item-card__placeholder {
    font-family: "Noto Serif JP", serif;
    font-size: 18px;
    color: rgba(26,26,26,0.4);
    letter-spacing: 0.08em;
  }
  .item-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .item-card__munic {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #B99253;
    text-transform: uppercase;
  }
  .item-card__title {
    font-size: 17px;
    line-height: 1.5;
    color: #1A1A1A;
    margin: 0;
  }
  .item-card__desc {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 13.5px;
    line-height: 1.85;
    color: #1A1A1A;
    opacity: 0.78;
    margin: 0;
    flex: 1;
  }
  .item-card__foot {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(26,26,26,0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .item-card__donation {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .item-card__donation-label {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 12px;
    color: rgba(26,26,26,0.6);
  }
  .item-card__donation-value {
    font-weight: 700;
    font-size: 20px;
    color: #1A1A1A;
  }
  .item-card__cta {
    align-self: flex-start;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #3C8186;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #3C8186;
    padding-bottom: 2px;
    text-decoration: none;
  }

  /* STEPS */
  .steps-section { background: #fff; padding: clamp(56px, 8vw, 96px) 24px; }
  .steps-section__inner { max-width: 1080px; margin: 0 auto; }
  .steps-section__title {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.4;
    color: #1A1A1A;
    margin: 0 0 40px;
  }
