---
// 北の逸品堂 / 知床ツーリスト — TOPページモック (Slim版: 8セクション)
// 構成: ヘッダ → ヒーロー → 信頼バッジ3点 → 季節カレンダー → 今週のおすすめ3商品
//       → ツアー予約特集(決定打) → ストーリー → リテンション → フッタ
// 既存ブランド #3C8186 / #B99253 を主軸、日本語タイポ主役、AIスロップ禁忌厳守。
import "../styles/global.css";
import { productImageForKey, siteMedia as media } from "../data/sourceImages";
import { products, formatYen } from "../data/products";

const meta = {
  title: "オホーツク産アスパラ通販と知床ガイドツアー予約｜北の逸品堂(1992清里町)",
  description: "6月限定オホーツク産アスパラ¥5,800送料込。世界自然遺産・知床の現場ガイドが選ぶ北の食材と、店主と歩く知床ツアー。1992年清里町から産地直送。",
};

const productBySlug = new Map(products.map((product) => [product.slug, product]));
const featuredSlugs = ["asparagus-1kg", "potato-onion-set", "potato-danshaku-30kg", "patagonia-r1-air-hoodie", "patagonia-r1-zip-neck"];

// 今週のおすすめ — 特産品 + Patagonia を同じ棚で見せる
const ranking = featuredSlugs
  .map((slug, index) => {
    const product = productBySlug.get(slug);
    if (!product) return null;

    return {
      ...product,
      rank: `${index + 1}位`,
      priceLabel: formatYen(product.price),
      unit: product.priceUnit,
      stock: product.stockLabel,
      low: product.stock <= 5,
      image: productImageForKey(product.imageKey, product.title),
    };
  })
  .filter(Boolean);

const bundles = [
  {
    season: "SPRING TRIP",
    title: "朝採りアスパラ + R1 Air Hoodie",
    desc: "初夏の知床に来る人にも、北海道ギフトを贈る人にも。届いた食材から旅支度まで、同じ店主の目利きで選べるセット提案。",
    primary: ranking[0],
    secondary: ranking[2],
    note: "EC購入でツアー予約 ¥1,000 OFF",
  },
  {
    season: "GIFT & DAILY",
    title: "じゃがいも・玉ねぎ + 現場フリース",
    desc: "保存のきく定番野菜と、長く着られるアウトドアウェアを同じカートへ。単品購入で終わらせず、客単価を自然に上げる導線です。",
    primary: ranking[1],
    secondary: ranking[2],
    note: "¥5,000以上で送料無料 / まとめ買い向き",
  },
  {
    season: "TOUR AFTER",
    title: "旅のあとに届く、北の定期便",
    desc: "知床を歩いた記憶を、季節の食材と店主の道具選びでリピート購入へ。OTAでは作れない自社サイトならではの関係性を育てます。",
    primary: ranking[0],
    secondary: ranking[1],
    note: "LINE登録で再入荷・収穫速報",
  },
];

const tours = [
  { period: "春-秋 / 6-10月", title: "知床五湖ガイドハイキング", desc: "世界自然遺産・知床五湖を、現場ガイドが半日でご案内。ヒグマ対応の正式登録ガイドが同行します。", price: "¥6,800", unit: "/ 大人1名" },
  { period: "冬 / 1-3月", title: "北海道流氷熱気球フリーフライト", desc: "冬期限定・流氷の上を熱気球で飛ぶ。鳥と同じ目線でオホーツクを見渡す非日常体験。", price: "¥38,000", unit: "/ 大人1名" },
  { period: "冬 / 12-3月", title: "神の子池スノーシューツアー", desc: "凍らずに青く湧き出る神の子池まで、スノーシューで歩く半日コース。装備一式レンタル込。", price: "¥7,500", unit: "/ 大人1名" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href="https://kitanoippindo.example.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:site_name" content="北の逸品堂 / 知床ツーリスト" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "#org",
          "name": "株式会社 知床ツーリスト",
          "alternateName": "北の逸品堂",
          "url": "https://kitanoippindo.example.com/",
          "foundingDate": "1992",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "字向陽282番地",
            "addressLocality": "清里町",
            "addressRegion": "北海道斜里郡",
            "postalCode": "099-4403",
            "addressCountry": "JP"
          },
          "telephone": "+81-152-25-2642"
        },
        {
          "@type": "TravelAgency",
          "name": "知床ツーリスト",
          "parentOrganization": { "@id": "#org" },
          "identifier": "北海道知事登録旅行業 第2-453号",
          "memberOf": "全国旅行業協会 (ANTA)",
          "areaServed": { "@type": "Place", "name": "知床・オホーツク・清里町・斜里町" }
        }
      ]
    })}></script>
    <script src="/cart.js" is:inline></script>
  </head>
  <body>
    <!-- ============ 上部告知バー ============ -->
    <div class="topbar">
      6月限定 / アスパラ・じゃがいも・玉ねぎを北海道から直送中 ・ ¥5,000以上で<b>送料無料</b> ・ <a href="#retention">LINE登録で¥500 OFF</a>
    </div>

    <!-- ============ ヘッダ ============ -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark">北の逸品堂</span>
          <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
        </a>
        <nav class="gnav" aria-label="主要メニュー">
          <a href="#ranking">特産品 ・ アパレル</a>
          <a href="#bundles">セット提案</a>
          <a href="#tour" class="is-tour">ツアー予約</a>
          <a href="#story">ストーリー</a>
          <a href="#company">会社</a>
        </nav>
        <div class="header-utility">
          <a href="#login" class="utility-link">ログイン</a>
          <a href="/cart" class="utility-cart" data-cart-link>カート (0)</a>
          <details class="mobile-nav">
            <summary aria-label="メニューを開く">
              <span></span><span></span><span></span>
            </summary>
            <ul>
              <li><a href="#ranking">特産品・アパレル</a></li>
              <li><a href="#bundles">セット提案</a></li>
              <li><a href="#tour">ツアー予約</a></li>
              <li><a href="#story">ストーリー</a></li>
              <li><a href="/cart">カート</a></li>
              <li><a href="#company">会社</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ ヒーロー ============ -->
      <section class="hero" aria-label="ヒーロー">
        <div class="hero__inner">
          <div class="hero__copy">
            <span class="hero__eyebrow">世界遺産・知床から、店主直送。</span>
            <h1>
              北の食材と、現場で使う一着。<br />
              <span class="accent">知床の旅まで、ひとつの店で。</span>
            </h1>
            <p class="lead">
              1992年から清里町で、ユースホステル・自然ガイド・旅行業を続けてきた知床ツーリストの公式EC。
              世界自然遺産・知床のガイドが選ぶ北の食材、店主が現場で使うアウトドアウェア、旅の予約をひとつのサイトで。
            </p>
            <div class="hero__meta">
              <span>北海道知事登録旅行業 第2-453号</span>
              <span>1992年・清里町から33年</span>
              <span>産地直送・店主厳選</span>
            </div>
            <div class="hero__cta">
              <a href="#ranking" class="btn btn--primary">朝採りアスパラを買う</a>
              <a href="#bundles" class="btn btn--outline">食と道具をセットで見る</a>
            </div>
          </div>
          <div class="hero__visual">
            {media.hero.src ? (
              <img src={media.hero.src} alt={media.hero.alt} decoding="async" />
            ) : (
              <div class="source-placeholder source-placeholder--hero" role="img" aria-label={`${media.hero.alt}の画像枠`}>
                <span>{media.hero.label}</span>
                <small>assets/source-images に画像を追加</small>
              </div>
            )}
            <span class="hero__caption">イメージ: 斜里岳・オホーツク海 / 清里町</span>
          </div>
        </div>
      </section>

      <!-- ============ 信頼バッジ帯（3点に簡素化） ============ -->
      <section class="trust-band" aria-label="信頼指標">
        <div class="trust-band__inner">
          <span><b>1992年</b> 清里町で創業<small>(33年)</small></span>
          <span><b>北海道知事登録</b> 旅行業 第2-453号<small>(2003-)</small></span>
          <span>産地・収穫日を<b>商品ページに明記</b></span>
        </div>
      </section>

      <!-- ============ 季節カレンダー（年間サイクル＝LTV設計の可視化） ============ -->
      <section class="season-band" aria-label="季節カレンダー">
        <div class="season-band__inner">
          <span class="section-eyebrow">SEASONAL CALENDAR</span>
          <h2>北の年間カレンダー</h2>
          <hr class="section-rule" />
          <div class="season-grid">
            <div class="season-cell season-cell--spring">
              <div class="season-cell__bar"></div>
              <div class="season-cell__season">春</div>
              <div class="season-cell__period">APR – MAY</div>
              <div class="season-cell__items">山菜・行者にんにく<br />清里町の遅い春の便り</div>
            </div>
            <div class="season-cell season-cell--summer is-now">
              <div class="season-cell__bar"></div>
              <span class="now-tag">NOW</span>
              <div class="season-cell__season">夏</div>
              <div class="season-cell__period">JUN – AUG</div>
              <div class="season-cell__items">アスパラ・じゃがいも・玉ねぎ<br />知床五湖ガイドツアー</div>
            </div>
            <div class="season-cell season-cell--autumn">
              <div class="season-cell__bar"></div>
              <div class="season-cell__season">秋</div>
              <div class="season-cell__period">SEP – NOV</div>
              <div class="season-cell__items">きのこ・北海道米<br />オホーツク鮭フレーク</div>
            </div>
            <div class="season-cell season-cell--winter">
              <div class="season-cell__bar"></div>
              <div class="season-cell__season">冬</div>
              <div class="season-cell__period">DEC – MAR</div>
              <div class="season-cell__items">流氷熱気球フリーフライト<br />神の子池スノーシュー</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ 今週のおすすめ3商品（特産品2＋アパレル1 統合） ============ -->
      <section class="section section--white" id="ranking" aria-label="今週のおすすめ">
        <div class="section__inner">
          <span class="section-eyebrow">PICK UP</span>
          <h2>今週のおすすめ</h2>
          <hr class="section-rule" />
          <div class="ranking ranking--wide">
            {ranking.map((item) => (
              <article class="ranking-card">
                <a href={`/products/${item.slug}`} class="ranking-card__link" aria-label={`${item.title}の詳細を見る`}>
                <span class="ranking-card__rank">{item.rank}</span>
                <span class={`ranking-card__badge ranking-card__badge--${item.badge.toLowerCase()}`}>{item.badge}</span>
                {item.low && <span class="ranking-card__lowbadge">残り僅か</span>}
                <div class="ranking-card__img" data-image-key={item.imageKey}>
                  {item.image.src ? (
                    <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
                  ) : (
                    <div class="source-placeholder" role="img" aria-label={`${item.image.alt}の画像枠`}>
                      <span>{item.image.label}</span>
                      <small>画像を追加</small>
                    </div>
                  )}
                </div>
                <div class="ranking-card__body">
                  <span class="ranking-card__origin">{item.origin}</span>
                  <p class="ranking-card__title">{item.title}</p>
                  <div class="ranking-card__meta">
                    <span class={item.low ? "ranking-card__stock low" : "ranking-card__stock"}>{item.stock}</span>
                    <span class="ranking-card__delivery">{item.delivery}</span>
                  </div>
                  <span class="ranking-card__price">
                    {item.priceLabel}
                    <small>{item.unit}</small>
                  </span>
                </div>
                </a>
                <div class="ranking-card__actions">
                  <button
                    type="button"
                    class="ranking-card__cart"
                    aria-label={`${item.title}をカートに追加`}
                    data-add-slug={item.slug}
                    data-add-name={item.title}
                    data-add-price={String(item.price)}
                  >
                    カゴに追加
                  </button>
                </div>
              </article>
            ))}
          </div>
          <p class="ranking-note">
            特産品（食）<b>84商品</b> ／ アウトドアウェア（Patagonia等）<b>533商品</b> から、まずは売れ筋5商品を商品ページ化。
            <a href="#">全商品を見る →</a>
          </p>
        </div>
      </section>

      <!-- ============ 特産品 + アパレル 併売提案 ============ -->
      <section class="bundle-section" id="bundles" aria-label="セット提案">
        <div class="bundle-section__inner">
          <span class="section-eyebrow">BUY TOGETHER</span>
          <h2>食と道具を、同じストーリーで選ぶ。</h2>
          <hr class="section-rule" />
          <p class="bundle-section__lead">
            「特産品だけ」「アパレルだけ」に分けず、知床で暮らす店主の目利きを軸に買い合わせを提案します。
            贈る、食べる、着る、旅に出るまでをひとつにすると、客単価とリピートの両方が伸ばせます。
          </p>
          <div class="bundle-grid">
            {bundles.map((bundle) => (
              <article class="bundle-card">
                <div class="bundle-card__media" aria-hidden="true">
                  <div class="bundle-card__image" data-image-key={bundle.primary.imageKey}>
                    {bundle.primary.image.src ? (
                      <img src={bundle.primary.image.src} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <div class="source-placeholder">
                        <span>{bundle.primary.image.label}</span>
                        <small>画像を追加</small>
                      </div>
                    )}
                  </div>
                  <div class="bundle-card__image" data-image-key={bundle.secondary.imageKey}>
                    {bundle.secondary.image.src ? (
                      <img src={bundle.secondary.image.src} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <div class="source-placeholder">
                        <span>{bundle.secondary.image.label}</span>
                        <small>画像を追加</small>
                      </div>
                    )}
                  </div>
                </div>
                <div class="bundle-card__body">
                  <span class="bundle-card__season">{bundle.season}</span>
                  <h3>{bundle.title}</h3>
                  <p>{bundle.desc}</p>
                  <div class="bundle-card__note">{bundle.note}</div>
                  <a href="#ranking" class="btn btn--ghost">この組み合わせを見る</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ ツアー予約特集（決定打） ============ -->
      <section class="tour-feature" id="tour" aria-label="ツアー予約">
        <div class="tour-feature__inner">
          <span class="section-eyebrow">TOUR BOOKING</span>
          <h2>店主と歩く、知床。</h2>
          <hr class="section-rule" />
          <p class="lead">
            知床ツーリストは、北海道知事登録旅行業 第2-453号を持つ正規の旅行業者です。
            知床五湖の現場ガイドが運営するので、じゃらん・アソビュー等のOTAでは予約できない少人数枠もこちらから。
            <strong>OTA手数料分を還元 — 同条件で当サイトが最安です。</strong>
          </p>
          <ul class="tour-feature__perks">
            <li><b>EC × ツアー 連動特典</b> 特産品ご購入で次回ツアー¥1,000 OFF / ツアーご予約で次回EC送料無料</li>
            <li><b>適用条件</b> クーポンは購入後90日有効・1注文1枚・併用不可・お一人様1回限り</li>
            <li><b>キャンセル料</b> 前日までは無料（流氷気球など天候依存ツアーは当日中止判定でも全額返金）</li>
          </ul>

          <div class="tour-hero">
            {media.tourHero.src ? (
              <img src={media.tourHero.src} alt={media.tourHero.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="source-placeholder source-placeholder--dark" role="img" aria-label={`${media.tourHero.alt}の画像枠`}>
                <span>{media.tourHero.label}</span>
                <small>assets/source-images に画像を追加</small>
              </div>
            )}
            <div class="tour-hero__overlay">
              <strong>知床五湖ガイドハイキング</strong>
              <span>世界自然遺産 / 認定ガイド同行・少人数制</span>
            </div>
          </div>

          <div class="tour-grid">
            {tours.map((tour) => (
              <a href="#" class="tour-card">
                <span class="tour-card__period">{tour.period}</span>
                <h3 class="tour-card__title">{tour.title}</h3>
                <p class="tour-card__desc">{tour.desc}</p>
                <div class="tour-card__meta">
                  <span>カレンダーで空きを見る</span>
                  <span class="tour-card__price">{tour.price}<small>{tour.unit}</small></span>
                </div>
              </a>
            ))}
          </div>

          <div class="tour-feature__cta">
            <a href="#" class="btn btn--outline">8つのツアーをすべて見る</a>
          </div>
        </div>
      </section>

      <!-- ============ ストーリー ============ -->
      <section class="story" id="story" aria-label="ストーリー">
        <div class="story__inner">
          <div class="story__portrait">
            {media.story.src ? (
              <img src={media.story.src} alt={media.story.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="source-placeholder source-placeholder--portrait" role="img" aria-label={`${media.story.alt}の画像枠`}>
                <span>{media.story.label}</span>
                <small>画像を追加</small>
              </div>
            )}
          </div>
          <div class="story__copy">
            <span class="section-eyebrow">OUR STORY</span>
            <h2>1992年、清里町から。</h2>
            <hr class="section-rule" />
            <p>
              代表の石田富雄は、東京から清里町に移り、1992年に小さなユースホステルを始めました。
              熱気球、自然ガイド、旅行業と、知床とオホーツクの自然のなかで生きる仕事を、ひとつずつ増やしてきました。
              「北の逸品堂」は、その33年で出会った農家、漁師、メーカーと、店主自身が現場で使う道具を並べる店です。
            </p>
            <ul class="story__chronology">
              <li><span class="year">1992</span><span>清里町でユースホステル開業</span></li>
              <li><span class="year">1996</span><span>熱気球事業開始</span></li>
              <li><span class="year">2000</span><span>自然ガイド事業開始</span></li>
              <li><span class="year">2002</span><span>株式会社 知床ツーリスト 法人化</span></li>
              <li><span class="year">2003</span><span>北海道知事登録旅行業 第2-453号</span></li>
            </ul>
            <p class="story__credit">
              「特産品もアパレルも、知床のガイドも、ぜんぶ同じ人間がやっています。」<br />
              — 代表 石田 富雄
            </p>
          </div>
        </div>
      </section>

      <!-- ============ リテンション（メルマガ + LINE） ============ -->
      <section class="retention" id="retention" aria-label="メルマガ・LINE登録">
        <div class="retention__inner">
          <div class="retention__card">
            <h3>店主の「今月の収穫便り」</h3>
            <p>収穫期・出荷開始・季節限定品の入荷を、月に1-2通だけお届けします。</p>
            <ul class="benefit">
              <li>登録特典: 次回購入で使える 500円OFFクーポン</li>
              <li>会員限定: アスパラ・じゃがいもの予約受付（一般公開より3日早く）</li>
