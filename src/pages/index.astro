---
// 北の逸品堂 / 知床ツーリスト — TOPページ (shop-first構成)
// 構成: ヒーロー → SHOP ENTRANCE → NEWS → LINE帯
import "../styles/global.css";
import { siteMedia as media } from "../data/sourceImages";

const meta = {
  title: "知床から、食べるものと着るものを選ぶ｜北の逸品堂(1992清里町)",
  description: "北海道・知床のセレクトショップ「北の逸品堂」。1992年清里町から、店主が選ぶ産直食材と現場で使うアウトドアウェア(Patagonia等)。LINE登録で再入荷・収穫速報。",
};

const currentYear = new Date().getFullYear();
const safeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

// NEWSデータ (静的。将来CMSに切り替え可)
const newsItems = [
  { date: "2026.06.09", category: "産直",    categorySlug: "specialty", title: "朝採りアスパラ 1kg・3kg・8kg 出荷開始。6月末まで出荷予定。" },
  { date: "2026.05.21", category: "アパレル", categorySlug: "apparel",   title: "Patagonia R1 Air Hoodie 2026SS 全色入荷しました。" },
  { date: "2026.04.15", category: "メディア", categorySlug: "media",     title: "北海道新聞「知床の味覚」特集に掲載されました。" },
  { date: "2026.03.01", category: "ツアー",   categorySlug: "tour",      title: "2026年春夏ツアー(知床五湖ガイド)の受付を開始しました。" },
  { date: "2025.12.10", category: "産直",    categorySlug: "specialty",  title: "冬の定番・オホーツク鮭フレーク(170g)の予約受付を開始。" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href="https://shiretoko-tourist-final.vercel.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content="https://shiretoko-tourist-final.vercel.app/" />
    <meta property="og:image" content="https://shiretoko-tourist-final.vercel.app/source-images/files/product-3012-shipping-included-8-0kg-hokkaido-okhotsk-koshimizu-asparagus-8-0kg-3005-image.jpeg" />
    <meta property="og:site_name" content="北の逸品堂 / 知床ツーリスト" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content="https://shiretoko-tourist-final.vercel.app/source-images/files/product-3012-shipping-included-8-0kg-hokkaido-okhotsk-koshimizu-asparagus-8-0kg-3005-image.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={safeJsonLd({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "#org",
          "name": "株式会社 知床ツーリスト",
          "alternateName": "北の逸品堂",
          "url": "https://shiretokotourist.com/",
          "foundingDate": "1992",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "字向陽282番地",
            "addressLocality": "清里町",
            "addressRegion": "北海道斜里郡",
            "postalCode": "099-4403",
            "addressCountry": "JP"
          },
          "telephone": "+81-152-25-2642"
        },
        {
          "@type": "TravelAgency",
          "name": "知床ツーリスト",
          "parentOrganization": { "@id": "#org" },
          "identifier": "北海道知事登録旅行業 第2-453号",
          "memberOf": "全国旅行業協会 (ANTA)",
          "areaServed": { "@type": "Place", "name": "知床・オホーツク・清里町・斜里町" }
        }
      ]
    })}></script>
    <script src="/cart.js" is:inline></script>
  </head>
  <body>
    <!-- ============ 上部告知バー (送料無料カウンター付き) ============ -->
    <div class="topbar topbar--v3" data-shipping-bar>
      <span class="topbar__pill">6月限定</span>
      <span class="topbar__msg">朝採りアスパラを北海道から直送中</span>
      <span class="topbar__divider" aria-hidden="true">・</span>
      <span class="topbar__shipping">
        <span class="topbar__shipping-label">¥5,000以上で送料無料</span>
        <span class="topbar__shipping-remain" data-shipping-remain hidden>あと <b data-remain-amount>¥5,000</b></span>
        <span class="topbar__shipping-done" data-shipping-done hidden>✓ 送料無料</span>
      </span>
      <span class="topbar__divider" aria-hidden="true">・</span>
      <a href="#retention" class="topbar__cta">LINE登録 ¥500 OFF</a>
    </div>

    <!-- ============ ヘッダ ============ -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark">北の逸品堂</span>
          <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
        </a>
        <nav class="gnav" aria-label="主要メニュー">
          <a href="/shop">SHOP</a>
          <a href="/products/specialty/">産直</a>
          <a href="/products/apparel/">アパレル</a>
          <a href="/bundles/">セット</a>
          <a href="/stories/">ストーリー</a>
          <a href="/ranking/">ランキング</a>
        </nav>
        <div class="header-utility">
          <a href="/account/" class="utility-link">会員ページ</a>
          <a href="/cart" class="utility-cart" data-cart-link>カート</a>
          <details class="mobile-nav">
            <summary aria-label="メニューを開く">
              <span></span><span></span><span></span>
            </summary>
            <ul>
              <li><a href="/shop">SHOP</a></li>
              <li><a href="/products/specialty/">産直</a></li>
              <li><a href="/products/apparel/">アパレル</a></li>
              <li><a href="/bundles/">セット</a></li>
              <li><a href="/stories/">ストーリー</a></li>
              <li><a href="/ranking/">ランキング</a></li>
              <li><a href="/gift/">ギフト</a></li>
              <li><a href="/account/">会員ページ</a></li>
              <li><a href="/cart">カート</a></li>
              <li><a href="#company">会社</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ HERO (fullbleed) ============ -->
      <section class="hero-fb" aria-label="ヒーロー">
        {media.hero.src ? (
          <img
            class="hero-fb__img"
            src={media.hero.src}
            alt={media.hero.alt}
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero-fb__placeholder">
            <strong>北海道・知床 / 斜里岳の朝。店主が34年選び続けた場所。</strong>
            <span>public/source-images/hero-shiretoko.jpg を追加（後ろ姿・手元など人の気配のある1枚）</span>
          </div>
        )}
        <div class="hero-fb__copy">
          <h1 class="hero-fb__headline">1992年から、ここで選んでいる。</h1>
          <p class="hero-fb__sub">
            北海道・清里町。知床のガイドが畑と岩場で見つけた食べるものと着るものを、この店から届けています。
          </p>
          <a href="/shop" class="hero-fb__cta">ショップを見る</a>
        </div>
      </section>

      <!-- ============ SHOP ENTRANCE (ヒーロー直下・入口はショップ1本) ============ -->
      <section class="shop-entrance" aria-label="ショップへの入口">
        <div class="shop-entrance__inner">
          <div class="shop-entrance__header">
            <span class="shop-entrance__eyebrow">SHOP</span>
            <h2 class="shop-entrance__headline">同じ人間が、畑で選んで岩場で着る。</h2>
            <p class="shop-entrance__sub">
              知床のガイドが、朝採りの食べものと現場で使うウェアを同じ目利きで扱う店です。
            </p>
          </div>
        </div>
        <!-- SHOPゲート (店の入口ビジュアルブロック) -->
        <a href="/shop" class="shop-gate" aria-label="ショップを見る">
          <div class="shop-gate__bg" aria-hidden="true">
            <img src="/source-images/files/key-specialty-warm.jpg" alt="" loading="lazy" decoding="async" />
            <img src="/source-images/files/key-apparel-cool.jpg" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="shop-gate__overlay">
            <span class="shop-gate__eyebrow">ONLINE SHOP</span>
            <span class="shop-gate__title">ショップを見る</span>
            <span class="shop-gate__sub">産直の食べものと、現場のアパレル</span>
            <span class="shop-gate__btn">すべての商品はこちら →</span>
          </div>
        </a>
      </section>

      <!-- ============ STORY (編集面: 引用+年表・写真なし) ============ -->
      <section class="story-strip" aria-label="店の物語">
        <div class="story-strip__inner">
          <span class="story-strip__eyebrow">OUR STORY</span>
          <p class="story-strip__quote">
            「特産品もアパレルも、知床のガイドも、ぜんぶ同じ人間がやっています。」
          </p>
          <p class="story-strip__cite">— 代表 石田 富雄</p>
          <ol class="story-strip__timeline">
            <li><span class="story-strip__year">1992</span><span class="story-strip__event">清里町でユースホステル開業</span></li>
            <li><span class="story-strip__year">1996</span><span class="story-strip__event">熱気球事業開始</span></li>
            <li><span class="story-strip__year">2000</span><span class="story-strip__event">自然ガイド事業開始</span></li>
            <li><span class="story-strip__year">2002</span><span class="story-strip__event">知床ツーリスト 法人化</span></li>
            <li><span class="story-strip__year">2003</span><span class="story-strip__event">北海道知事登録旅行業 第2-453号</span></li>
          </ol>
          <a href="/stories/" class="story-strip__cta">ストーリーを読む →</a>
        </div>
      </section>

      <!-- ============ NEWS (ショップ入口の後) ============ -->
      <section class="news-section" aria-label="お知らせ">
        <div class="news-section__inner">
          <div class="news-section__header">
            <h2 class="news-section__title">お知らせ</h2>
            <a href="/stories/" class="news-section__more">過去のお知らせ →</a>
          </div>
          <ul class="news-rows" role="list">
            {newsItems.map((item) => (
              <li class="news-row">
                <span class="news-row__date">{item.date}</span>
                <span class={`news-row__tag news-row__tag--${item.categorySlug}`}>{item.category}</span>
                <span class="news-row__title">{item.title}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ============ LINE 細帯 ============ -->
      <div class="line-band" id="retention" role="complementary" aria-label="LINE登録">
        <div class="line-band__inner">
          <span class="line-band__text">収穫便りをLINEで受け取る — 再入荷通知・収穫速報</span>
          <a href="https://line.me/R/ti/p/@kitanoippindo" class="line-band__btn" target="_blank" rel="noopener noreferrer">LINE登録 ¥500 OFF →</a>
        </div>
      </div>
    </main>

    <script is:inline>
      // 送料無料カウンター
      (function () {
        const THRESHOLD = 5000;
        const remainEl = document.querySelector('[data-shipping-remain]');
        const remainAmount = document.querySelector('[data-remain-amount]');
        const doneEl = document.querySelector('[data-shipping-done]');
        function fmtYen(n) { return '¥' + n.toLocaleString('ja-JP'); }
        function update() {
          const sub = window.cart && window.cart.subtotal ? window.cart.subtotal() : 0;
          if (sub <= 0) {
            if (remainEl) { remainEl.hidden = true; }
            if (doneEl) doneEl.hidden = true;
            return;
          }
          const remain = THRESHOLD - sub;
          if (remain > 0) {
            if (remainAmount) remainAmount.textContent = fmtYen(remain);
            if (remainEl) remainEl.hidden = false;
            if (doneEl) doneEl.hidden = true;
          } else {
            if (remainEl) remainEl.hidden = true;
            if (doneEl) doneEl.hidden = false;
          }
        }
        update();
        document.addEventListener('cart:change', update);
        window.addEventListener('storage', update);
      })();
    </script>

    <!-- ============ フッタ ============ -->
    <footer class="site-footer" id="company">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <span class="brand__mark">北の逸品堂</span>
            <span class="brand__sub">SHIRETOKO TOURIST / 1992</span>
            <p class="addr">
              株式会社 知床ツーリスト<br />
              〒099-4403 北海道斜里郡清里町字向陽282番地<br />
              旅行・ガイド: 0152-25-2642<br />
              ホステル: 0152-25-3995<br />
              北海道知事登録旅行業 第2-453号<br />
              全国旅行業協会 (ANTA) 所属
            </p>
          </div>
          <div>
            <h3>ショッピング</h3>
            <ul>
              <li><a href="/products/specialty/">産直一覧</a></li>
              <li><a href="/products/apparel/">アパレル一覧</a></li>
              <li><a href="/bundles/">セット販売</a></li>
              <li><a href="/gift/">ギフト</a></li>
              <li><a href="/ranking/">ランキング</a></li>
              <li><a href="/stories/">ストーリー</a></li>
            </ul>
          </div>
          <div>
            <h3>サポート / 会社</h3>
            <ul>
              <li><a href="/account/">会員ページ</a></li>
              <li><a href="/comparison/">購入方法</a></li>
              <li><a href="/furusato/">ふるさと納税</a></li>
              <li><a href="/shipping/">送料・配送について</a></li>
              <li><a href="/legal/">特定商取引法に基づく表記</a></li>
              <li><a href="https://shiretokotourist.com/" target="_blank" rel="noopener noreferrer">旅行業約款・取引条件説明書</a></li>
              <li><a href="/privacy/">プライバシーポリシー</a></li>
              <li><a href="/stories/">会社概要</a></li>
              <li><a href="/contact/">お問い合わせ</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__legal">
          <span>(c) 1992-{currentYear} 株式会社 知床ツーリスト. All rights reserved.</span>
          <span class="payments">LINE相談 / 銀行振込 / 代引き相談</span>
        </div>
      </div>
    </footer>
  </body>
</html>
