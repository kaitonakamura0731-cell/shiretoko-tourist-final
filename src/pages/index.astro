---
// 北の逸品堂 / 知床ツーリスト — TOPページモック (Slim版: 8セクション)
// 構成: ヘッダ → ヒーロー → 信頼バッジ3点 → 季節カレンダー → 今週のおすすめ3商品
//       → ツアー予約特集(決定打) → ストーリー → リテンション → フッタ
// 既存ブランド #3C8186 / #B99253 を主軸、日本語タイポ主役、AIスロップ禁忌厳守。
import "../styles/global.css";
import { productImageForKey, siteMedia as media } from "../data/sourceImages";
import { products, formatYen } from "../data/products";

const meta = {
  title: "知床から、食べるものと着るものを選ぶ｜北の逸品堂(1992清里町)",
  description: "北海道・知床のセレクトショップ「北の逸品堂」。1992年清里町から、店主が選ぶ産直食材と現場で使うアウトドアウェア(Patagonia等)。LINE登録で再入荷・収穫速報。",
};

const productBySlug = new Map(products.map((product) => [product.slug, product]));

// 産直のおすすめ — 同じ棚に混在させない (商談合意)
const specialtyFeatured = ["asparagus-1kg", "potato-onion-set", "potato-danshaku-30kg"]
  .map((slug) => productBySlug.get(slug))
  .filter(Boolean)
  .map((product) => ({
    ...product,
    priceLabel: formatYen(product.price),
    unit: product.priceUnit,
    stock: product.stockLabel,
    low: product.stock <= 5,
    image: productImageForKey(product.imageKey, product.title),
  }));

// アパレルのおすすめ — 別セクションで見せる
const apparelFeatured = ["patagonia-r1-air-hoodie", "patagonia-r1-zip-neck"]
  .map((slug) => productBySlug.get(slug))
  .filter(Boolean)
  .map((product) => ({
    ...product,
    priceLabel: formatYen(product.price),
    unit: product.priceUnit,
    stock: product.stockLabel,
    low: product.stock <= 5,
    image: productImageForKey(product.imageKey, product.title),
  }));

// セット提案用 (既存)
const ranking = [...specialtyFeatured, ...apparelFeatured];

const bundles = [
  {
    season: "SPRING TRIP",
    title: "朝採りアスパラ + R1 Air Hoodie",
    desc: "初夏の知床に来る人にも、北海道ギフトを贈る人にも。届いた食材から旅支度まで、同じ店主の目利きで選べるセット提案。",
    primary: ranking[0],
    secondary: ranking[2],
    note: "EC購入でツアー予約 ¥1,000 OFF",
  },
  {
    season: "GIFT & DAILY",
    title: "じゃがいも・玉ねぎ + 現場フリース",
    desc: "保存のきく定番野菜と、長く着られるアウトドアウェアを同じカートへ。単品購入で終わらせず、客単価を自然に上げる導線です。",
    primary: ranking[1],
    secondary: ranking[2],
    note: "¥5,000以上で送料無料 / まとめ買い向き",
  },
  {
    season: "TOUR AFTER",
    title: "旅のあとに届く、北の定期便",
    desc: "知床を歩いた記憶を、季節の食材と店主の道具選びでリピート購入へ。OTAでは作れない自社サイトならではの関係性を育てます。",
    primary: ranking[0],
    secondary: ranking[1],
    note: "LINE登録で再入荷・収穫速報",
  },
];

const tours = [
  { period: "春-秋 / 6-10月", title: "知床五湖ガイドハイキング", desc: "世界自然遺産・知床五湖を、現場ガイドが半日でご案内。ヒグマ対応の正式登録ガイドが同行します。", price: "¥6,800", unit: "/ 大人1名" },
  { period: "冬 / 1-3月", title: "北海道流氷熱気球フリーフライト", desc: "冬期限定・流氷の上を熱気球で飛ぶ。鳥と同じ目線でオホーツクを見渡す非日常体験。", price: "¥38,000", unit: "/ 大人1名" },
  { period: "冬 / 12-3月", title: "神の子池スノーシューツアー", desc: "凍らずに青く湧き出る神の子池まで、スノーシューで歩く半日コース。装備一式レンタル込。", price: "¥7,500", unit: "/ 大人1名" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href="https://shiretoko-tourist-final.vercel.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content="https://shiretoko-tourist-final.vercel.app/" />
    <meta property="og:image" content="https://shiretoko-tourist-final.vercel.app/source-images/files/product-3012-shipping-included-8-0kg-hokkaido-okhotsk-koshimizu-asparagus-8-0kg-3005-image.jpeg" />
    <meta property="og:site_name" content="北の逸品堂 / 知床ツーリスト" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content="https://shiretoko-tourist-final.vercel.app/source-images/files/product-3012-shipping-included-8-0kg-hokkaido-okhotsk-koshimizu-asparagus-8-0kg-3005-image.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "#org",
          "name": "株式会社 知床ツーリスト",
          "alternateName": "北の逸品堂",
          "url": "https://kitanoippindo.example.com/",
          "foundingDate": "1992",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "字向陽282番地",
            "addressLocality": "清里町",
            "addressRegion": "北海道斜里郡",
            "postalCode": "099-4403",
            "addressCountry": "JP"
          },
          "telephone": "+81-152-25-2642"
        },
        {
          "@type": "TravelAgency",
          "name": "知床ツーリスト",
          "parentOrganization": { "@id": "#org" },
          "identifier": "北海道知事登録旅行業 第2-453号",
          "memberOf": "全国旅行業協会 (ANTA)",
          "areaServed": { "@type": "Place", "name": "知床・オホーツク・清里町・斜里町" }
        }
      ]
    })}></script>
    <script src="/cart.js" is:inline></script>
  </head>
  <body>
    <!-- ============ 上部告知バー (送料無料カウンター付き) ============ -->
    <div class="topbar topbar--v3" data-shipping-bar>
      <span class="topbar__pill">6月限定</span>
      <span class="topbar__msg">朝採りアスパラを北海道から直送中</span>
      <span class="topbar__divider" aria-hidden="true">・</span>
      <span class="topbar__shipping">
        <span class="topbar__shipping-label">¥5,000以上で送料無料</span>
        <span class="topbar__shipping-remain" data-shipping-remain hidden>あと <b data-remain-amount>¥5,000</b></span>
        <span class="topbar__shipping-done" data-shipping-done hidden>✓ 送料無料</span>
      </span>
      <span class="topbar__divider" aria-hidden="true">・</span>
      <a href="#retention" class="topbar__cta">LINE登録 ¥500 OFF</a>
    </div>

    <!-- ============ ヘッダ ============ -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark">北の逸品堂</span>
          <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
        </a>
        <nav class="gnav" aria-label="主要メニュー">
          <a href="/products/specialty/">産直</a>
          <a href="/products/apparel/">アパレル</a>
          <a href="/bundles/">セット</a>
          <a href="/stories/">ストーリー</a>
          <a href="/ranking/">ランキング</a>
        </nav>
        <div class="header-utility">
          <a href="/account/" class="utility-link">マイページ</a>
          <a href="/cart" class="utility-cart" data-cart-link>カート (0)</a>
          <details class="mobile-nav">
            <summary aria-label="メニューを開く">
              <span></span><span></span><span></span>
            </summary>
            <ul>
              <li><a href="/products/specialty/">産直</a></li>
              <li><a href="/products/apparel/">アパレル</a></li>
              <li><a href="/bundles/">セット</a></li>
              <li><a href="/stories/">ストーリー</a></li>
              <li><a href="/ranking/">ランキング</a></li>
              <li><a href="/gift/">ギフト</a></li>
              <li><a href="/account/">マイページ</a></li>
              <li><a href="/cart">カート</a></li>
              <li><a href="#company">会社</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ ヒーロー ============ -->
      <section class="hero" aria-label="ヒーロー">
        <div class="hero__inner">
          <div class="hero__copy">
            <span class="hero__eyebrow">北海道・知床のセレクトショップ</span>
            <h1>
              知床から、<br />
              <span class="accent">食べるもの</span>と<span class="accent">着るもの</span>を選ぶ。
            </h1>
            <p class="lead">
              1992年から清里町で、ユースホステル・自然ガイド・旅行業を続けてきた知床ツーリストの公式EC。
              同じ店主・同じ地域・同じ目利きで選ぶ、産直食材とアウトドアウェアのセレクトショップ「北の逸品堂」。
            </p>
            <div class="hero__meta">
              <span>1992年・清里町から33年</span>
              <span>産直 84商品 / アパレル 533商品</span>
              <span>店主厳選・現場使い</span>
            </div>
            <div class="hero__cta">
              <a href="/products/specialty/" class="btn btn--primary">産直入口へ</a>
              <a href="/products/apparel/" class="btn btn--outline">アパレル入口へ</a>
            </div>
          </div>
          <div class="hero__visual">
            {media.hero.src ? (
              <img src={media.hero.src} alt={media.hero.alt} decoding="async" fetchpriority="high" />
            ) : (
              <div class="source-placeholder source-placeholder--hero" role="img" aria-label={`${media.hero.alt}の画像枠`}>
                <span>{media.hero.label}</span>
                <small>assets/source-images に画像を追加</small>
              </div>
            )}
            <span class="hero__caption" aria-hidden="true">イメージ: 斜里岳・オホーツク海 / 清里町</span>
          </div>
        </div>
      </section>

      <!-- ============ 信頼バッジ帯（3点に簡素化） ============ -->
      <section class="trust-band" aria-label="信頼指標">
        <div class="trust-band__inner">
          <span><b>1992年</b> 清里町で創業<small>(33年)</small></span>
          <span><b>北海道知事登録</b> 旅行業 第2-453号<small>(2003-)</small></span>
          <span>産地・収穫日を<b>商品ページに明記</b></span>
        </div>
      </section>

      <!-- ============ 7入口タイル (BEAMS流) ============ -->
      <section class="quick-tiles" aria-label="ショップの入口">
        <div class="quick-tiles__inner">
          <a href="/stories/" class="qtile">
            <span class="qtile__no">01</span>
            <span class="qtile__label mincho">店主の手記</span>
            <span class="qtile__sub">STORIES</span>
          </a>
          <a href="/ranking/" class="qtile qtile--accent">
            <span class="qtile__no">02</span>
            <span class="qtile__label mincho">ランキング</span>
            <span class="qtile__sub">WEEKLY RANKING</span>
          </a>
          <a href="/products/specialty/" class="qtile">
            <span class="qtile__no">03</span>
            <span class="qtile__label mincho">産直</span>
            <span class="qtile__sub">SPECIALTY</span>
          </a>
          <a href="/products/apparel/" class="qtile">
            <span class="qtile__no">04</span>
            <span class="qtile__label mincho">アパレル</span>
            <span class="qtile__sub">APPAREL</span>
          </a>
          <a href="/bundles/" class="qtile">
            <span class="qtile__no">05</span>
            <span class="qtile__label mincho">特集・セット</span>
            <span class="qtile__sub">COLLECTIONS</span>
          </a>
          <a href="/ranking/" class="qtile qtile--sale">
            <span class="qtile__no">06</span>
            <span class="qtile__label mincho">6月限定</span>
            <span class="qtile__sub">JUNE OFFER</span>
          </a>
          <a href="/gift/" class="qtile">
            <span class="qtile__no">07</span>
            <span class="qtile__label mincho">ギフト</span>
            <span class="qtile__sub">GIFT・のし対応</span>
          </a>
        </div>
      </section>

      <!-- ============ 2大入口（産直 / アパレル） ============ -->
      <section class="entrances" aria-label="2大入口">
        <div class="entrances__inner">
          <span class="section-eyebrow">2 ENTRANCES</span>
          <h2 class="mincho">食べるもの / 着るもの、<br />入口を分けます。</h2>
          <hr class="section-rule" />
          <p class="entrances__lead">
            産直とアパレルは目的が違うので、トップから先は道を分けます。
            同じ店主が選ぶ世界観でつながりつつ、お客様は最短で目的の棚にたどり着けます。
          </p>
          <div class="entrances__grid">
            <a href="/products/specialty/" class="entrance entrance--specialty">
              <div class="entrance__media">
                <img src="/source-images/files/product-3012-shipping-included-8-0kg-hokkaido-okhotsk-koshimizu-asparagus-8-0kg-3005-image.jpeg" alt="北海道オホーツク産アスパラガス" loading="lazy" />
              </div>
              <div class="entrance__body">
                <span class="entrance__tag">SPECIALTY ・ 産直入口</span>
                <h3 class="mincho">北海道・知床の<br />産直食材</h3>
                <p>アスパラ / じゃがいも / 玉ねぎ / 季節食材 / ギフト</p>
                <span class="entrance__cta">産直一覧を見る →</span>
              </div>
            </a>
            <a href="/products/apparel/" class="entrance entrance--apparel">
              <div class="entrance__media">
                <img src="/source-images/files/product-2989-new-m-patagonia-ms-r1-air-full-zip-hoodie-patagonia-clement-blue-clmb-2984-p1010080-1.jpg" alt="Patagonia R1 Air Hoodie 店主厳選" loading="lazy" />
              </div>
              <div class="entrance__body">
                <span class="entrance__tag">APPAREL ・ アパレル入口</span>
                <h3 class="mincho">店主が現場で<br />使うアウトドアウェア</h3>
                <p>Patagonia / フーディー / ジャケット / ベスト / シャツ</p>
                <span class="entrance__cta">アパレル一覧を見る →</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- ============ 季節カレンダー（年間サイクル＝LTV設計の可視化） ============ -->
      <section class="season-band" aria-label="季節カレンダー">
        <div class="season-band__inner">
          <span class="section-eyebrow">SEASONAL CALENDAR</span>
          <h2>北の年間カレンダー</h2>
          <hr class="section-rule" />
          <div class="season-grid">
            <div class="season-cell season-cell--spring">
              <div class="season-cell__bar"></div>
              <div class="season-cell__season">春</div>
              <div class="season-cell__period">APR – MAY</div>
              <div class="season-cell__items">山菜・行者にんにく<br />清里町の遅い春の便り</div>
            </div>
            <div class="season-cell season-cell--summer is-now">
              <div class="season-cell__bar"></div>
              <span class="now-tag">NOW</span>
              <div class="season-cell__season">夏</div>
              <div class="season-cell__period">JUN – AUG</div>
              <div class="season-cell__items">アスパラ・じゃがいも・玉ねぎ<br />知床五湖ガイドツアー</div>
            </div>
            <div class="season-cell season-cell--autumn">
              <div class="season-cell__bar"></div>
              <div class="season-cell__season">秋</div>
              <div class="season-cell__period">SEP – NOV</div>
              <div class="season-cell__items">きのこ・北海道米<br />オホーツク鮭フレーク</div>
            </div>
            <div class="season-cell season-cell--winter">
              <div class="season-cell__bar"></div>
              <div class="season-cell__season">冬</div>
              <div class="season-cell__period">DEC – MAR</div>
              <div class="season-cell__items">流氷熱気球フリーフライト<br />神の子池スノーシュー</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ 産直のおすすめ ============ -->
      <section class="featured-block" id="featured-specialty" aria-label="産直のおすすめ">
        <div class="featured-block__inner">
          <span class="featured-eyebrow">SPECIALTY ・ 産直のおすすめ</span>
          <h2 class="mincho">今週、店主が選んだ食べるもの。</h2>
          <hr class="section-rule" />
          <div class="featured-grid">
            {specialtyFeatured.map((item) => (
              <article class="featured-card">
                <a href={`/products/${item.slug}/`} class="featured-card__link" aria-label={`${item.title}の詳細を見る`}>
                  <div class="featured-card__img">
                    {item.image.src ? (
                      <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
                    ) : (
                      <div class="featured-card__placeholder" aria-hidden="true">no image</div>
                    )}
                    {item.low && <span class="featured-card__lowbadge">残り僅か</span>}
                  </div>
                  <div class="featured-card__body">
                    <span class="featured-card__origin">{item.origin}</span>
                    <h3 class="featured-card__title">{item.title}</h3>
                    <div class="featured-card__meta">
                      <span class={item.low ? "featured-card__stock low" : "featured-card__stock"}>{item.stock}</span>
                      <span class="featured-card__delivery">{item.delivery}</span>
                    </div>
                    <span class="featured-card__price">{item.priceLabel}<small>{item.unit}</small></span>
                  </div>
                </a>
                <button type="button" class="featured-card__cart" aria-label={`${item.title}をカートに追加`} data-add-slug={item.slug} data-add-name={item.title} data-add-price={String(item.price)}>カゴに追加</button>
              </article>
            ))}
          </div>
          <div class="featured-block__cta">
            <a href="/products/specialty/" class="featured-link">産直一覧をすべて見る (84商品) →</a>
          </div>
        </div>
      </section>

      <!-- ============ アパレルのおすすめ ============ -->
      <section class="featured-block featured-block--alt" id="featured-apparel" aria-label="アパレルのおすすめ">
        <div class="featured-block__inner">
          <span class="featured-eyebrow">APPAREL ・ アパレルのおすすめ</span>
          <h2 class="mincho">店主が現場で使う、着るもの。</h2>
          <hr class="section-rule" />
          <div class="featured-grid">
            {apparelFeatured.map((item) => (
              <article class="featured-card">
                <a href={`/products/${item.slug}/`} class="featured-card__link" aria-label={`${item.title}の詳細を見る`}>
                  <div class="featured-card__img">
                    {item.image.src ? (
                      <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
                    ) : (
                      <div class="featured-card__placeholder" aria-hidden="true">no image</div>
                    )}
                    {item.low && <span class="featured-card__lowbadge">残り僅か</span>}
                  </div>
                  <div class="featured-card__body">
                    <span class="featured-card__origin">{item.origin}</span>
                    <h3 class="featured-card__title">{item.title}</h3>
                    <div class="featured-card__meta">
                      <span class={item.low ? "featured-card__stock low" : "featured-card__stock"}>{item.stock}</span>
                      <span class="featured-card__delivery">{item.delivery}</span>
                    </div>
                    <span class="featured-card__price">{item.priceLabel}<small>{item.unit}</small></span>
                  </div>
                </a>
                <button type="button" class="featured-card__cart" aria-label={`${item.title}をカートに追加`} data-add-slug={item.slug} data-add-name={item.title} data-add-price={String(item.price)}>カゴに追加</button>
              </article>
            ))}
          </div>
          <div class="featured-block__cta">
            <a href="/products/apparel/" class="featured-link">アパレル一覧をすべて見る (533商品) →</a>
          </div>
        </div>
      </section>

      <!-- ============ 旧: 今週のおすすめ統合 ============ -->
      <section class="section section--white" id="ranking" aria-label="今週のおすすめ">
        <div class="section__inner">
          <span class="section-eyebrow">PICK UP</span>
          <h2>今週のおすすめ</h2>
          <hr class="section-rule" />
          <div class="ranking ranking--wide">
            {ranking.map((item) => (
              <article class="ranking-card">
                <a href={`/products/${item.slug}`} class="ranking-card__link" aria-label={`${item.title}の詳細を見る`}>
