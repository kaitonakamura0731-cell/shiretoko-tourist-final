---
// 公式ECとYahoo!ショッピング店の購入方法ガイド — 北の逸品堂
// 配色: #F6F3EC / #1A1A1A / #B99253 / #3C8186
// データ: src/data/comparison.ts (rows / productSamples)
// 公開表現ガード: 決済料率は「2.5%」表記のみ。
import "../styles/global.css";
import { rows, productSamples } from "../data/comparison";
import { productImageForKey } from "../data/sourceImages";
import { pointsInfo } from "../data/promotions";

const meta = {
  title: "購入方法ガイド｜北の逸品堂 (知床ツーリスト)",
  description:
    "北の逸品堂の公式ECとYahoo!ショッピング店の選び方。価格・ポイント・送料・配送・相談方法を確認して、買いやすい売り場を選べます。",
};

const advLabel: Record<"yahoo" | "own" | "tie", string> = {
  yahoo: "Yahoo",
  own: "公式EC",
  tie: "TIE",
};

const yen = (n: number) => `¥${n.toLocaleString()}`;
const currentYear = new Date().getFullYear();
const sampleImageKeys: Record<string, string> = {
  "asparagus-1kg": "asparagus",
  "potato-danshaku-30kg": "potato-danshaku",
  "patagonia-r1-air-hoodie": "patagonia-hoodie",
};
const samples = productSamples.map((p) => ({
  ...p,
  image: productImageForKey(sampleImageKeys[p.slug] ?? p.slug, p.title),
}));

// ポイント還元の目安: Yahoo 1〜5% の中央値で 3%、公式ECは基本1%
const ownBaseRate = Math.round(pointsInfo.rateValue * 100);
const OWN_EFFECTIVE_RATE = ownBaseRate;
const yahooPoints = (n: number) => Math.round((n * 3) / 100);
const ownPoints = (n: number) => Math.round((n * OWN_EFFECTIVE_RATE) / 100);

const scenarios = [
  {
    tag: "ポイント還元を最大化したい",
    rec: "公式EC",
    reason:
      "Yahoo はキャンペーン日に大きな還元が出ることがあります。公式ECは基本ポイントと相談しやすさがあり、続けて買うほど使いやすい設計です。",
  },
  {
    tag: "とにかく早く届けてほしい",
    rec: "公式EC",
    reason:
      "Yahoo は出荷まで 2〜3 営業日が目安。公式ECは中1日で出荷、朝採りアスパラなど鮮度が大切な品は当日出荷枠を相談できます。",
  },
  {
    tag: "贈答や継続のために店主と直接話したい",
    rec: "公式EC",
    reason:
      "LINE での 1:1 相談、再入荷通知、贈答リマインド、ロットの相談まで公式EC側で受け付けやすくしています。",
  },
  {
    tag: "今日たまたまモールで見つけた",
    rec: "Yahoo!ショッピング店",
    reason:
      "モール内検索で出会えたなら、その流れで Yahoo で買うのも自然です。気に入ったら次回は会員登録して、公式ECで指名買いに切り替えられます。",
  },
];
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
<script src="/cart.js" is:inline></script>
</head>
<body class="page-listing page-comparison">

<div class="topbar">公式ECとYahoo!ショッピング店の選び方 ・ 表示価格・ポイント・送料・配送を確認できます</div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark">北の逸品堂</span>
      <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
    </a>
    <nav class="gnav" aria-label="主要メニュー">
      <a href="/shop">SHOP</a>
      <a href="/products/specialty/">産直</a>
      <a href="/products/apparel/">アパレル</a>
      <a href="/bundles/">セット</a>
      <a href="/gift/">ギフト</a>
      <a href="/stories/">ストーリー</a>
      <a href="/ranking/">ランキング</a>
      <a href="/comparison/" aria-current="page">購入方法</a>
      <a href="/furusato/">ふるさと納税</a>
    </nav>
    <div class="header-utility">
      <a href="/account/" class="utility-link">会員ページ</a>
      <a href="/cart" class="utility-cart" data-cart-link>カート</a>
      <details class="mobile-nav">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <ul>
          <li><a href="/shop">SHOP</a></li>
          <li><a href="/products/specialty/">産直</a></li>
          <li><a href="/products/apparel/">アパレル</a></li>
          <li><a href="/bundles/">セット</a></li>
          <li><a href="/stories/">ストーリー</a></li>
          <li><a href="/ranking/">ランキング</a></li>
          <li><a href="/gift/">ギフト</a></li>
          <li><a href="/comparison/" class="is-tour" aria-current="page">購入方法</a></li>
          <li><a href="/account/">会員ページ</a></li>
          <li><a href="/cart">カート</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<main>

<section class="listing-hero">
  <div class="listing-hero__inner">
    <span class="eyebrow">SHOPPING GUIDE ・ 二つの売り場</span>
    <h1 class="mincho">公式ECとYahoo!店、どちらで買うか。</h1>
    <p>
      北の逸品堂は公式ECと Yahoo!ショッピング店の二つの売り場があります。
      同じ商品でも、ポイント還元・送料・配送スピード・相談方法にそれぞれ特徴があります。
      買いやすい方を選べるよう、購入前に見ておきたい項目をまとめました。
    </p>
  </div>
</section>

<section class="cmp">
  <div class="cmp__inner">

    <h2 class="cmp__h2 mincho">購入前に見るポイント</h2>
    <p class="cmp__lead">
      8つの項目を横並びにしました。「TIE」は引き分け、「公式EC」「Yahoo」はその売り場が選びやすい項目です。
    </p>

    <div class="cmp-table-wrap" role="region" aria-label="売り場別 比較表">
      <table class="cmp-table">
        <thead>
          <tr>
            <th scope="col" id="cmp-axis" class="cmp-table__axis">軸</th>
            <th scope="col" id="cmp-yahoo" class="cmp-table__yahoo">
              <span class="cmp-table__col-label">Yahoo!ショッピング店</span>
              <span class="cmp-table__col-sub">モール内出店</span>
            </th>
            <th scope="col" id="cmp-own" class="cmp-table__own">
              <span class="cmp-table__col-label">公式EC</span>
              <span class="cmp-table__col-sub">北の逸品堂</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => {
            const rowId = `cmp-axis-${i}`;
            return (
              <tr class={`cmp-row cmp-row--${r.advantage}`}>
                <th scope="row" id={rowId} class="cmp-row__axis">
                  <span class="mincho">{r.axis}</span>
                  <span class={`cmp-badge cmp-badge--${r.advantage}`}>{advLabel[r.advantage]}</span>
                </th>
                <td class="cmp-row__yahoo" headers={`cmp-yahoo ${rowId}`}>
                  <p>{r.yahoo}</p>
                </td>
                <td class="cmp-row__own" headers={`cmp-own ${rowId}`}>
                  <p>{r.own}</p>
                  {r.note && <p class="cmp-row__note">{r.note}</p>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="cmp-foot-note">
      ※ 表中の数値はキャンペーン日や時期によって変動します。実際の購入画面の表示価格・送料・ポイント条件をご確認ください。
    </p>

  </div>
</section>

<section class="cmp-samples">
  <div class="cmp-samples__inner">
    <h2 class="cmp__h2 mincho">商品ごとの選び方</h2>
    <p class="cmp__lead">
      実際の商品を3点並べて、Yahoo と公式EC の見え方を整理しました。表示価格は揃えてあります。
      選ぶ時は「常時ポイント」「送料」「配送スピード」「相談できる相手」を見てください。
    </p>
    <p class="cmp-points-note">
      ※ 公式ECの基本ポイント付与は会員 {ownBaseRate}%。キャンペーンや会員特典は時期・購入条件により変動します。
    </p>

    <ol class="cmp-samples__list">
      {samples.map((p) => {
        const yPts = yahooPoints(p.yahooPrice);
        const oPts = ownPoints(p.ownPrice);
        return (
          <li class="cmp-sample">
            <a class="cmp-sample__media" href={`/products/${p.slug}/`} aria-label={p.title}>
              {p.image.src ? (
                <img src={p.image.src} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="cmp-sample__media-fallback" aria-hidden="true">{p.title}</span>
              )}
            </a>
            <div class="cmp-sample__body">
              <h3 class="cmp-sample__title mincho">{p.title}</h3>

              <div class="cmp-sample__grid">
                <div class="cmp-sample__col cmp-sample__col--own">
                  <p class="cmp-sample__col-label">公式EC</p>
                  <dl class="cmp-sample__dl">
                    <div><dt>表示価格</dt><dd class="num">{yen(p.ownPrice)}</dd></div>
                    <div><dt>ポイント</dt><dd class="num">+{oPts.toLocaleString()} 相当 <span class="sub">(基本 {OWN_EFFECTIVE_RATE}% 目安)</span></dd></div>
                    <div><dt>送料</dt><dd>¥5,000 以上で無料・同梱可</dd></div>
                    <div><dt>出荷</dt><dd>中1日 / 朝採り当日枠あり</dd></div>
                  </dl>
                  <a class="cmp-sample__own-link" href={`/products/${p.slug}/`}>
                    公式ECで見る
                  </a>
                </div>

                <div class="cmp-sample__col cmp-sample__col--yahoo">
                  <p class="cmp-sample__col-label">Yahoo!ショッピング店</p>
                  <dl class="cmp-sample__dl">
                    <div><dt>表示価格</dt><dd class="num">{yen(p.yahooPrice)}</dd></div>
                    <div><dt>ポイント</dt><dd class="num">+{yPts.toLocaleString()} 相当 <span class="sub">(目安 3%)</span></dd></div>
                    <div><dt>送料</dt><dd>店舗ごとに別送料</dd></div>
                    <div><dt>出荷</dt><dd>2〜3 営業日</dd></div>
                  </dl>
                  <a class="cmp-sample__yahoo-link" href={p.yahooUrl} target="_blank" rel="noopener noreferrer">
                    Yahoo!店も確認する
                  </a>
                </div>
              </div>

              <p class="cmp-sample__advantage">{p.ownAdvantage}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<section class="cmp-decide">
  <div class="cmp-decide__inner">
    <h2 class="cmp__h2 mincho">結局、どっちで買うのが得?</h2>
    <p class="cmp__lead">
      生活パターンで選ぶのが一番早いです。4つの場面で、店主のおすすめを書きました。
    </p>

    <ul class="cmp-decide__list">
      {scenarios.map((s) => (
        <li class={`cmp-decide__card cmp-decide__card--${s.rec === "公式EC" ? "own" : "yahoo"}`}>
          <p class="cmp-decide__tag">{s.tag}</p>
          <p class="cmp-decide__rec mincho">→ {s.rec}</p>
          <p class="cmp-decide__reason">{s.reason}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="cmp-cta">
  <div class="cmp-cta__inner">
    <p class="cmp-cta__eyebrow">SHOP ・ 購入相談</p>
    <h2 class="mincho">公式ECでは、商品選びから相談できます。</h2>
    <p>
      基本ポイントの目安、再入荷案内、贈答相談、LINE相談を見ながら選べます。
      Yahoo!店もそのまま続けて使っていただけます。
    </p>
    <div class="cmp-cta__buttons">
      <a href="/shop/" class="cmp-cta__primary">公式ECの商品を見る</a>
      <a href="/products/specialty/" class="cmp-cta__secondary">先に商品を見る</a>
    </div>
  </div>
</section>

</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <span class="brand__mark">北の逸品堂</span>
        <span class="brand__sub">SHIRETOKO TOURIST / 1992</span>
        <p class="addr">
          株式会社 知床ツーリスト<br />
          〒099-4403 北海道斜里郡清里町字向陽282番地
        </p>
      </div>
      <div>
        <h3>ショッピング</h3>
        <ul>
          <li><a href="/shop">SHOP</a></li>
          <li><a href="/products/specialty/">産直一覧</a></li>
          <li><a href="/products/apparel/">アパレル一覧</a></li>
          <li><a href="/bundles/">セット販売</a></li>
          <li><a href="/gift/">ギフト</a></li>
          <li><a href="/ranking/">ランキング</a></li>
        </ul>
      </div>
      <div>
        <h3>サポート / 会社</h3>
        <ul>
          <li><a href="/comparison/">購入方法</a></li>
          <li><a href="/furusato/">ふるさと納税</a></li>
          <li><a href="/stories/">ストーリー</a></li>
          <li><a href="/account/">会員ページ</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__legal">
      <span>(c) 1992-{currentYear} 株式会社 知床ツーリスト. All rights reserved.</span>
      <span class="payments">クレジットカード / コード決済 / 銀行振込</span>
    </div>
  </div>
</footer>

<style>
  .page-comparison { background: #F6F3EC; color: #1A1A1A; }

  .cmp, .cmp-samples, .cmp-decide { padding: 64px 24px; }
  .cmp__inner, .cmp-samples__inner, .cmp-decide__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .cmp__h2 {
    font-size: 28px;
    line-height: 1.4;
    font-weight: 600;
    margin: 0 0 12px;
    letter-spacing: .02em;
  }
  .cmp__lead {
    font-size: 14px;
    line-height: 1.9;
    color: rgba(26, 26, 26, .72);
    max-width: 720px;
    margin: 0 0 32px;
  }

  /* 比較表 */
  .cmp-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(26, 26, 26, .12);
    border-radius: 3px;
    background: #fff;
  }
  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }
  .cmp-table thead th {
    text-align: left;
    padding: 18px 20px;
    background: #1A1A1A;
    color: #F6F3EC;
    border-bottom: 1px solid rgba(246, 243, 236, .12);
    vertical-align: bottom;
  }
  .cmp-table__axis { width: 22%; }
  .cmp-table__yahoo, .cmp-table__own { width: 39%; }
  .cmp-table__own { background: #3C8186; }
  .cmp-table__col-label {
    display: block;
    font-family: "Noto Serif JP", serif;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: .04em;
  }
  .cmp-table__col-sub {
    display: block;
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 0.78rem;
    letter-spacing: .18em;
    margin-top: 4px;
    opacity: .7;
    text-transform: uppercase;
  }

  .cmp-row { border-bottom: 1px solid rgba(26, 26, 26, .08); }
  .cmp-row:last-child { border-bottom: none; }
  .cmp-row > th, .cmp-row > td {
    padding: 20px;
    vertical-align: top;
    font-size: 14px;
    line-height: 1.75;
  }
  .cmp-row__axis {
    text-align: left;
    background: rgba(26, 26, 26, .03);
    font-weight: 500;
  }
  .cmp-row__axis .mincho {
    display: block;
    font-size: 15px;
    margin-bottom: 8px;
  }
  .cmp-row__yahoo, .cmp-row__own { color: #1A1A1A; }
  .cmp-row__yahoo p, .cmp-row__own p { margin: 0 0 8px; }
  .cmp-row__own {
    background: rgba(60, 129, 134, .04);
  }
  .cmp-row--own .cmp-row__own {
    background: rgba(60, 129, 134, .08);
    border-left: 2px solid #3C8186;
  }
  .cmp-row--yahoo .cmp-row__yahoo {
    background: rgba(185, 146, 83, .06);
    border-left: 2px solid #B99253;
  }
  .cmp-row__note {
    font-size: 0.82rem;
    color: rgba(26, 26, 26, .6);
    line-height: 1.7;
    border-top: 1px dashed rgba(26, 26, 26, .14);
    padding-top: 8px;
    margin-top: 8px;
  }

  /* 勝者バッジ */
  .cmp-badge {
    display: inline-block;
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: .18em;
    padding: 3px 8px;
    border-radius: 2px;
    text-transform: uppercase;
  }
  .cmp-badge--own   { background: #3C8186; color: #F6F3EC; }
  .cmp-badge--yahoo { background: #B99253; color: #1A1A1A; }
  .cmp-badge--tie   { background: rgba(26, 26, 26, .08); color: rgba(26, 26, 26, .72); }

  .cmp-foot-note {
    font-size: 0.82rem;
    color: rgba(26, 26, 26, .6);
    line-height: 1.7;
    margin: 16px 0 0;
  }
  .cmp-points-note {
    font-size: 0.82rem;
    color: rgba(26, 26, 26, .68);
    line-height: 1.8;
    max-width: 720px;
    margin: -16px 0 32px;
    padding: 12px 14px;
    background: rgba(60, 129, 134, .06);
    border-left: 2px solid #3C8186;
    border-radius: 2px;
  }
  .cmp-points-note strong { color: #1A1A1A; }

  /* 商品サンプル */
  .cmp-samples { background: #ECE7DC; }
  .cmp-samples__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }
  .cmp-sample {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 32px;
    background: #F6F3EC;
    border: 1px solid rgba(26, 26, 26, .1);
    border-radius: 3px;
    padding: 24px;
  }
  .cmp-sample__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(60, 129, 134, .08), rgba(185, 146, 83, .08));
    border-radius: 2px;
    text-decoration: none;
    padding: 16px;
    transition: background 300ms ease;
  }
  .cmp-sample__media:hover {
    background: linear-gradient(135deg, rgba(60, 129, 134, .14), rgba(185, 146, 83, .14));
  }
  .cmp-sample__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cmp-sample__media-fallback {
    font-family: "Noto Serif JP", serif;
    font-size: 15px;
    font-weight: 500;
    color: #1A1A1A;
    text-align: center;
    line-height: 1.6;
    letter-spacing: .02em;
  }

  .cmp-sample__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .cmp-sample__title {
    font-size: 19px;
    font-weight: 600;
    margin: 0;
    line-height: 1.5;
  }
  .cmp-sample__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid rgba(26, 26, 26, .1);
    border-radius: 2px;
    overflow: hidden;
  }
  .cmp-sample__col {
    padding: 16px;
    background: #fff;
  }
  .cmp-sample__col--own {
    border-right: 1px solid rgba(26, 26, 26, .1);
    background: rgba(60, 129, 134, .08);
  }
  .cmp-sample__col--yahoo {
    background: rgba(185, 146, 83, .04);
  }
  .cmp-sample__col-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: 0.78rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, .6);
    margin: 0 0 10px;
  }
  .cmp-sample__col--own .cmp-sample__col-label { color: #3C8186; }
  .cmp-sample__col--yahoo .cmp-sample__col-label { color: #B99253; }

  .cmp-sample__dl { margin: 0; padding: 0; }
  .cmp-sample__dl > div {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px dashed rgba(26, 26, 26, .08);
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .cmp-sample__dl > div:last-child { border-bottom: none; }
  .cmp-sample__dl dt {
    color: rgba(26, 26, 26, .6);
    font-size: 0.82rem;
    letter-spacing: .04em;
    padding-top: 2px;
  }
  .cmp-sample__dl dd { margin: 0; color: #1A1A1A; }
  .cmp-sample__dl dd.num {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .cmp-sample__dl dd .sub {
    font-size: 0.82rem;
