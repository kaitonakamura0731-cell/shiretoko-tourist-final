---
// 北の逸品堂 / 運用ダッシュボード (デモ)
// 店主向け管理画面イメージ。実データ接続前のUIプレビュー用途。
import "../styles/global.css";
import {
  salesKpis,
  lineKpis,
  cartKpis,
  productRows,
  STOCK_ALERT_THRESHOLD,
  actionableMetrics,
} from "../data/dashboard";
import { productImageForKey } from "../data/sourceImages";

const meta = {
  title: "運用ダッシュボード (デモ)｜北の逸品堂",
  description: "店主向け管理画面のイメージ。売上 / 商品ランキング / LINE / カート指標を一画面で。",
};

const yen = (n: number) => "¥" + n.toLocaleString("ja-JP");
const currentYear = new Date().getFullYear();

const rowsWithImages = productRows.map((row, idx) => ({
  ...row,
  rank: idx + 1,
  salesLabel: yen(row.sales),
  ordersLabel: row.orders.toLocaleString("ja-JP") + " 件",
  stockLabel: row.stock.toLocaleString("ja-JP"),
  isLow: row.stock < STOCK_ALERT_THRESHOLD,
  image: productImageForKey(row.slug, row.title),
}));

function trendClass(trend?: string) {
  if (trend === "up") return "delta delta--up";
  if (trend === "down") return "delta delta--down";
  return "delta delta--flat";
}
function trendMark(trend?: string) {
  if (trend === "up") return "↑";
  if (trend === "down") return "↓";
  return "→";
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="dash-body">
    <!-- ============ DEMO topbar ============ -->
    <div class="topbar topbar--v3">
      <span class="topbar__pill topbar__pill--demo">DEMO</span>
      <span class="topbar__msg">これは公開デモ用の管理画面イメージです。認証前提の本番データは含みません。</span>
      <span class="topbar__divider" aria-hidden="true">・</span>
      <a href="/" class="topbar__cta">トップへ戻る</a>
    </div>

    <!-- ============ ヘッダ ============ -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark">北の逸品堂</span>
          <span class="brand__sub">ADMIN ・ 運用ダッシュボード</span>
        </a>
        <nav class="gnav" aria-label="管理メニュー">
          <a href="#sales">売上</a>
          <a href="#ranking">商品ランキング</a>
          <a href="#line">LINE</a>
          <a href="#cart">カート</a>
        </nav>
        <div class="header-utility">
          <span class="utility-link">店主アカウント</span>
        </div>
      </div>
    </header>

    <main class="dash-main">
      <!-- ============ ヒーロー ============ -->
      <section class="listing-hero">
        <div class="listing-hero__inner">
          <span class="eyebrow">ADMIN ・ 運用ダッシュボード (デモ)</span>
          <h1 class="mincho">今日の北の逸品堂。</h1>
          <p>数字を見るだけでなく、次に検討する打ち手まで見える管理画面です。自動配信などの追加機能はオプションとして扱います。</p>
          <p class="dash-stamp">最終更新: 2026-06-09 09:14 ・ 表示通貨 JPY ・ 店舗: 北の逸品堂 EC</p>
        </div>
      </section>

      <!-- ============ 指標から見る、次の一手 (オプション案) ============ -->
      <section class="dash-section dash-section--white" id="actions" aria-label="指標から打つ、次の一手">
        <div class="dash-section__inner">
          <div class="dash-section__head">
            <span class="section-eyebrow">NEXT ACTIONS</span>
            <h2 class="mincho">指標から打つ、次の一手</h2>
            <hr class="section-rule" />
            <p class="dash-section__lead">施策につながる数字だけをここに集約。自動送信などは基本機能ではなく、必要に応じて追加するオプション案として確認できます。</p>
          </div>
          <div class="act-grid">
            {actionableMetrics.map((m) => (
              <article class="act-card" data-act-card={m.key}>
                <div class="act-card__head">
                  <span class="act-card__label">{m.metricLabel}</span>
                  <span class="act-card__channel">{m.channel}</span>
                </div>
                <div class="act-card__value">{m.value}<small>{m.valueSub}</small></div>
                <p class="act-card__meaning">{m.meaning}</p>
                <p class="act-card__action">{m.action}</p>
                <button type="button" class="act-card__btn" data-act-open={m.key}>{m.buttonLabel}</button>
                <p class="act-card__sent" data-act-sent={m.key} hidden>
                  <span class="act-card__sent-text"></span>
                  <a href="#" class="act-card__resend" data-act-open={m.key}>再確認</a>
                </p>
                <span class="act-card__expected">{m.expected}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      {actionableMetrics.map((m) => (
        <div class="act-modal" data-act-modal={m.key} hidden>
          <div class="act-modal__backdrop" data-act-close></div>
          <div class="act-modal__panel" role="dialog" aria-modal="true" aria-label={`${m.metricLabel}のオプション案を確認`}>
            <h3 class="act-modal__title">{m.buttonLabel}</h3>
            <div class="act-modal__block">
              <span class="act-modal__block-label">対象のお客様</span>
              <ul class="act-modal__targets">
                {m.targets.map((t) => (
                  <li><b>{t.name}</b><span>{t.detail}</span>{t.value && <em>{t.value}</em>}</li>
                ))}
                {m.totalTargets > m.targets.length && (
                  <li class="act-modal__more">他 {m.totalTargets - m.targets.length} 人</li>
                )}
              </ul>
            </div>
            <div class="act-modal__block">
              <span class="act-modal__block-label">下書き内容 ({m.channel})</span>
              <div class="act-modal__mail">
                <p class="act-modal__mail-subject">{m.mailSubject}</p>
                <p class="act-modal__mail-body">{m.mailBody}</p>
              </div>
            </div>
            <p class="act-modal__note">※これはオプション機能のイメージです。デモ環境では実際の送信・自動配信は行われません。</p>
            <div class="act-modal__actions">
              <button type="button" class="act-modal__cancel" data-act-close>閉じる</button>
              <button type="button" class="act-modal__send" data-act-send={m.key} data-act-count={String(m.totalTargets)} data-act-label={m.metricLabel}>確認済みにする</button>
            </div>
          </div>
        </div>
      ))}

      <!-- ============ 売上KPI ============ -->
      <section class="dash-section" id="sales" aria-label="売上指標">
        <div class="dash-section__inner">
          <div class="dash-section__head">
            <span class="section-eyebrow">SALES</span>
            <h2 class="mincho">売上指標</h2>
            <hr class="section-rule" />
          </div>
          <div class="kpi-grid kpi-grid--sales">
            {salesKpis.map((kpi) => (
              <div class="kpi-card">
                <div class="kpi-card__label">{kpi.label}</div>
                <div class="kpi-card__value">{kpi.value}</div>
                <div class="kpi-card__meta">
                  {kpi.delta && (
                    <span class={trendClass(kpi.trend)}>
                      <span class="delta__mark" aria-hidden="true">{trendMark(kpi.trend)}</span>
                      {kpi.delta}
                    </span>
                  )}
                  {kpi.hint && <span class="kpi-card__hint">{kpi.hint}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ 商品ランキング ============ -->
      <section class="dash-section dash-section--white" id="ranking" aria-label="商品ランキング Top 10">
        <div class="dash-section__inner">
          <div class="dash-section__head">
            <span class="section-eyebrow">TOP 10</span>
            <h2 class="mincho">商品ランキング</h2>
            <hr class="section-rule" />
            <p class="dash-section__lead">今月の売上順 Top 10。在庫 {STOCK_ALERT_THRESHOLD} 未満は在庫アラート対象です。</p>
          </div>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead>
                <tr>
                  <th class="col-rank">順位</th>
                  <th class="col-img" aria-label="サムネ"></th>
                  <th class="col-name">商品名</th>
                  <th class="col-num">売上</th>
                  <th class="col-num">注文数</th>
                  <th class="col-num">在庫</th>
                </tr>
              </thead>
              <tbody>
                {rowsWithImages.map((row) => (
                  <tr class={row.isLow ? "is-low" : ""}>
                    <td class="col-rank"><span class="rank-pill">{row.rank}</span></td>
                    <td class="col-img">
                      <div class="thumb">
                        {row.image.src ? (
                          <img src={row.image.src} alt="" loading="lazy" decoding="async" />
                        ) : (
                          <div class="thumb__ph" aria-hidden="true"></div>
                        )}
                      </div>
                    </td>
                    <td class="col-name">
                      <span class="row-title">{row.title}</span>
                      <span class="row-slug">{row.slug}</span>
                    </td>
                    <td class="col-num tnum">{row.salesLabel}</td>
                    <td class="col-num tnum">{row.ordersLabel}</td>
                    <td class="col-num tnum">
                      <span class={row.isLow ? "stock stock--low" : "stock"}>{row.stockLabel}</span>
                      {row.isLow && <span class="stock-badge">在庫アラート</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ============ LINE指標 ============ -->
      <section class="dash-section" id="line" aria-label="LINE指標">
        <div class="dash-section__inner">
          <div class="dash-section__head">
            <a class="dash-act-link" href="#actions">→ 打ち手: 再入荷通知を送る</a>
            <span class="section-eyebrow">LINE</span>
            <h2 class="mincho">LINE 指標</h2>
            <hr class="section-rule" />
          </div>
          <div class="kpi-grid kpi-grid--line">
            {lineKpis.map((kpi) => (
              <div class="kpi-card kpi-card--compact">
                <div class="kpi-card__label">{kpi.label}</div>
                <div class="kpi-card__value">{kpi.value}</div>
                <div class="kpi-card__meta">
                  {kpi.delta && (
                    <span class={trendClass(kpi.trend)}>
                      <span class="delta__mark" aria-hidden="true">{trendMark(kpi.trend)}</span>
                      {kpi.delta}
                    </span>
                  )}
                  {kpi.hint && <span class="kpi-card__hint">{kpi.hint}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ カート指標 ============ -->
      <section class="dash-section dash-section--white" id="cart" aria-label="カート指標">
        <div class="dash-section__inner">
          <div class="dash-section__head">
            <a class="dash-act-link" href="#actions">→ 打ち手: 離脱クーポンを送る</a>
            <span class="section-eyebrow">CART</span>
            <h2 class="mincho">カート指標</h2>
            <hr class="section-rule" />
          </div>
          <div class="kpi-grid kpi-grid--cart">
            {cartKpis.map((kpi) => (
              <div class="kpi-card kpi-card--compact">
                <div class="kpi-card__label">{kpi.label}</div>
                <div class="kpi-card__value">{kpi.value}</div>
                <div class="kpi-card__meta">
                  {kpi.delta && (
                    <span class={trendClass(kpi.trend)}>
                      <span class="delta__mark" aria-hidden="true">{trendMark(kpi.trend)}</span>
                      {kpi.delta}
                    </span>
                  )}
                  {kpi.hint && <span class="kpi-card__hint">{kpi.hint}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ 確認ログ ============ -->
      <section class="dash-section" id="action-log" aria-label="確認ログ">
        <div class="dash-section__inner">
          <div class="dash-section__head">
            <span class="section-eyebrow">ACTION LOG</span>
            <h2 class="mincho">オプション確認ログ</h2>
            <hr class="section-rule" />
          </div>
          <ul class="act-log" data-act-log>
            <li class="act-log__empty" data-act-log-empty>まだ確認履歴はありません。</li>
          </ul>
        </div>
      </section>

      <!-- ============ 注意書き ============ -->
      <section class="dash-disclaimer" aria-label="注意書き">
        <div class="dash-disclaimer__inner">
          <p>
            本ダッシュボードは公開デモ用のサンプル数値です。本番では認証を有効化し、実データに置き換えます。
          </p>
        </div>
      </section>
    </main>

    <script is:inline>
      // 指標→オプション案の確認 (デモ: 実送信なし・状態はlocalStorage保持)
      (function () {
        var KEY = "kn-dash-actions-v1";
        function load() {
          try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch (e) { return {}; }
        }
        function save(s) { localStorage.setItem(KEY, JSON.stringify(s)); }
        function pad(n) { return (n < 10 ? "0" : "") + n; }

        var logEl = document.querySelector("[data-act-log]");
        var logEmpty = document.querySelector("[data-act-log-empty]");

        function renderLog(state) {
          if (!logEl) return;
          logEl.querySelectorAll(".act-log__row").forEach(function (r) { r.remove(); });
          var entries = [];
          Object.keys(state).forEach(function (k) {
            (state[k].history || []).forEach(function (h) { entries.push(h); });
          });
          entries.sort(function (a, b) { return (b.ts || 0) - (a.ts || 0); });
          if (logEmpty) logEmpty.hidden = entries.length > 0;
          entries.forEach(function (h) {
            var li = document.createElement("li");
            li.className = "act-log__row";
            li.innerHTML = "<span class='act-log__time'>" + h.when + "</span><span class='act-log__what'>" + h.label + "</span><span class='act-log__count'>" + h.count + "件確認</span>";
            logEl.appendChild(li);
          });
        }

        function markSent(key, state) {
          var rec = state[key];
          var btn = document.querySelector("[data-act-card='" + key + "'] .act-card__btn");
          var sent = document.querySelector("[data-act-sent='" + key + "']");
          if (!rec || !rec.history || !rec.history.length) return;
          var last = rec.history[rec.history.length - 1];
          if (btn) btn.hidden = true;
          if (sent) {
            sent.hidden = false;
            var t = sent.querySelector(".act-card__sent-text");
            if (t) t.textContent = "✓ " + last.count + "件 確認済み " + last.when.split(" ")[1];
          }
        }

        function openModal(key) {
          var m = document.querySelector("[data-act-modal='" + key + "']");
          if (!m) return;
          m.hidden = false;
          document.body.style.overflow = "hidden";
        }
        function closeAll() {
          document.querySelectorAll("[data-act-modal]").forEach(function (m) { m.hidden = true; });
          document.body.style.overflow = "";
        }

        document.querySelectorAll("[data-act-open]").forEach(function (b) {
          b.addEventListener("click", function (e) {
            e.preventDefault();
            openModal(b.getAttribute("data-act-open"));
          });
        });
        document.querySelectorAll("[data-act-close]").forEach(function (b) {
          b.addEventListener("click", closeAll);
        });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeAll(); });

        document.querySelectorAll("[data-act-send]").forEach(function (b) {
          b.addEventListener("click", function () {
            var key = b.getAttribute("data-act-send");
            var count = b.getAttribute("data-act-count") || "0";
            var label = b.getAttribute("data-act-label") || "";
            var now = new Date();
            var when = (now.getMonth() + 1) + "/" + now.getDate() + " " + pad(now.getHours()) + ":" + pad(now.getMinutes());
            var state = load();
            if (!state[key]) state[key] = { history: [] };
            state[key].history.push({ ts: now.getTime(), when: when, label: label, count: count });
            save(state);
            closeAll();
            markSent(key, state);
            renderLog(state);
          });
        });

        var state = load();
        Object.keys(state).forEach(function (k) { markSent(k, state); });
        renderLog(state);
      })();
    </script>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__legal">
          <span>(c) 1992-{currentYear} 株式会社 知床ツーリスト. All rights reserved.</span>
          <span class="payments">ADMIN DEMO ・ noindex</span>
        </div>
      </div>
    </footer>

    <style>
      /* ===== ダッシュボード専用スタイル ===== */
      .dash-body { background: #F6F3EC; }
      .dash-main { padding-bottom: 3rem; }

      .topbar__pill--demo {
        background: #1A1A1A;
        color: #fff;
        letter-spacing: 0.12em;
      }

      .dash-stamp {
        margin-top: 0.6rem;
        font-family: "Inter", "Noto Sans JP", sans-serif;
        font-size: 0.78rem;
        color: #6b6b6b;
        font-feature-settings: "tnum" 1;
        letter-spacing: 0.04em;
      }
      .dash-demo-note {
        display: inline-block;
        margin: 0.8rem 0 0;
        padding: 0.45rem 0.65rem;
        border: 1px solid rgba(185, 146, 83, 0.45);
        border-radius: 3px;
        background: rgba(185, 146, 83, 0.08);
        font-size: 0.84rem;
        line-height: 1.6;
        color: #4a3b22;
      }

      .dash-section { padding: 2.4rem 1.6rem; }
      .dash-section--white { background: #fff; }
      .dash-section__inner { max-width: 1200px; margin: 0 auto; }
      .dash-section__head { margin-bottom: 1.4rem; }
      .dash-section__head h2 {
        font-size: 1.6rem;
        margin: 0.2rem 0 0.4rem;
        color: #1A1A1A;
      }
      .dash-section__lead {
        font-size: 0.88rem;
        color: #4a4a4a;
        margin-top: 0.6rem;
      }

      /* ===== KPI カード ===== */
      .kpi-grid {
        display: grid;
        gap: 0.9rem;
      }
      .kpi-grid--sales,
      .kpi-grid--line,
      .kpi-grid--cart {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
      }

      .kpi-card {
        background: #fff;
        border: 1px solid #E6E1D6;
        border-radius: 3px;
        padding: 1.1rem 1.1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .dash-section--white .kpi-card { background: #F6F3EC; border-color: #E6E1D6; }

      .kpi-card__label {
        font-size: 0.78rem;
        color: #6b6b6b;
        letter-spacing: 0.03em;
      }
      .kpi-card__value {
        font-family: "Inter", "Noto Sans JP", sans-serif;
        font-feature-settings: "tnum" 1;
        font-weight: 700;
        font-size: 1.7rem;
        line-height: 1.15;
        color: #1A1A1A;
        letter-spacing: -0.01em;
      }
      .kpi-card--compact .kpi-card__value { font-size: 1.45rem; }

      .kpi-card__meta {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.2rem;
      }
      .kpi-card__hint {
        font-size: 0.72rem;
        color: #8a8a8a;
        line-height: 1.5;
      }

      .delta {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-family: "Inter", "Noto Sans JP", sans-serif;
        font-feature-settings: "tnum" 1;
        font-weight: 600;
        font-size: 0.82rem;
        width: fit-content;
      }
      .delta__mark { font-size: 0.9rem; line-height: 1; }
      .delta--up { color: #2E7D52; }
      .delta--down { color: #C0392B; }
      .delta--flat { color: #8a8a8a; }

      /* ===== 商品ランキングテーブル ===== */
      .dash-table-wrap {
        overflow-x: auto;
        border: 1px solid #E6E1D6;
        border-radius: 3px;
        background: #fff;
      }
      .dash-section--white .dash-table-wrap { background: #F6F3EC; }

      .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
        min-width: 720px;
      }
      .dash-table thead th {
        text-align: left;
        font-size: 0.74rem;
        font-weight: 600;
        color: #6b6b6b;
        letter-spacing: 0.06em;
        padding: 0.8rem 0.9rem;
        border-bottom: 1px solid #E6E1D6;
        background: #fff;
        text-transform: uppercase;
      }
      .dash-section--white .dash-table thead th { background: #F6F3EC; }

      .dash-table tbody td {
        padding: 0.85rem 0.9rem;
        border-bottom: 1px solid #EFEAE0;
        vertical-align: middle;
        color: #1A1A1A;
      }
      .dash-table tbody tr:last-child td { border-bottom: none; }
      .dash-table tbody tr.is-low { background: rgba(192,57,43,0.03); }

      .col-rank { width: 56px; }
      .col-img  { width: 64px; }
      .col-name { min-width: 260px; }
      .col-num  { text-align: right; white-space: nowrap; }

      .tnum { font-family: "Inter", "Noto Sans JP", sans-serif; font-feature-settings: "tnum" 1; }

      .rank-pill {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 28px; height: 28px;
        background: #1A1A1A;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-weight: 700;
        font-size: 0.82rem;
        border-radius: 2px;
      }

      .thumb {
        width: 48px; height: 48px;
        overflow: hidden;
