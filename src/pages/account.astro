  <script is:inline>
    // マイページ: タブ切替 (選択セクションだけ表示)。location.hash で直接着地も可。
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll("[data-acct-tab]"));
      if (!tabs.length) return;
      var panelIds = tabs.map(function (t) { return t.getAttribute("data-acct-tab"); });

      function activate(id, pushHash) {
        if (panelIds.indexOf(id) === -1) id = panelIds[0];
        panelIds.forEach(function (pid) {
          var panel = document.getElementById(pid);
          if (panel) panel.classList.toggle("is-hidden", pid !== id);
        });
        tabs.forEach(function (t) {
          var on = t.getAttribute("data-acct-tab") === id;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        if (pushHash && history.replaceState) history.replaceState(null, "", "#" + id);
      }

      tabs.forEach(function (t) {
        t.addEventListener("click", function (e) {
          e.preventDefault();
          activate(t.getAttribute("data-acct-tab"), true);
        });
      });

      activate((location.hash || "").replace("#", "") || panelIds[0], false);
    })();
  </script>
