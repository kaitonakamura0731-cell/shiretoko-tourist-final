---
import Base from "../layouts/Base.astro";
import { ranks, sampleCustomer, nextRankInfo } from "../data/membership";
import { pointsInfo, birthdayCoupon, referral, subscriptions, restockInfo } from "../data/promotions";

const customer = sampleCustomer;
const currentRank = ranks.find((r) => r.id === customer.rank)!;
const { next, remaining } = nextRankInfo(customer);

function yen(n: number): string {
  return "¥" + n.toLocaleString("ja-JP");
}

function formatDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  return `${y}.${m}.${d}`;
}

// 進捗バー (現ランクしきい値→次ランクしきい値の間で現在位置を%表示)
function progressPercent(): number {
  if (!next) return 100;
  const span = next.threshold - currentRank.threshold;
  const cur = customer.totalSpent - currentRank.threshold;
  return Math.min(100, Math.max(0, Math.round((cur / span) * 100)));
}
const progress = progressPercent();

const lastName = customer.name.split(" ")[0];

// 直近の注文を新しい順に
const recentOrders = customer.history.slice().reverse();

// ページ内アンカータブ
const tabs = [
  { href: "#orders", label: "注文履歴" },
  { href: "#subscription", label: "定期便" },
  { href: "#coupon", label: "クーポン・紹介" },
  { href: "#notify", label: "通知" },
  { href: "#benefits", label: "特典" },
  { href: "#settings", label: "設定" },
];
---

<Base
  title="マイページ｜北の逸品堂"
  description="累計購入額・ランク特典・購入履歴を一つの場所で。北の逸品堂 会員マイページ。"
  bodyClass="account"
  robots="noindex,nofollow"
>
  <main>
    <nav class="breadcrumbs" aria-label="パンくず">
      <div class="breadcrumbs__inner">
        <a href="/">トップ</a> <span class="sep">/</span>
        <span class="current" aria-current="page">マイページ</span>
      </div>
    </nav>

    <!-- 1. 会員サマリ (ヒーローカード) -->
    <section class="summary-section">
      <div class="summary-inner">
        <div class="summary-head">
          <span class="section-eyebrow">ACCOUNT ・ マイページ</span>
          <h1 class="summary-title">ようこそ、{lastName}さま。</h1>
          <p class="account-demo-label">本画面はデモ表示です。実際の購入履歴や個人情報ではありません。</p>
        </div>

        <div class="summary-card">
          <div class="summary-card__rank" style={`--rank-color: ${currentRank.color}`}>
            <span class="summary-card__rank-eyebrow">現在のランク</span>
            <span class="summary-card__rank-name">{currentRank.name}</span>
            <span class="summary-card__rank-since">{customer.joinedAt.slice(0, 4)} 年からの会員</span>
          </div>

          <dl class="summary-card__stats">
            <div class="summary-stat">
              <dt>保有ポイント</dt>
              <dd class="summary-stat__num">{pointsInfo.sampleBalance.toLocaleString("ja-JP")}<small>p</small></dd>
              <p class="summary-stat__sub">1ポイント = 1円</p>
            </div>
            <div class="summary-stat">
              <dt>累計お買い物</dt>
              <dd class="summary-stat__num">{yen(customer.totalSpent)}</dd>
              <p class="summary-stat__sub">税抜・これまでの合計</p>
            </div>
            <div class="summary-stat">
              <dt>次のランクまで</dt>
              {next ? (
                <>
                  <dd class="summary-stat__num summary-stat__num--accent">{yen(remaining)}</dd>
                  <p class="summary-stat__sub">で {next.name} に到達</p>
                </>
              ) : (
                <>
                  <dd class="summary-stat__num summary-stat__num--accent">最上位</dd>
                  <p class="summary-stat__sub">ご到達ありがとうございます</p>
                </>
              )}
            </div>
          </dl>
        </div>

        {next && (
          <div class="summary-progress" aria-label={`次のランクまで ${progress}%`}>
            <div class="summary-progress__track">
              <div class="summary-progress__bar" style={`width: ${progress}%`}></div>
            </div>
            <div class="summary-progress__ticks">
              <span>{currentRank.name} {yen(currentRank.threshold)}</span>
              <span>{next.name} {yen(next.threshold)}</span>
            </div>
          </div>
        )}
      </div>

      <!-- 2. ページ内タブ (切替式: 選択セクションだけ表示。JS無効時はアンカーにフォールバック) -->
      <nav class="account-tabs" aria-label="マイページ内ナビ" data-acct-tabs>
        <div class="account-tabs__inner" role="tablist">
          {tabs.map((t, i) => (
            <a href={t.href} class={`account-tab${i === 0 ? " is-active" : ""}`} data-acct-tab={t.href.slice(1)} role="tab" aria-selected={i === 0 ? "true" : "false"}>{t.label}</a>
          ))}
        </div>
      </nav>
    </section>

    <!-- 3. 注文履歴 -->
    <section id="orders" class="account-block account-block--alt">
      <div class="section-inner">
        <header class="block-head">
          <span class="section-eyebrow">ORDER HISTORY</span>
          <h2 class="block-title">注文履歴</h2>
          <p class="block-lead">直近のご注文 {recentOrders.length} 件を表示しています。</p>
        </header>
        <div class="order-list">
          {recentOrders.map((order) => (
            <article class="order-card">
              <div class="order-card__head">
                <span class="order-card__date">{formatDate(order.date)}</span>
                <span class="order-card__total">{yen(order.total)}</span>
              </div>
              <ul class="order-card__items">
                {order.items.map((it) => (
                  <li class="order-card__item">
                    <span class="order-card__item-title">{it.title}</span>
                    <span class="order-card__item-meta">
                      <span>数量 {it.qty}</span>
                      <span class="dot">・</span>
                      <span>{yen(it.price)}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <div class="order-card__actions">
                <button class="link-action" type="button" disabled>同じ内容で再注文</button>
                <button class="link-action" type="button" disabled>明細を見る</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. 定期便の管理 -->
    <section id="subscription" class="account-block">
      <div class="section-inner">
        <header class="block-head">
          <span class="section-eyebrow">SUBSCRIPTION</span>
          <h2 class="block-title">定期便の管理</h2>
          <p class="block-lead">旬の便りを切らさずお届け。変更・スキップ・解約はいつでも自由、違約金はありません。</p>
        </header>
        <div class="sub-grid">
          {subscriptions.map((s) => (
            <article class="sub-card">
              <div class="sub-card__head">
                <span class="sub-card__title">{s.title}</span>
                <span class="sub-card__discount">{s.discount}</span>
              </div>
              <div class="sub-card__price">
                <span class="sub-card__price-now">{yen(s.subPrice)}</span>
                <span class="sub-card__price-was">通常 {yen(s.normalPrice)}</span>
              </div>
              <p class="sub-card__interval">お届け：{s.interval}</p>
              <p class="sub-card__note">{s.note}</p>
              <div class="sub-card__actions">
                <button class="link-action" type="button" disabled>この便を申し込む</button>
                <button class="link-action link-action--ghost" type="button" disabled>解約・スキップ</button>
              </div>
            </article>
          ))}
        </div>
        <p class="block-foot">ご利用中の定期便はこちらに表示されます。現在はサンプル表示です。<b>解約はワンクリック</b>、引き止めや電話確認は行いません。</p>
      </div>
    </section>

    <!-- 5. クーポン・紹介 -->
    <section id="coupon" class="account-block account-block--alt">
      <div class="section-inner">
        <header class="block-head">
          <span class="section-eyebrow">COUPON ・ REFERRAL</span>
          <h2 class="block-title">クーポン・紹介</h2>
          <p class="block-lead">お持ちのポイント・クーポンと、お友だち紹介をまとめてご確認いただけます。</p>
        </header>
        <div class="coupon-grid">
          <article class="info-card">
            <span class="info-card__eyebrow">POINTS ・ 保有ポイント</span>
            <p class="info-card__value">{pointsInfo.sampleBalance.toLocaleString("ja-JP")}<small>p</small></p>
            <p class="info-card__sub">1ポイント = 1円。次回のお買い物にそのままお使いいただけます。</p>
            <p class="info-card__note">付与率 {pointsInfo.rate}（税込）／有効期限：{pointsInfo.expiry}</p>
          </article>

          <article class="info-card">
            <span class="info-card__eyebrow">BIRTHDAY ・ 誕生月クーポン</span>
            <p class="info-card__value">{birthdayCoupon.amountLabel}</p>
            <p class="info-card__sub">{birthdayCoupon.description}</p>
            <p class="info-card__note">{birthdayCoupon.note}</p>
            <button class="link-action" type="button" disabled>誕生月を登録する</button>
          </article>

          <article class="info-card info-card--referral">
            <span class="info-card__eyebrow">REFERRAL ・ 友達紹介</span>
            <p class="info-card__value">{referral.rewardLabel}</p>
            <p class="info-card__sub">紹介リンクを送るだけ。紹介した方・された方の双方に <b>{referral.rewardLabel}</b> を進呈します。</p>
            <a href="/referral/" class="info-card__link">紹介ページへ &rarr;</a>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. LINE連携・再入荷通知 -->
    <section id="notify" class="account-block">
      <div class="section-inner">
        <header class="block-head">
          <span class="section-eyebrow">NOTIFICATION ・ 通知</span>
          <h2 class="block-title">{restockInfo.channel}連携・再入荷通知</h2>
          <p class="block-lead">入荷した瞬間に{restockInfo.channel}でお知らせします。人気の旬商品を逃しません。</p>
        </header>
        <ul class="restock-list">
          {restockInfo.targets.map((t) => (
            <li class="restock-item">
              <div class="restock-item__body">
                <span class="restock-item__title">{t.title}</span>
                <span class="restock-item__status">{t.expectedRestock}</span>
              </div>
              <div class="restock-item__side">
                <span class="restock-item__badge">{restockInfo.channel} 登録済</span>
                <button class="link-action link-action--ghost" type="button" disabled>解除</button>
              </div>
            </li>
          ))}
        </ul>
        <p class="block-foot">{restockInfo.note}</p>
      </div>
    </section>

    <!-- 7. 特典・ランク (二次情報は折りたたみ) -->
    <section id="benefits" class="account-block account-block--alt">
      <div class="section-inner">
        <header class="block-head">
          <span class="section-eyebrow">YOUR BENEFITS</span>
          <h2 class="block-title">あなたの特典</h2>
          <p class="block-lead">{currentRank.name} ランクで現在ご利用いただける特典です。</p>
        </header>
        <div class="benefits-grid">
          {currentRank.benefits.map((b) => (
            <div class="benefit-card">
              <span class="benefit-card__icon" aria-hidden="true">●</span>
              <span class="benefit-card__label">{b.label}</span>
            </div>
          ))}
        </div>

        <details class="rank-details">
          <summary>ランク一覧と到達条件を見る</summary>
          <div class="ranks-grid">
            {ranks.map((r) => (
              <article class={`rank-tile ${r.id === customer.rank ? "is-current" : ""}`}>
                {r.id === customer.rank && (
                  <span class="rank-tile__current">CURRENT</span>
                )}
                <div class="rank-tile__head" style={`--rank-color: ${r.color}`}>
                  <span class="rank-tile__name">{r.name}</span>
                  <span class="rank-tile__threshold">
                    {r.threshold === 0 ? "入会時から" : `${yen(r.threshold)} 以上`}
                  </span>
                </div>
                <ul class="rank-tile__benefits">
                  {r.benefits.map((b) => (
                    <li>{b.label}</li>
                  ))}
                </ul>
                <p class="rank-tile__note">「{r.storyNote}」</p>
              </article>
            ))}
          </div>
        </details>
      </div>
    </section>

    <!-- 8. アカウント設定 -->
    <section id="settings" class="account-block">
      <div class="section-inner section-inner--narrow">
        <header class="block-head">
          <span class="section-eyebrow">SETTINGS</span>
          <h2 class="block-title">アカウント設定</h2>
          <p class="block-lead">お届け先・お支払い・会員情報の変更はこちらから。</p>
        </header>
        <ul class="settings-list">
          <li><a class="settings-link" href="/account/"><span>お届け先住所の管理</span><span class="settings-link__arrow">&rarr;</span></a></li>
          <li><a class="settings-link" href="/account/"><span>お支払い方法</span><span class="settings-link__arrow">&rarr;</span></a></li>
          <li><a class="settings-link" href="/account/"><span>会員情報・誕生月の登録</span><span class="settings-link__arrow">&rarr;</span></a></li>
          <li><a class="settings-link" href="/account/"><span>送料・配送について</span><span class="settings-link__arrow">&rarr;</span></a></li>
          <li><a class="settings-link" href="/account/"><span>特定商取引法に基づく表記</span><span class="settings-link__arrow">&rarr;</span></a></li>
          <li><a class="settings-link" href="/account/"><span>プライバシーポリシー</span><span class="settings-link__arrow">&rarr;</span></a></li>
        </ul>
      </div>
    </section>
  </main>

  <style>
    .breadcrumbs {
      background: #F6F3EC;
      padding: 16px 24px 0;
    }
    .breadcrumbs__inner {
      max-width: 1100px;
      margin: 0 auto;
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      color: #1A1A1A;
      opacity: 0.7;
    }
    .breadcrumbs a {
      color: inherit;
      text-decoration: none;
    }
    .breadcrumbs a:hover {
      color: #3C8186;
    }
    .breadcrumbs .sep { margin: 0 8px; opacity: 0.4; }
    .breadcrumbs .current { color: #1A1A1A; }

    .section-eyebrow {
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: #B99253;
      text-transform: uppercase;
    }

    /* ── 1. 会員サマリ ────────────────────────── */
    .summary-section {
      background: #F6F3EC;
      padding: clamp(40px, 6vw, 72px) 0 0;
    }
    .summary-inner {
      max-width: 920px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .summary-head {
      text-align: center;
      margin-bottom: clamp(28px, 4vw, 44px);
    }
    .summary-title {
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(26px, 4vw, 42px);
      line-height: 1.4;
      letter-spacing: 0.02em;
      color: #1A1A1A;
      margin: 14px 0 18px;
    }
    .account-demo-label {
      display: inline-block;
      margin: 0 auto;
      padding: 6px 10px;
      border: 1px solid rgba(185, 146, 83, 0.4);
      border-radius: 3px;
      color: #6B5F4F;
      font-size: 0.8rem;
      line-height: 1.6;
      background: #fff;
    }
    .summary-card {
      background: #fff;
      border: 1px solid #C9BFA8;
      border-radius: 4px;
      padding: clamp(24px, 3.5vw, 40px);
      display: grid;
      grid-template-columns: minmax(180px, 230px) 1fr;
      gap: clamp(20px, 3vw, 40px);
      align-items: center;
    }
    .summary-card__rank {
      --rank-color: #B99253;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: clamp(18px, 2.5vw, 26px);
      border-radius: 3px;
      background: #F6F3EC;
      border-left: 4px solid var(--rank-color);
    }
    .summary-card__rank-eyebrow {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      color: #1A1A1A;
      opacity: 0.7;
    }
    .summary-card__rank-name {
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(30px, 4vw, 40px);
      line-height: 1.1;
      letter-spacing: 0.02em;
      color: var(--rank-color);
    }
    .summary-card__rank-since {
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-feature-settings: "tnum";
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      color: #6B5F4F;
    }
    .summary-card__stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: clamp(16px, 2.5vw, 28px);
      margin: 0;
    }
    .summary-stat dt {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.82rem;
      color: #1A1A1A;
      opacity: 0.7;
    }
    .summary-stat__num {
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-feature-settings: "tnum";
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 600;
      line-height: 1.15;
      color: #1A1A1A;
      margin: 6px 0 4px;
    }
    .summary-stat__num small {
      font-size: 0.5em;
      font-weight: 600;
      margin-left: 2px;
      opacity: 0.75;
    }
    .summary-stat__num--accent { color: #3C8186; }
    .summary-stat__sub {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.76rem;
      line-height: 1.6;
      color: #6B5F4F;
      margin: 0;
    }
    .summary-progress {
      max-width: 920px;
      margin: clamp(20px, 3vw, 28px) auto 0;
      padding: 0 24px;
    }
    .summary-progress__track {
      height: 6px;
      background: rgba(201, 191, 168, 0.5);
      border-radius: 3px;
      overflow: hidden;
    }
    .summary-progress__bar {
      height: 100%;
      background: linear-gradient(90deg, #B99253, #3C8186);
      border-radius: 3px;
      transition: width 600ms cubic-bezier(.2,.7,.2,1);
    }
    .summary-progress__ticks {
      display: flex;
      justify-content: space-between;
      margin-top: 8px;
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-feature-settings: "tnum";
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      color: #1A1A1A;
      opacity: 0.6;
    }
    @media (max-width: 640px) {
      .summary-card {
        grid-template-columns: 1fr;
      }
    }

    /* ── 2. ページ内タブ ────────────────────────── */
    .account-tabs {
      position: sticky;
      top: 0;
      z-index: 20;
      margin-top: clamp(32px, 5vw, 56px);
      background: rgba(246, 243, 236, 0.94);
      backdrop-filter: blur(6px);
      border-top: 1px solid #C9BFA8;
      border-bottom: 1px solid #C9BFA8;
    }
    .account-tabs__inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 16px;
      display: flex;
      gap: 4px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .account-tabs__inner::-webkit-scrollbar { display: none; }
    .account-tab {
      flex: 0 0 auto;
      padding: 14px 16px;
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.86rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #1A1A1A;
      text-decoration: none;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .account-tab:hover {
      color: #3C8186;
      border-bottom-color: #3C8186;
    }

    /* ── セクション共通 ────────────────────────── */
    .account-block {
      padding: clamp(48px, 7vw, 88px) 0;
      background: #fff;
      scroll-margin-top: 64px;
    }
    .account-block--alt { background: #F6F3EC; }
    .section-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .section-inner--narrow { max-width: 760px; }
    .block-head {
      text-align: center;
      margin-bottom: clamp(28px, 4.5vw, 48px);
    }
    .block-title {
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(22px, 3.2vw, 32px);
      line-height: 1.5;
      color: #1A1A1A;
      margin: 12px 0 12px;
      padding-bottom: 14px;
      border-bottom: 1px solid #C9BFA8;
      display: inline-block;
    }
    .block-lead {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 14px;
      line-height: 1.9;
      color: #1A1A1A;
      opacity: 0.78;
      max-width: 600px;
      margin: 0 auto;
    }
    .block-foot {
      max-width: 760px;
      margin: clamp(22px, 3.5vw, 32px) auto 0;
      text-align: center;
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.84rem;
      line-height: 1.9;
      color: #1A1A1A;
      opacity: 0.8;
    }
    .block-foot b { color: #866326; }

    /* 共通リンク風アクション */
    .link-action {
      appearance: none;
      background: transparent;
      border: 0;
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      color: #3C8186;
      text-decoration: none;
      border-bottom: 1px solid #3C8186;
      padding: 0 0 1px;
      letter-spacing: 0.04em;
      cursor: pointer;
    }
    .link-action:hover { color: #1A1A1A; border-color: #1A1A1A; }
    .link-action--ghost {
      color: #6B5F4F;
      border-color: rgba(107, 95, 79, 0.5);
    }
