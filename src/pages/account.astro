---
import Base from "../layouts/Base.astro";
import { ranks, sampleCustomer, nextRankInfo } from "../data/membership";
import { pointsInfo, birthdayCoupon, referral, subscriptions, restockInfo } from "../data/promotions";

const customer = sampleCustomer;
const currentRank = ranks.find((r) => r.id === customer.rank)!;
const { next, remaining } = nextRankInfo(customer);

function yen(n: number): string {
  return "¥" + n.toLocaleString("ja-JP");
}

function formatDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  return `${y}.${m}.${d}`;
}

// 進捗バー (現ランクしきい値→次ランクしきい値の間で現在位置を%表示)
function progressPercent(): number {
  if (!next) return 100;
  const span = next.threshold - currentRank.threshold;
  const cur = customer.totalSpent - currentRank.threshold;
  return Math.min(100, Math.max(0, Math.round((cur / span) * 100)));
}
const progress = progressPercent();

const lastName = customer.name.split(" ")[0];
---

<Base
  title="マイページ｜北の逸品堂"
  description="累計購入額・ランク特典・購入履歴を一つの場所で。北の逸品堂 会員マイページ。"
  bodyClass="account"
  robots="noindex,nofollow"
>
  <main>
    <nav class="breadcrumbs" aria-label="パンくず">
      <div class="breadcrumbs__inner">
        <a href="/">トップ</a> <span class="sep">/</span>
        <span class="current" aria-current="page">マイページ</span>
      </div>
    </nav>

    <section class="listing-hero">
      <div class="listing-hero__inner">
        <span class="section-eyebrow">ACCOUNT ・ マイページ</span>
        <h1 class="listing-hero__title">ようこそ、{lastName}さま。</h1>
        <p class="listing-hero__lead">
          {customer.joinedAt.slice(0, 4)} 年からのお付き合い、ありがとうございます。
          今年も旬の便りをお届けします。
        </p>
        <p class="account-demo-label">本画面はデモ表示です。実際の購入履歴や個人情報ではありません。</p>
      </div>
    </section>

    <section class="rank-card-section">
      <div class="rank-card">
        <div class="rank-card__badge" style={`--rank-color: ${currentRank.color}`}>
          <span class="rank-card__badge-label">RANK</span>
          <span class="rank-card__badge-name">{currentRank.name}</span>
        </div>
        <div class="rank-card__body">
          <div class="rank-card__row">
            <span class="rank-card__row-label">累計お買い物</span>
            <span class="rank-card__row-value">{yen(customer.totalSpent)}</span>
          </div>
          {next ? (
            <>
              <div class="rank-card__row">
                <span class="rank-card__row-label">次のランクまで</span>
                <span class="rank-card__row-value">
                  <strong>{yen(remaining)}</strong>
                  <span class="rank-card__row-sub">で {next.name} に到達</span>
                </span>
              </div>
              <div class="progress" aria-label={`次のランクまで ${progress}%`}>
                <div class="progress__bar" style={`width: ${progress}%`}></div>
                <div class="progress__ticks">
                  <span>{currentRank.name} {yen(currentRank.threshold)}</span>
                  <span>{next.name} {yen(next.threshold)}</span>
                </div>
              </div>
            </>
          ) : (
            <p class="rank-card__top">最上位ランクにご到達。いつも本当にありがとうございます。</p>
          )}
        </div>
      </div>
    </section>

    <section class="promo-cards-section">
      <div class="section-inner">
        <div class="promo-cards">
          <article class="promo-card promo-card--points">
            <span class="promo-card__eyebrow">POINTS ・ 保有ポイント</span>
            <p class="promo-card__value">{pointsInfo.sampleBalance.toLocaleString("ja-JP")}<small>p</small></p>
            <p class="promo-card__sub">1ポイント = 1円。次回のお買い物にそのままお使いいただけます。</p>
            <ul class="promo-card__list">
              {pointsInfo.usage.map((u) => <li>{u}</li>)}
            </ul>
            <p class="promo-card__note">付与率 {pointsInfo.rate}（税込）／有効期限：{pointsInfo.expiry}</p>
          </article>

          <article class="promo-card promo-card--birthday">
            <span class="promo-card__eyebrow">BIRTHDAY ・ 誕生月クーポン</span>
            <p class="promo-card__value">{birthdayCoupon.amountLabel}</p>
            <p class="promo-card__sub">{birthdayCoupon.description}</p>
            <p class="promo-card__note">{birthdayCoupon.note}</p>
            <button class="promo-card__action" type="button" disabled>誕生月を登録する</button>
          </article>
        </div>
      </div>
    </section>

    <section class="benefits-section">
      <div class="section-inner">
        <header class="section-head">
          <span class="section-eyebrow">YOUR BENEFITS</span>
          <h2 class="section-title">あなたの特典</h2>
          <p class="section-lead">{currentRank.name} ランクで現在ご利用いただける特典です。</p>
        </header>
        <div class="benefits-grid">
          {currentRank.benefits.map((b) => (
            <div class="benefit-card">
              <span class="benefit-card__icon" aria-hidden="true">●</span>
              <span class="benefit-card__label">{b.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ranks-section">
      <div class="section-inner">
        <header class="section-head">
          <span class="section-eyebrow">MEMBERSHIP</span>
          <h2 class="section-title">ランク一覧</h2>
          <p class="section-lead">年間の累計お買い物額に応じて、特典が変わります。</p>
        </header>
        <div class="ranks-grid">
          {ranks.map((r) => (
            <article class={`rank-tile ${r.id === customer.rank ? "is-current" : ""}`}>
              {r.id === customer.rank && (
                <span class="rank-tile__current">CURRENT</span>
              )}
              <div class="rank-tile__head" style={`--rank-color: ${r.color}`}>
                <span class="rank-tile__name">{r.name}</span>
                <span class="rank-tile__threshold">
                  {r.threshold === 0 ? "入会時から" : `${yen(r.threshold)} 以上`}
                </span>
              </div>
              <ul class="rank-tile__benefits">
                {r.benefits.map((b) => (
                  <li>{b.label}</li>
                ))}
              </ul>
              <p class="rank-tile__note">「{r.storyNote}」</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="history-section">
      <div class="section-inner">
        <header class="section-head">
          <span class="section-eyebrow">ORDER HISTORY</span>
          <h2 class="section-title">購入履歴</h2>
          <p class="section-lead">直近のご注文 {customer.history.length} 件を表示しています。</p>
        </header>
        <div class="history-list">
          {customer.history.slice().reverse().map((order) => (
            <article class="history-card">
              <div class="history-card__head">
                <span class="history-card__date">{formatDate(order.date)}</span>
                <span class="history-card__total">{yen(order.total)}</span>
              </div>
              <ul class="history-card__items">
                {order.items.map((it) => (
                  <li class="history-card__item">
                    <span class="history-card__item-title">{it.title}</span>
                    <span class="history-card__item-meta">
                      <span>数量 {it.qty}</span>
                      <span class="dot">・</span>
                      <span>{yen(it.price)}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <div class="history-card__actions">
                <button class="history-card__action" type="button" disabled>同じ内容で再注文</button>
                <button class="history-card__action" type="button" disabled>明細を見る</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="subscriptions-section">
      <div class="section-inner">
        <header class="section-head">
          <span class="section-eyebrow">SUBSCRIPTION</span>
          <h2 class="section-title">定期便の管理</h2>
          <p class="section-lead">旬の便りを切らさずお届け。お届け間隔の変更・スキップ・解約はいつでも自由、違約金はありません。</p>
        </header>
        <div class="sub-grid">
          {subscriptions.map((s) => (
            <article class="sub-card">
              <div class="sub-card__head">
                <span class="sub-card__title">{s.title}</span>
                <span class="sub-card__discount">{s.discount}</span>
              </div>
              <div class="sub-card__price">
                <span class="sub-card__price-now">{yen(s.subPrice)}</span>
                <span class="sub-card__price-was">通常 {yen(s.normalPrice)}</span>
              </div>
              <p class="sub-card__interval">お届け：{s.interval}</p>
              <p class="sub-card__note">{s.note}</p>
              <div class="sub-card__actions">
                <button class="sub-card__action" type="button" disabled>この便を申し込む</button>
                <button class="sub-card__action sub-card__action--ghost" type="button" disabled>解約・スキップ</button>
              </div>
            </article>
          ))}
        </div>
        <p class="sub-foot">ご利用中の定期便はこちらに表示されます。現在はサンプル表示です。<b>解約はワンクリック</b>、引き止めや電話確認は行いません。</p>
      </div>
    </section>

    <section class="referral-section">
      <div class="referral-inner">
        <span class="section-eyebrow">REFERRAL ・ 友達紹介</span>
        <h2 class="section-title">友達を紹介すると、双方に {referral.rewardLabel}</h2>
        <p class="referral-lead">紹介リンクを発行してお友だちに送るだけ。紹介した方・された方の双方に <b>{referral.rewardLabel}</b> を進呈します。</p>
        <a href="/referral/" class="btn btn--primary">紹介ページへ &rarr;</a>
        <p class="referral-note">{referral.note}</p>
      </div>
    </section>

    <section class="restock-section">
      <div class="section-inner">
        <header class="section-head">
          <span class="section-eyebrow">RESTOCK ・ 再入荷通知</span>
          <h2 class="section-title">再入荷通知の登録リスト</h2>
          <p class="section-lead">入荷した瞬間に{restockInfo.channel}でお知らせします。人気の旬商品を逃しません。</p>
        </header>
        <ul class="restock-list">
          {restockInfo.targets.map((t) => (
            <li class="restock-item">
              <div class="restock-item__body">
                <span class="restock-item__title">{t.title}</span>
                <span class="restock-item__status">{t.expectedRestock}</span>
              </div>
              <div class="restock-item__side">
                <span class="restock-item__badge">{restockInfo.channel} 登録済</span>
                <button class="restock-item__cancel" type="button" disabled>解除</button>
              </div>
            </li>
          ))}
        </ul>
        <p class="restock-note">{restockInfo.note}</p>
      </div>
    </section>

    <section class="howto-section">
      <div class="howto-inner">
        <span class="section-eyebrow">FROM THE OWNER</span>
        <h2 class="howto-title">お得な使い方</h2>
        <blockquote class="howto-quote">
          「{currentRank.storyNote}」
        </blockquote>
        <p class="howto-lead">
          Silver の {lastName} さまには、送料無料と全商品 5%OFF が付いています。
          一番おすすめなのは、旬のアスパラを箱買いする時。送料分が浮くので、もう一箱ご家族へ送る方が多いです。
          誕生月クーポン {yen(1000)} は、その月のお買い物に自動で適用されます。
        </p>
        <p class="howto-lead">
          あと {yen(remaining)} で Gold に到達すると、限定品の先行販売や全商品 10%OFF が始まります。
          毎年 6〜7 月の新じゃが・アスパラの時期に到達される方が一番多いです。
        </p>
        <p class="howto-sign">— 店主 高橋</p>
      </div>
    </section>
  </main>

  <style>
    .breadcrumbs {
      background: #F6F3EC;
      padding: 16px 24px 0;
    }
    .breadcrumbs__inner {
      max-width: 1100px;
      margin: 0 auto;
      font-family: "Noto Sans JP", sans-serif;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      color: #1A1A1A;
      opacity: 0.7;
    }
    .breadcrumbs a {
      color: inherit;
      text-decoration: none;
    }
    .breadcrumbs a:hover {
      color: #3C8186;
    }
    .breadcrumbs .sep { margin: 0 8px; opacity: 0.4; }
    .breadcrumbs .current { color: #1A1A1A; }

    .listing-hero {
      padding: clamp(48px, 7vw, 88px) 24px clamp(32px, 5vw, 56px);
      background: #F6F3EC;
    }
    .listing-hero__inner {
      max-width: 920px;
      margin: 0 auto;
      text-align: center;
    }
    .section-eyebrow {
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: #B99253;
      text-transform: uppercase;
    }
    .listing-hero__title {
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(28px, 4.4vw, 48px);
      line-height: 1.4;
      letter-spacing: 0.02em;
      color: #1A1A1A;
      margin: 16px 0 24px;
    }
    .listing-hero__lead {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 15px;
      line-height: 1.95;
      color: #1A1A1A;
      opacity: 0.82;
      max-width: 680px;
      margin: 0 auto;
    }
    .account-demo-label {
      display: inline-block;
      margin: 18px auto 0;
      padding: 6px 10px;
      border: 1px solid rgba(185, 146, 83, 0.4);
      border-radius: 3px;
      color: #6B5F4F;
      font-size: 0.8rem;
      line-height: 1.6;
      background: #fff;
    }

    /* ランクカード */
    .rank-card-section {
      background: #F6F3EC;
      padding: clamp(24px, 4vw, 48px) 24px clamp(48px, 7vw, 80px);
    }
    .rank-card {
      max-width: 880px;
      margin: 0 auto;
      background: #fff;
      border: 1px solid rgba(26, 26, 26, 0.08);
      border-radius: 4px;
      padding: clamp(28px, 4vw, 48px);
      display: grid;
      grid-template-columns: minmax(180px, 220px) 1fr;
      gap: clamp(24px, 4vw, 48px);
      align-items: center;
    }
    .rank-card__badge {
      --rank-color: #B99253;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1 / 1;
      border: 2px solid var(--rank-color);
      border-radius: 50%;
      color: var(--rank-color);
      text-align: center;
    }
    .rank-card__badge-label {
      font-family: "Inter", sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      opacity: 0.8;
    }
    .rank-card__badge-name {
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(32px, 4.6vw, 44px);
      letter-spacing: 0.02em;
      margin-top: 6px;
    }
    .rank-card__body { width: 100%; }
    .rank-card__row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 14px 0;
      border-bottom: 1px solid rgba(26, 26, 26, 0.08);
      font-family: "Noto Sans JP", sans-serif;
    }
    .rank-card__row-label {
      font-size: 0.84rem;
      color: #1A1A1A;
      opacity: 0.7;
    }
    .rank-card__row-value {
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-feature-settings: "tnum";
      font-size: clamp(20px, 2.4vw, 26px);
      font-weight: 600;
      color: #1A1A1A;
    }
    .rank-card__row-value strong { color: #3C8186; }
    .rank-card__row-sub {
      font-size: 0.82rem;
      font-weight: 400;
      opacity: 0.65;
      margin-left: 10px;
      letter-spacing: 0.04em;
    }
    .progress {
      margin-top: 20px;
    }
    .progress__bar {
      height: 6px;
      background: linear-gradient(90deg, #B99253, #3C8186);
      border-radius: 3px;
      transition: width 600ms cubic-bezier(.2,.7,.2,1);
    }
    .progress__ticks {
      display: flex;
      justify-content: space-between;
      margin-top: 8px;
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-feature-settings: "tnum";
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      color: #1A1A1A;
      opacity: 0.6;
    }
    .rank-card__top {
      font-family: "Noto Serif JP", serif;
      font-size: 15px;
      line-height: 1.9;
      color: #1A1A1A;
      margin: 16px 0 0;
    }
    @media (max-width: 640px) {
      .rank-card {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .rank-card__badge {
        max-width: 180px;
        margin: 0 auto;
      }
    }

    /* セクション共通 */
    .section-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .section-head {
      text-align: center;
      margin-bottom: clamp(32px, 5vw, 56px);
    }
    .section-title {
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(24px, 3.4vw, 36px);
      line-height: 1.5;
      color: #1A1A1A;
      margin: 12px 0 14px;
    }
    .section-lead {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 14px;
      line-height: 1.9;
      color: #1A1A1A;
      opacity: 0.78;
      max-width: 560px;
      margin: 0 auto;
    }

    /* 特典 */
    .benefits-section {
      padding: clamp(56px, 8vw, 96px) 0;
      background: #fff;
    }
    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }
    .benefit-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 20px 22px;
      background: #F6F3EC;
      border-radius: 3px;
      font-family: "Noto Sans JP", sans-serif;
      font-size: 14.5px;
      line-height: 1.7;
      color: #1A1A1A;
    }
    .benefit-card__icon {
      color: #B99253;
      font-size: 9px;
      line-height: 1;
      flex-shrink: 0;
    }

    /* ランク一覧 */
    .ranks-section {
      padding: clamp(56px, 8vw, 96px) 0;
      background: #F6F3EC;
    }
    .ranks-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(16px, 2vw, 24px);
    }
    .rank-tile {
      position: relative;
      background: #fff;
      border: 1px solid rgba(26, 26, 26, 0.08);
      border-radius: 4px;
      padding: clamp(24px, 3vw, 32px);
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .rank-tile.is-current {
      border-color: var(--camel);
      outline: 1px solid var(--camel);
      outline-offset: -1px;
    }
    .rank-tile__current {
      position: absolute;
      top: 16px;
      right: 16px;
      font-family: "Inter", sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: #fff;
      background: #B99253;
      padding: 4px 10px;
      border-radius: 2px;
    }
    .rank-tile__head {
      --rank-color: #B99253;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(26, 26, 26, 0.08);
    }
    .rank-tile__name {
      display: block;
      font-family: "Noto Serif JP", serif;
      font-weight: 600;
      font-size: clamp(24px, 3vw, 30px);
      color: var(--rank-color);
      letter-spacing: 0.04em;
    }
    .rank-tile__threshold {
      display: block;
      font-family: "Inter", "Noto Sans JP", sans-serif;
      font-feature-settings: "tnum";
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      color: #1A1A1A;
      opacity: 0.65;
      margin-top: 8px;
    }
    .rank-tile__benefits {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .rank-tile__benefits li {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 13.5px;
      line-height: 1.7;
      color: #1A1A1A;
      opacity: 0.85;
      padding-left: 16px;
      position: relative;
    }
    .rank-tile__benefits li::before {
      content: "・";
      position: absolute;
      left: 0;
      color: #B99253;
    }
    .rank-tile__note {
      font-family: "Noto Serif JP", serif;
      font-style: italic;
      font-size: 0.84rem;
      line-height: 1.8;
      color: #1A1A1A;
      opacity: 0.75;
      margin: auto 0 0;
      padding-top: 16px;
      border-top: 1px solid rgba(26, 26, 26, 0.06);
    }
    @media (max-width: 880px) {
      .ranks-grid { grid-template-columns: 1fr; }
    }

    /* 履歴 */
    .history-section {
      padding: clamp(56px, 8vw, 96px) 0;
      background: #fff;
    }
    .history-list {
      display: grid;
      gap: 18px;
      max-width: 880px;
      margin: 0 auto;
    }
    .history-card {
      background: #F6F3EC;
      border-radius: 3px;
      padding: clamp(20px, 3vw, 28px);
    }
    .history-card__head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(26, 26, 26, 0.1);
      margin-bottom: 14px;
    }
    .history-card__date {
