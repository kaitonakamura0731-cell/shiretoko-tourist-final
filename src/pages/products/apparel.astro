---
// アパレル一覧 v3 — 動くファセット絞り込み + レスポンシブ
// データソース: assets/ec-crawl/products-raw.json → catalog.ts (apparelItems.length で動的表示)
import "../../styles/global.css";
import { apparelItems } from "../../data/catalog";
import { variantGroups, slugToGroup } from "../../data/variantGroups";

const meta = {
  title: "アウトドアアパレル一覧｜北の逸品堂 (知床ツーリスト)",
  description: `Patagonia 中心のアウトドアアパレル${apparelItems.length}商品をブランド/カテゴリ/サイズ/状態で絞り込み。店主が知床ガイドで現場使いするウェア。`,
};

// ファセット件数を集計
function countBy(items, key) {
  const m = new Map();
  for (const i of items) {
    const v = i[key];
    if (v) m.set(v, (m.get(v) || 0) + 1);
  }
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
}

const brands = countBy(apparelItems, "brand");
const cats = countBy(apparelItems, "apparelCategory");
const conditions = countBy(apparelItems, "condition");
const sizes = countBy(apparelItems, "size");
const colors = countBy(apparelItems, "color");

// マーケットプレイス由来タイトルの「■」を表示時に除去 (データは変更しない)
const cleanTitle = (t) => t.replace(/■/g, " ").replace(/\s+/g, " ").trim();
const groupByKey = new Map(variantGroups.map((g) => [g.key, g]));

// 画像なしの商品は一旦非表示。サイズ違いのバリエーショングループは代表(最安)1枚へ集約。
const rawItems = apparelItems.filter((p) => p.image);
// 表示順の安定: サイズの並びを正規化 (XXS→XS→S→M→L→XL)
const SIZE_ORDER = ["XXS", "XS", "S", "M", "L", "XL", "XXL"];
const sizeRank = (s) => { const i = SIZE_ORDER.indexOf((s || "").toUpperCase()); return i === -1 ? 99 : i; };
const seenGroup = new Set();
const items = [];
for (const p of rawItems) {
  const groupKey = slugToGroup[p.slug];
  const group = groupKey ? groupByKey.get(groupKey) : null;
  if (group) {
    if (seenGroup.has(groupKey)) continue;
    seenGroup.add(groupKey);
    const byPrice = [...group.variants].sort((a, b) => a.price - b.price);
    const rep = byPrice[0];
    const repItem = rawItems.find((x) => x.slug === rep.slug) || p;
    // 表示用バッジは variantGroups のサイズ (XXS/XS/S...)
    const sizes = [...new Set(group.variants.map((v) => v.size).filter(Boolean))].sort((a, b) => sizeRank(a) - sizeRank(b));
    // 絞り込み用は catalog 側のサイズ表記 (XXS→XX 等のズレを吸収) を全バリエーション分集約
    const facetSizes = [...new Set(
      group.variants
        .map((v) => (rawItems.find((x) => x.slug === v.slug) || {}).size)
        .filter(Boolean)
    )];
    const prices = group.variants.map((v) => v.price);
    const minPrice = Math.min(...prices);
    const maxPrice = Math.max(...prices);
    items.push({
      ...repItem,
      price: minPrice,
      variantCount: group.variants.length,
      variantLabel: sizes.length ? `サイズ: ${sizes.join(" / ")}` : "",
      variantSizes: facetSizes.join(","),
      priceVaries: maxPrice !== minPrice,
    });
  } else {
    items.push(p);
  }
}
const totalSkuCount = rawItems.length;
const cardCount = items.length;
const yen = (n) => "¥" + Number(n).toLocaleString("ja-JP");
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
<script src="/cart.js" is:inline></script>
</head>
<body class="page-listing page-apparel">

<div class="topbar">店主厳選パタゴニア / R1 シリーズ入荷中 ・ サイズ相談は<a href="https://line.me/R/ti/p/@kitanoippindo" target="_blank" rel="noopener noreferrer">LINE</a>で 1:1 対応</div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark">北の逸品堂</span>
      <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
    </a>
    <nav class="gnav" aria-label="主要メニュー">
      <a href="/shop">SHOP</a>
      <a href="/products/specialty/">産直</a>
      <a href="/products/apparel/" class="is-tour" aria-current="page">アパレル</a>
      <a href="/bundles/">セット</a>
      <a href="/stories/">ストーリー</a>
      <a href="/ranking/">ランキング</a>
    </nav>
    <div class="header-utility">
      <a href="/account/" class="utility-link">会員ページ</a>
      <a href="/cart" class="utility-cart" data-cart-link>カート</a>
      <details class="mobile-nav">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <ul>
          <li><a href="/shop">SHOP</a></li>
          <li><a href="/products/specialty/">産直</a></li>
          <li><a href="/products/apparel/">アパレル</a></li>
          <li><a href="/bundles/">セット</a></li>
          <li><a href="/stories/">ストーリー</a></li>
          <li><a href="/ranking/">ランキング</a></li>
          <li><a href="/gift/">ギフト</a></li>
          <li><a href="/account/">会員ページ</a></li>
          <li><a href="/cart">カート</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<section class="listing-hero">
  <div class="listing-hero__inner">
    <span class="eyebrow">APPAREL ・ アパレル入口</span>
    <h1 class="mincho">店主が現場で<br />使うアウトドアウェア。</h1>
    <p>
      Patagonia 中心の {totalSkuCount} 商品（{cardCount}型）を、ブランド・カテゴリ・サイズ・状態で絞り込めます。
      「ベストの M サイズが欲しい」を 3 クリックで。
      サイズや状態のご相談は LINE 1:1 で承ります。
    </p>
  </div>
</section>

<button class="filter-toggle" type="button" data-toggle-filters aria-expanded="false">
  <span class="filter-toggle__icon" aria-hidden="true"></span>
  絞り込み・並べ替え
  <span class="filter-toggle__count" data-active-count>0</span>
</button>

<section class="listing">
  <div class="listing__inner">
    <div class="listing__layout">

      <aside class="filters" data-filters>
        <div class="filters__head">
          <h3>絞り込み</h3>
          <button type="button" class="filters__close" data-close-filters aria-label="閉じる">✕</button>
        </div>

        <button type="button" class="filters__reset" data-reset-filters>すべて解除</button>

        <details class="filter-group" open>
          <summary>ブランド</summary>
          <ul>
            {brands.map(([v, c]) => (
              <li><label><input type="checkbox" data-facet="brand" value={v} /><span>{v}</span><b>{c}</b></label></li>
            ))}
          </ul>
        </details>

        <details class="filter-group" open>
          <summary>カテゴリ</summary>
          <ul>
            {cats.map(([v, c]) => (
              <li><label><input type="checkbox" data-facet="apparelcategory" value={v} /><span>{v}</span><b>{c}</b></label></li>
            ))}
          </ul>
        </details>

        {sizes.length > 0 && (
          <details class="filter-group">
            <summary>サイズ</summary>
            <ul class="filter-chips">
              {sizes.map(([v, c]) => (
                <li><label><input type="checkbox" data-facet="size" value={v} /><span>{v}</span><b>{c}</b></label></li>
              ))}
            </ul>
          </details>
        )}

        <details class="filter-group">
          <summary>状態</summary>
          <ul>
            {conditions.map(([v, c]) => (
              <li><label><input type="checkbox" data-facet="condition" value={v} /><span>{v}</span><b>{c}</b></label></li>
            ))}
          </ul>
        </details>

        {colors.length > 0 && (
          <details class="filter-group">
            <summary>カラー</summary>
            <ul>
              {colors.map(([v, c]) => (
                <li><label><input type="checkbox" data-facet="color" value={v} /><span>{v}</span><b>{c}</b></label></li>
              ))}
            </ul>
          </details>
        )}
      </aside>

      <div class="listing-results">
        <div class="listing-bar">
          <div class="listing-count">
            全 <b><span data-total>{cardCount}</span></b> 型
            {cardCount !== totalSkuCount && <span class="listing-count__sku">（{totalSkuCount}商品）</span>}
            <span class="listing-count__filtered" data-filtered-suffix></span>
          </div>
          <div class="listing-sort">
            <label>並べ替え
              <select data-sort>
                <option value="default">標準</option>
                <option value="new">新着順</option>
                <option value="title">名前順</option>
                <option value="price-asc">価格が安い順</option>
                <option value="price-desc">価格が高い順</option>
              </select>
            </label>
          </div>
        </div>

        <div class="card-grid" data-grid>
          {items.map((p) => (
            <article
              class="card-product"
              data-brand={p.brand}
              data-apparelcategory={p.apparelCategory}
              data-size={p.size || ""}
              data-sizes={p.variantSizes || ""}
              data-condition={p.condition}
              data-color={p.color || ""}
              data-price={p.price ?? ""}
              data-id={p.id}
            >
              <a href={`/products/${p.slug}/`} class="card-product__link">
                <div class="card-product__media">
                  {p.image ? (
                    <img src={p.image} alt={cleanTitle(p.title)} loading="lazy" decoding="async" />
                  ) : (
                    <div class="card-product__placeholder" aria-hidden="true">no image</div>
                  )}
                </div>
                <div class="card-product__body">
                  <div class="card-product__tags">
                    {p.brand && <span class="tag tag--brand">{p.brand}</span>}
                    {p.condition && <span class={`tag tag--${p.condition === '新品' ? 'new' : 'used'}`}>{p.condition}</span>}
                    {!p.variantCount && p.size && <span class="tag">{p.size}</span>}
                  </div>
                  <h4 class="card-product__title">{cleanTitle(p.title)}</h4>
                  {p.variantCount && p.variantLabel && (
                    <div class="card-product__variants">{p.variantLabel}</div>
                  )}
                  <div class="card-product__meta">
                    {p.price != null ? (
                      <span class="card-product__price">{yen(p.price)}{p.variantCount && p.priceVaries ? "〜" : ""}</span>
                    ) : (
                      <span>{p.apparelCategory || ''}</span>
                    )}
                    <span class="ask-cta">価格・在庫を見る →</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        <div class="listing-empty" data-empty hidden>
          <p>条件に合う商品が見つかりませんでした。</p>
          <button type="button" data-reset-filters>絞り込みを解除する</button>
        </div>
      </div>

    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__legal">
      <span>(c) 1992-2026 株式会社 知床ツーリスト. All rights reserved.</span>
      <span class="payments">クレジットカード / コード決済 / 銀行振込</span>
    </div>
  </div>
</footer>

<script is:inline>
(() => {
  const facetState = {}; // {brand: Set<string>, ...}
  const cards = Array.from(document.querySelectorAll('[data-grid] .card-product'));
  const sortSel = document.querySelector('[data-sort]');
  const filteredSuffix = document.querySelector('[data-filtered-suffix]');
  const emptyEl = document.querySelector('[data-empty]');
  const activeCountEl = document.querySelector('[data-active-count]');
  const gridEl = document.querySelector('[data-grid]');

  function activeFacetCount() {
    return Object.values(facetState).reduce((sum, set) => sum + set.size, 0);
  }

  function apply() {
    let visible = 0;
    cards.forEach((c) => {
      let ok = true;
      for (const [k, set] of Object.entries(facetState)) {
        if (set.size === 0) continue;
        // バリエーション集約カードは複数サイズ(data-sizes)を持つ — いずれか一致でOK
        const multi = (k === 'size' && c.dataset.sizes) ? c.dataset.sizes.split(',') : null;
        if (multi) {
          if (!multi.some((v) => set.has(v))) { ok = false; break; }
        } else {
          const cardVal = c.dataset[k] || '';
          if (!set.has(cardVal)) { ok = false; break; }
        }
      }
      c.hidden = !ok;
      if (ok) visible++;
    });
    const total = cards.length;
    filteredSuffix.textContent = visible === total ? '' : ` ・ 絞り込み中 ${visible}件`;
    emptyEl.hidden = visible !== 0;
    gridEl.hidden = visible === 0;
    const af = activeFacetCount();
    activeCountEl.textContent = af;
    activeCountEl.hidden = af === 0;
  }

  document.querySelectorAll('input[type="checkbox"][data-facet]').forEach((cb) => {
    cb.addEventListener('change', () => {
      const k = cb.dataset.facet;
      facetState[k] = facetState[k] || new Set();
      if (cb.checked) facetState[k].add(cb.value);
      else facetState[k].delete(cb.value);
      apply();
    });
  });

  document.querySelectorAll('[data-reset-filters]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('input[type="checkbox"][data-facet]').forEach((cb) => { cb.checked = false; });
      for (const k of Object.keys(facetState)) facetState[k].clear();
      apply();
    });
  });

  if (sortSel) {
    sortSel.addEventListener('change', () => {
      const mode = sortSel.value;
      const priceOf = (c) => { const n = Number(c.dataset.price); return Number.isFinite(n) ? n : Infinity; };
      const sorted = [...cards];
      if (mode === 'title') sorted.sort((a, b) => (a.querySelector('.card-product__title').textContent || '').localeCompare(b.querySelector('.card-product__title').textContent || ''));
      else if (mode === 'new') sorted.sort((a, b) => Number(b.dataset.id) - Number(a.dataset.id));
      else if (mode === 'price-asc') sorted.sort((a, b) => priceOf(a) - priceOf(b));
      else if (mode === 'price-desc') sorted.sort((a, b) => priceOf(b) - priceOf(a));
      else sorted.sort((a, b) => cards.indexOf(a) - cards.indexOf(b));
      sorted.forEach((c) => gridEl.appendChild(c));
    });
  }

  // Mobile filter drawer
  const toggle = document.querySelector('[data-toggle-filters]');
  const filtersEl = document.querySelector('[data-filters]');
  const closeBtn = document.querySelector('[data-close-filters]');
  if (toggle && filtersEl) {
    toggle.addEventListener('click', () => {
      const open = filtersEl.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.classList.toggle('lock-scroll', open);
    });
  }
  if (closeBtn && filtersEl) {
    closeBtn.addEventListener('click', () => {
      filtersEl.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('lock-scroll');
    });
  }

  apply();
})();
</script>
</body>
</html>
