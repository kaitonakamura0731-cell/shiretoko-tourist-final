---
// 産直一覧ページ — 新方針: 産直入口
// 季節 / 配送温度 / 内容量 / ギフト対応のファセット表示。商談で確認した新方針を反映。
import "../../styles/global.css";
import { products, formatYen } from "../../data/products";
import { productImageForKey } from "../../data/sourceImages";

const meta = {
  title: "産直食材一覧｜北の逸品堂(知床ツーリスト)",
  description: "北海道・知床から、店主厳選の産直食材。アスパラ・じゃがいも・玉ねぎ・季節食材・ギフト。朝採り収穫日と産地を明記。",
};

const items = products
  .filter((p) => p.category === "specialty")
  .map((p) => ({ ...p, image: productImageForKey(p.imageKey, p.title), priceLabel: formatYen(p.price) }));
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
<script src="/cart.js" is:inline></script>
</head>
<body>
<div class="topbar">6月限定 / アスパラ・じゃがいも・玉ねぎを北海道から直送中 ・ ¥5,000以上で<b>送料無料</b></div>
<header class="site-header"><div class="site-header__inner">
  <a href="/" class="brand"><span class="brand__mark">北の逸品堂</span><span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span></a>
  <nav class="gnav" aria-label="主要メニュー">
    <a href="/products/specialty/" class="is-tour">産直</a>
    <a href="/products/apparel/">アパレル</a>
    <a href="/#tour">ツアー</a>
    <a href="/#story">ストーリー</a>
  </nav>
  <div class="header-utility"><a href="/cart" class="utility-cart" data-cart-link>カート (0)</a></div>
</div></header>

<main>
<section class="listing">
  <div class="listing__inner">
    <div class="listing__head">
      <div>
        <span class="section-eyebrow">SPECIALTY 産直入口</span>
        <h1>北海道・知床の産直食材</h1>
        <p class="listing__lead">朝採り収穫日・産地・生産者を明記した産地直送便。同じ店主・同じ目利きが選ぶ、季節と産地が分かる食材を並べています。LINE登録で再入荷・収穫速報を週1配信。</p>
      </div>
      <div class="listing__count">全 {items.length} 商品 / 公開84商品予定</div>
    </div>
    <div class="listing__layout">
      <aside class="listing-side">
        <h3>絞り込み</h3>
        <div class="facet"><h4>カテゴリ</h4><ul>
          <li class="active">すべて<small>({items.length})</small></li>
          <li>アスパラガス</li><li>じゃがいも</li><li>玉ねぎ</li>
          <li>季節食材</li><li>ギフト・のし</li>
        </ul></div>
        <div class="facet"><h4>季節</h4><ul>
          <li>春 (4-5月)</li><li class="active">夏 (6-8月) NOW</li>
          <li>秋 (9-11月)</li><li>冬 (12-3月)</li>
        </ul></div>
        <div class="facet"><h4>配送温度</h4><ul>
          <li>冷蔵便</li><li>冷凍便</li><li>常温便</li>
        </ul></div>
        <div class="facet"><h4>内容量</h4><ul>
          <li>1kg 以下</li><li>1-5kg</li><li>5-10kg</li><li>10kg 以上</li>
        </ul></div>
        <div class="facet"><h4>対応</h4><ul>
          <li>ギフト・のし対応</li><li>在庫あり</li><li>予約販売</li>
        </ul></div>
      </aside>
      <div class="listing-grid">
        {items.map((p) => (
          <a href={`/products/${p.slug}`} class="listing-card">
            <div class="listing-card__img">
              {p.image.src ? <img src={p.image.src} alt={p.image.alt} loading="lazy" decoding="async" /> : null}
            </div>
            <div class="listing-card__body">
              <span class="listing-card__tag">{p.origin}</span>
              <p class="listing-card__title">{p.title}</p>
              <span class="listing-card__price">{p.priceLabel}<small>{p.priceUnit}</small></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
</main>

<footer class="site-footer"><div class="site-footer__inner">
  <div class="site-footer__legal">
    <span>(c) 1992-2026 株式会社 知床ツーリスト. All rights reserved.</span>
    <span class="payments">クレジットカード / コード決済 / 銀行振込</span>
  </div>
</div></footer>
</body>
</html>
