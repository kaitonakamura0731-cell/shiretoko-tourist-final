---
// 産直一覧 v3 — 動くファセット + レスポンシブ
import "../../styles/global.css";
import { specialtyItems } from "../../data/catalog";

const meta = {
  title: "産直食材一覧｜北の逸品堂 (知床ツーリスト)",
  description: "北海道・知床から、店主厳選の産直食材。アスパラ・じゃがいも・玉ねぎ・季節食材・ギフト。朝採り収穫日と産地を明記。",
};

function countBy(items, key) {
  const m = new Map();
  for (const i of items) {
    const v = i[key];
    if (v) m.set(v, (m.get(v) || 0) + 1);
  }
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
}

const cats = countBy(specialtyItems, "specialtyCategory");
const weights = countBy(specialtyItems, "weight");
// 画像なしの商品は一旦非表示
const items = specialtyItems.filter((p) => p.image);
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
<script src="/cart.js" is:inline></script>
</head>
<body class="page-listing">

<div class="topbar">6月限定 / アスパラ・じゃがいも・玉ねぎを北海道から直送中 ・ ¥5,000以上で<b>送料無料</b></div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark">北の逸品堂</span>
      <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
    </a>
    <nav class="gnav" aria-label="主要メニュー">
      <a href="/products/specialty/" class="is-tour">産直</a>
      <a href="/products/apparel/">アパレル</a>
      <a href="/bundles/">セット</a>
      <a href="/stories/">ストーリー</a>
      <a href="/ranking/">ランキング</a>
    </nav>
    <div class="header-utility">
      <a href="/account/" class="utility-link">マイページ</a>
      <a href="/cart" class="utility-cart" data-cart-link>カート (0)</a>
      <details class="mobile-nav">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <ul>
          <li><a href="/products/specialty/">産直</a></li>
          <li><a href="/products/apparel/">アパレル</a></li>
          <li><a href="/bundles/">セット</a></li>
          <li><a href="/stories/">ストーリー</a></li>
          <li><a href="/ranking/">ランキング</a></li>
          <li><a href="/gift/">ギフト</a></li>
          <li><a href="/account/">マイページ</a></li>
          <li><a href="/cart">カート</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<section class="listing-hero">
  <div class="listing-hero__inner">
    <span class="eyebrow">SPECIALTY ・ 産直入口</span>
    <h1 class="mincho">朝採りを、<br />中1日で食卓へ。</h1>
    <p>
      北海道・知床/オホーツク/清里町の畑から、店主厳選で {items.length} 商品。
      収穫日・産地・生産者を明記。LINE登録で再入荷・収穫速報を週1配信します。
    </p>
  </div>
</section>

<button class="filter-toggle" type="button" data-toggle-filters aria-expanded="false">
  <span class="filter-toggle__icon" aria-hidden="true"></span>
  絞り込み
  <span class="filter-toggle__count" data-active-count>0</span>
</button>

<section class="listing">
  <div class="listing__inner">
    <div class="listing__layout">

      <aside class="filters" data-filters>
        <div class="filters__head">
          <h3>絞り込み</h3>
          <button type="button" class="filters__close" data-close-filters aria-label="閉じる">✕</button>
        </div>

        <button type="button" class="filters__reset" data-reset-filters>すべて解除</button>

        <details class="filter-group" open>
          <summary>カテゴリ</summary>
          <ul>
            {cats.map(([v, c]) => (
              <li><label><input type="checkbox" data-facet="specialtycategory" value={v} /><span>{v}</span><b>{c}</b></label></li>
            ))}
          </ul>
        </details>

        {weights.length > 0 && (
          <details class="filter-group" open>
            <summary>内容量</summary>
            <ul>
              {weights.map(([v, c]) => (
                <li><label><input type="checkbox" data-facet="weight" value={v} /><span>{v}</span><b>{c}</b></label></li>
              ))}
            </ul>
          </details>
        )}

        <details class="filter-group">
          <summary>季節 (準備中)</summary>
          <ul>
            <li><label><input type="checkbox" disabled /><span>春 (4-5月)</span></label></li>
            <li><label><input type="checkbox" disabled /><span>夏 (6-8月)</span></label></li>
            <li><label><input type="checkbox" disabled /><span>秋 (9-11月)</span></label></li>
            <li><label><input type="checkbox" disabled /><span>冬 (12-3月)</span></label></li>
          </ul>
        </details>

        <details class="filter-group">
          <summary>対応 (準備中)</summary>
          <ul>
            <li><label><input type="checkbox" disabled /><span>ギフト・のし</span></label></li>
            <li><label><input type="checkbox" disabled /><span>冷蔵便</span></label></li>
            <li><label><input type="checkbox" disabled /><span>予約販売</span></label></li>
          </ul>
        </details>
      </aside>

      <div class="listing-results">
        <div class="listing-bar">
          <div class="listing-count">
            全 <b><span data-total>{items.length}</span></b> 商品
            <span class="listing-count__filtered" data-filtered-suffix></span>
          </div>
          <div class="listing-sort">
            <label>並べ替え
              <select data-sort>
                <option value="default">標準</option>
                <option value="new">新着順</option>
                <option value="title">名前順</option>
              </select>
            </label>
          </div>
        </div>

        <div class="card-grid" data-grid>
          {items.map((p) => (
            <article
              class="card-product"
              data-specialtycategory={p.specialtyCategory}
              data-weight={p.weight || ""}
              data-id={p.id}
            >
              <a href={p.url} target="_blank" rel="noopener" class="card-product__link">
                <div class="card-product__media">
                  {p.image ? (
                    <img src={p.image} alt={p.title} loading="lazy" decoding="async" />
                  ) : (
                    <div class="card-product__placeholder" aria-hidden="true">no image</div>
                  )}
                </div>
                <div class="card-product__body">
                  <div class="card-product__tags">
                    {p.specialtyCategory && <span class="tag tag--brand">{p.specialtyCategory}</span>}
                    {p.weight && <span class="tag">{p.weight}</span>}
                  </div>
                  <h4 class="card-product__title">{p.title}</h4>
                  <div class="card-product__meta">
                    <span>北海道産直</span>
                    <span class="ask-cta">価格・在庫を見る →</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        <div class="listing-empty" data-empty hidden>
          <p>条件に合う商品が見つかりませんでした。</p>
          <button type="button" data-reset-filters>絞り込みを解除する</button>
        </div>
      </div>

    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__legal">
      <span>(c) 1992-2026 株式会社 知床ツーリスト. All rights reserved.</span>
      <span class="payments">クレジットカード / コード決済 / 銀行振込</span>
    </div>
  </div>
</footer>

<script is:inline>
(() => {
  const facetState = {};
  const cards = Array.from(document.querySelectorAll('[data-grid] .card-product'));
  const sortSel = document.querySelector('[data-sort]');
  const filteredSuffix = document.querySelector('[data-filtered-suffix]');
  const emptyEl = document.querySelector('[data-empty]');
  const activeCountEl = document.querySelector('[data-active-count]');
  const gridEl = document.querySelector('[data-grid]');

  function activeFacetCount() {
    return Object.values(facetState).reduce((sum, set) => sum + set.size, 0);
  }
  function apply() {
    let visible = 0;
    cards.forEach((c) => {
      let ok = true;
      for (const [k, set] of Object.entries(facetState)) {
        if (set.size === 0) continue;
        const cardVal = c.dataset[k] || '';
        if (!set.has(cardVal)) { ok = false; break; }
      }
      c.hidden = !ok;
      if (ok) visible++;
    });
    const total = cards.length;
    filteredSuffix.textContent = visible === total ? '' : ` ・ 絞り込み中 ${visible}件`;
    emptyEl.hidden = visible !== 0;
    gridEl.hidden = visible === 0;
    const af = activeFacetCount();
    activeCountEl.textContent = af;
    activeCountEl.hidden = af === 0;
  }
  document.querySelectorAll('input[type="checkbox"][data-facet]').forEach((cb) => {
    cb.addEventListener('change', () => {
      const k = cb.dataset.facet;
      facetState[k] = facetState[k] || new Set();
      if (cb.checked) facetState[k].add(cb.value);
      else facetState[k].delete(cb.value);
      apply();
    });
  });
  document.querySelectorAll('[data-reset-filters]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('input[type="checkbox"][data-facet]').forEach((cb) => { cb.checked = false; });
      for (const k of Object.keys(facetState)) facetState[k].clear();
      apply();
    });
  });
  if (sortSel) {
    sortSel.addEventListener('change', () => {
      const mode = sortSel.value;
      const sorted = [...cards];
      if (mode === 'title') sorted.sort((a, b) => (a.querySelector('.card-product__title').textContent || '').localeCompare(b.querySelector('.card-product__title').textContent || ''));
      else if (mode === 'new') sorted.sort((a, b) => Number(b.dataset.id) - Number(a.dataset.id));
      else sorted.sort((a, b) => cards.indexOf(a) - cards.indexOf(b));
      sorted.forEach((c) => gridEl.appendChild(c));
    });
  }
  const toggle = document.querySelector('[data-toggle-filters]');
  const filtersEl = document.querySelector('[data-filters]');
  const closeBtn = document.querySelector('[data-close-filters]');
  if (toggle && filtersEl) {
    toggle.addEventListener('click', () => {
      const open = filtersEl.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.classList.toggle('lock-scroll', open);
    });
  }
  if (closeBtn && filtersEl) {
    closeBtn.addEventListener('click', () => {
      filtersEl.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('lock-scroll');
    });
  }
  apply();
})();
</script>
</body>
</html>
