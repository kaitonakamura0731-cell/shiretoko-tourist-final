---
import Base from "../../layouts/Base.astro";
import { products, findProduct, formatYen, type Product } from "../../data/products";
import { catalog, type CatalogItem } from "../../data/catalog";
import { productImageForKey } from "../../data/sourceImages";
import { reviewsByProduct, averageRating } from "../../data/reviews";
import {
  subscriptions,
  volumeLadder,
  crossSell,
  thresholdGift,
  pointsInfo,
  deliveryEstimate,
  restockInfo,
} from "../../data/promotions";

export function getStaticPaths() {
  const productSlugs = new Set(products.map((p) => p.slug));
  const richPaths = products.map((p) => ({
    params: { slug: p.slug },
    props: { kind: 'rich' as const, product: p },
  }));
  const litePaths = catalog
    .filter((c) => !productSlugs.has(c.slug))
    .map((c) => ({
      params: { slug: c.slug },
      props: { kind: 'catalog' as const, item: c },
    }));
  return [...richPaths, ...litePaths];
}

type Props =
  | { kind: 'rich'; product: Product }
  | { kind: 'catalog'; item: CatalogItem };

const rawProps = Astro.props;
const isRich = rawProps.kind === 'rich';
const product = isRich ? rawProps.product : null;
const catalogItem = !isRich ? rawProps.item : null;

// ── rich ブランチ専用の変数 (kind==='catalog' のとき null) ──
const relatedProducts = product
  ? product.related.map((slug) => findProduct(slug)).filter((p): p is Product => !!p)
  : [];
const productImage = product
  ? productImageForKey(product.imageKey, product.title)
  : { src: null, alt: '', stem: '', label: '' };
const relatedProductCards = relatedProducts.slice(0, 3).map((item) => ({
  item,
  image: productImageForKey(item.imageKey, item.title),
}));

const categoryLabel = (product?.category ?? catalogItem?.category) === 'specialty' ? '産直' : 'アパレル';
const categoryHref = '/products/' + ((product?.category ?? catalogItem?.category) === 'specialty' ? 'specialty' : 'apparel') + '/';

// サムネ用
const thumbs = product ? [productImage, productImage, productImage, productImage] : [];

// レビュー集計 (共通)
const slugForReview = product?.slug ?? catalogItem?.slug ?? '';
const productReviews = reviewsByProduct(slugForReview);
const reviewCount = productReviews.length;
const avgRaw = averageRating(slugForReview);
const avgRating = Math.round(avgRaw * 10) / 10;
const ratingBuckets = [5, 4, 3, 2, 1].map((star) => {
  const count = productReviews.filter((r) => r.rating === star).length;
  const pct = reviewCount > 0 ? Math.round((count / reviewCount) * 100) : 0;
  return { star, count, pct };
});
const sortedReviews = [...productReviews].sort((a, b) => b.postedAt.localeCompare(a.postedAt));
const initialShownCount = Math.min(3, sortedReviews.length);
function starString(n: number): string {
  return '★★★★★☆☆☆☆☆'.slice(5 - n, 10 - n);
}
function formatJaDate(d: string): string {
  const [y, m, day] = d.split('-');
  return `${y}.${m}.${day}`;
}

// ── rich ブランチ専用の施策変数 ──
const isApparel = (product?.category ?? catalogItem?.category) === 'apparel';
const leadDays = isApparel ? 4 : 3;
const eta = new Date();
eta.setDate(eta.getDate() + leadDays);
const etaLabel = `${eta.getMonth() + 1}月${eta.getDate()}日頃`;
const subPlan = product ? subscriptions.find((s) => s.slug === product.slug) : null;
const ladderSteps = product ? volumeLadder.filter((v) => v.slug === product.slug) : [];
const hasLadder = ladderSteps.length > 1;
const ladderBest = hasLadder ? ladderSteps.reduce((a, b) => (b.perKg < a.perKg ? b : a)) : null;
const crossEntry = product ? crossSell.find((c) => c.slug === product.slug) : null;
const crossItems = (crossEntry?.recommends ?? [])
  .map((slug) => findProduct(slug))
  .filter((p): p is Product => !!p)
  .slice(0, 3)
  .map((item) => ({ item, image: productImageForKey(item.imageKey, item.title) }));
const giftThresholdMet = (product?.price ?? 0) >= thresholdGift.threshold;
const restockTarget = product ? restockInfo.targets.find((t) => t.slug === product.slug) : null;
const earnedPoints = Math.floor((product?.price ?? 0) * pointsInfo.rateValue);
---

<Base
  title={`${isRich ? product!.title : catalogItem!.title}｜北の逸品堂`}
  description={isRich ? product!.summary : `${catalogItem!.brand ?? ''}${catalogItem!.apparelCategory ?? catalogItem!.specialtyCategory ?? ''} ${catalogItem!.title}`}
  bodyClass={`product-page${isRich ? ' product-page--rich' : ' product-page--lite'}`}
>
  <main>
    {isRich ? (
      <>
        {/* ── rich ブランチ: products.ts 6件の既存フルUI ── */}

        <nav class="breadcrumbs" aria-label="パンくず">
          <div class="breadcrumbs__inner">
            <a href="/">TOP</a>
            <span class="sep">/</span>
            <a href={categoryHref}>{categoryLabel}</a>
            <span class="sep">/</span>
            <span class="current" aria-current="page">{product!.title}</span>
          </div>
        </nav>

        <section class="pdp">
          <div class="pdp__inner">
            <div class="pdp__gallery">
              <div class="pdp-main" data-image-key={product!.imageKey}>
                {productImage.src ? (
                  <img src={productImage.src} alt={productImage.alt} decoding="async" />
                ) : (
                  <div class="source-placeholder source-placeholder--product" role="img" aria-label={`${product!.title}の画像枠`}>
                    <span>{productImage.label}</span>
                    <small>画像を追加</small>
                  </div>
                )}
              </div>
              <div class="pdp-thumbs" role="list">
                {thumbs.map((t, i) => (
                  <button type="button" class={`pdp-thumb${i === 0 ? ' is-active' : ''}`} aria-label={`サムネイル ${i + 1}`} data-thumb-index={i}>
                    {t.src ? (
                      <img src={t.src} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="pdp-thumb__ph">{t.label}</span>
                    )}
                  </button>
                ))}
              </div>
            </div>

            <div class="pdp__info">
              <div class="pdp-tags">
                <span class={`pdp-tag pdp-tag--${product!.badge.toLowerCase()}`}>{product!.badge}</span>
                <span class="pdp-tag pdp-tag--origin">{product!.origin}</span>
              </div>

              <h1 class="pdp-title">{product!.title}</h1>
              <p class="pdp-summary">{product!.summary}</p>

              <div class="pdp-price">
                <span class="pdp-price__num">{formatYen(product!.price)}</span>
                <span class="pdp-price__unit">{product!.priceUnit}</span>
                <span class="pdp-points">この商品で <b>{earnedPoints}</b> ポイント（{pointsInfo.rate}）</span>
              </div>

              <p class="pdp-delivery">
                <span class="pdp-delivery__icon" aria-hidden="true">▸</span>
                今ご注文で <b>{etaLabel}</b> お届け予定
                <small>{deliveryEstimate.cutoffNote}</small>
              </p>

              <dl class="pdp-meta">
                <div class="pdp-meta__row">
                  <dt>在庫</dt>
                  <dd>{product!.stockLabel}</dd>
                </div>
                <div class="pdp-meta__row">
                  <dt>配送</dt>
                  <dd>{product!.delivery}</dd>
                </div>
                {product!.harvestDate && (
                  <div class="pdp-meta__row">
                    <dt>収穫</dt>
                    <dd>{product!.harvestDate}</dd>
                  </div>
                )}
              </dl>

              {product!.storyMemo && (
                <aside class="pdp-memo" aria-label="店主のメモ">
                  <span class="pdp-memo__label">店主のメモ</span>
                  <p class="pdp-memo__text">{product!.storyMemo}</p>
                  <span class="pdp-memo__sign">— 北の逸品堂 店主</span>
                </aside>
              )}

              <div class="pdp-purchase">
                <div class="pdp-qty">
                  <label for={`qty-${product!.slug}`}>数量</label>
                  <select id={`qty-${product!.slug}`} class="qty-select" aria-label="購入数量">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                  </select>
                </div>
                <button
                  type="button"
                  class="btn btn--primary btn--block btn--add-cart"
                  data-add-slug={product!.slug}
                  data-add-name={product!.title}
                  data-add-price={String(product!.price)}
                >
                  カゴに追加
                </button>
                <a href="https://line.me/" class="btn btn--outline btn--block" target="_blank" rel="noopener noreferrer">LINE でサイズ・在庫を相談</a>
              </div>

              {subPlan && (
                <div class="pdp-sub">
                  <div class="pdp-sub__head">
                    <span class="pdp-sub__badge">定期便なら {subPlan.discount}</span>
                    <span class="pdp-sub__price">
                      {formatYen(subPlan.subPrice)}
                      <s>{formatYen(subPlan.normalPrice)}</s>
                    </span>
                  </div>
                  <p class="pdp-sub__name">{subPlan.title}・{subPlan.interval}</p>
                  <p class="pdp-sub__note">{subPlan.note}</p>
                  <a href="/products" class="pdp-sub__link">定期便の内容を見る →</a>
                </div>
              )}

              {hasLadder && ladderBest && (
                <div class="pdp-ladder">
                  <p class="pdp-ladder__head">まとめ買いほど <b>1kgあたりがお得</b></p>
                  <ul class="pdp-ladder__list">
                    {ladderSteps.map((step) => (
                      <li class={`pdp-ladder__row${step.popular ? ' is-popular' : ''}`}>
                        <span class="pdp-ladder__weight">{step.weight}{step.popular && <em>人気</em>}</span>
                        <span class="pdp-ladder__price">{formatYen(step.price)}</span>
                        <span class="pdp-ladder__perkg">{formatYen(step.perKg)} / kg</span>
                      </li>
                    ))}
                  </ul>
                  <p class="pdp-ladder__note">最大サイズなら 1kgあたり {formatYen(ladderBest.perKg)} まで下がります。</p>
                </div>
              )}

              {isApparel && (
                <div class="pdp-restock">
                  <a href="https://line.me/" class="btn btn--outline btn--block" target="_blank" rel="noopener noreferrer">
                    再入荷を LINE で知らせる
                  </a>
                  <p class="pdp-restock__note">
                    {restockTarget ? restockTarget.expectedRestock : restockInfo.note}
                  </p>
                </div>
              )}

              <ul class="pdp-notes">
                <li>¥5,000以上で全国送料無料（北海道発・本州中1-2日）</li>
                <li>特産品ご購入で次回ツアー <b>¥1,000 OFF</b> クーポン進呈</li>
                <li>のし・ラッピング・産地証明書PDFはカート画面で選択</li>
                {giftThresholdMet && (
                  <li class="pdp-notes__gift">
                    {thresholdGift.thresholdLabel}のお買い上げで「{thresholdGift.giftName}」を一品添えてお送りします
                  </li>
                )}
              </ul>

              <details class="pdp-spec">
                <summary>商品スペック</summary>
                <table class="spec-table">
                  <tbody>
                    {product!.spec.map(([k, v]) => (
                      <tr>
                        <th>{k}</th>
                        <td>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="pdp-spec__desc">{product!.description}</p>
              </details>
            </div>
          </div>
        </section>

        {(product!.usageScene || product!.careNote) && (
          <section class="pdp-usage">
            <div class="pdp-usage__inner">
              <span class="section-eyebrow">IN THE FIELD</span>
              <h2>現場で使う</h2>
              <hr class="section-rule" />
              <div class="pdp-usage__grid">
                {product!.usageScene && (
                  <div class="pdp-usage__card">
                    <span class="pdp-usage__label">使っている場所</span>
                    <p>{product!.usageScene}</p>
                  </div>
                )}
                {product!.careNote && (
                  <div class="pdp-usage__card">
                    <span class="pdp-usage__label">お手入れ・保存</span>
                    <p>{product!.careNote}</p>
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {product!.environmental && (
          <section class="pdp-env">
            <div class="pdp-env__inner">
              <span class="section-eyebrow">OUR FOOTPRINT</span>
              <h2>長く使うこと、産地を続けること。</h2>
              <hr class="section-rule section-rule--dark" />
              <p class="pdp-env__copy">{product!.environmental}</p>
              <ul class="pdp-env__pillars">
                <li>
                  <span class="pdp-env__pillar-num">01</span>
                  <span class="pdp-env__pillar-text">リペアして長く使う前提。アパレルはほつれ修理、特産品は無選別出荷で廃棄を減らします。</span>
                </li>
                <li>
                  <span class="pdp-env__pillar-num">02</span>
                  <span class="pdp-env__pillar-text">産地と20年単位の取引。地域の畑と農家が続くことが、知床の景観を残す一番の近道です。</span>
                </li>
                <li>
                  <span class="pdp-env__pillar-num">03</span>
                  <span class="pdp-env__pillar-text">EC ⇄ ツアー連動。買って終わりではなく、産地を歩いて確かめてもらう導線を用意しています。</span>
                </li>
              </ul>
            </div>
          </section>
        )}

        {relatedProductCards.length > 0 && (
          <section class="cross-sell">
            <div class="cross-sell__inner">
              <span class="section-eyebrow">RELATED</span>
              <h2>あわせて選ばれています</h2>
              <hr class="section-rule" />
              <div class="cross-grid">
                {relatedProductCards.map(({ item: rp, image }) => (
                  <a href={`/products/${rp.slug}`} class="cross-card">
                    <div class="cross-card__img" data-image-key={rp.imageKey}>
                      {image.src ? (
                        <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                      ) : (
                        <div class="source-placeholder" role="img" aria-label={`${rp.title}の画像枠`}>
                          <span>{image.label}</span>
                          <small>画像を追加</small>
                        </div>
                      )}
                    </div>
                    <div class="cross-card__body">
                      <span class="cross-card__origin">{rp.origin}</span>
                      <p class="cross-card__title">{rp.title}</p>
                      <span class="cross-card__price">{formatYen(rp.price)}<small>{rp.priceUnit}</small></span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        {crossItems.length > 0 && (
          <section class="cross-sell cross-sell--combo">
            <div class="cross-sell__inner">
              <span class="section-eyebrow">FREQUENTLY BOUGHT</span>
              <h2>一緒に買うと便利</h2>
              <hr class="section-rule" />
              <div class="cross-grid">
                {crossItems.map(({ item: cp, image }) => (
                  <a href={`/products/${cp.slug}`} class="cross-card">
                    <div class="cross-card__img" data-image-key={cp.imageKey}>
                      {image.src ? (
                        <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                      ) : (
                        <div class="source-placeholder" role="img" aria-label={`${cp.title}の画像枠`}>
                          <span>{image.label}</span>
                          <small>画像を追加</small>
                        </div>
                      )}
                    </div>
                    <div class="cross-card__body">
                      <span class="cross-card__origin">{cp.origin}</span>
                      <p class="cross-card__title">{cp.title}</p>
                      <span class="cross-card__price">{formatYen(cp.price)}<small>{cp.priceUnit}</small></span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        {product!.relatedTour && (
          <section class="cross-tour">
            <div class="cross-tour__inner">
              <span class="section-eyebrow">EC × TOUR</span>
              <h2>この商品の産地で、店主と歩きませんか。</h2>
              <hr class="section-rule" />
              <p class="cross-tour__lead">
                こちらの商品をご購入のお客様に、関連する知床ガイドツアーを <b>¥1,000 OFF</b> でご案内しています。
                北海道知事登録旅行業 第2-453号、現場ガイド運営。
              </p>
              <div class="cross-tour__card">
                <span class="cross-tour__badge">EC連動特典・¥1,000 OFF</span>
                <h3>{product!.relatedTour.title}</h3>
                <p>世界自然遺産・知床を、現場ガイドが半日でご案内。商品ご購入から90日間有効のクーポンを次回ツアー予約時にお使いいただけます。</p>
                <div class="cross-tour__meta">
                  <span class="price">{product!.relatedTour.price} <small>/ 大人1名（通常）</small></span>
                  <a href="/#tour" class="btn btn--outline btn--on-dark">ツアー詳細を見る</a>
                </div>
              </div>
            </div>
          </section>
        )}
      </>
    ) : (
      <>
        {/* ── catalog lite ブランチ ── */}
        <nav class="breadcrumbs" aria-label="パンくず">
          <div class="breadcrumbs__inner">
            <a href="/">TOP</a>
            <span class="sep">/</span>
            <a href={categoryHref}>{categoryLabel}</a>
            <span class="sep">/</span>
            <span class="current" aria-current="page">{catalogItem!.title}</span>
          </div>
        </nav>

        <section class="pdp">
          <div class="pdp__inner">
            <div class="pdp__gallery">
              <div class="pdp-main">
                {catalogItem!.image ? (
                  <img src={catalogItem!.image} alt={catalogItem!.title} decoding="async" style="width:100%;height:100%;object-fit:cover;" />
                ) : (
                  <div class="source-placeholder source-placeholder--product" role="img" aria-label={`${catalogItem!.title}の画像枠`}>
                    <span>{catalogItem!.brand ?? categoryLabel}</span>
                    <small>画像を追加</small>
                  </div>
                )}
              </div>
            </div>

            <div class="pdp__info">
              <div class="pdp-tags">
                <span class="pdp-tag pdp-tag--now">{categoryLabel}</span>
                {catalogItem!.brand && <span class="pdp-tag pdp-tag--origin">{catalogItem!.brand}</span>}
              </div>

              <h1 class="pdp-title">{catalogItem!.title}</h1>

              <dl class="pdp-spec-dl">
                {catalogItem!.brand && <div class="pdp-spec-dl__row"><dt>ブランド</dt><dd>{catalogItem!.brand}</dd></div>}
                {catalogItem!.apparelCategory && <div class="pdp-spec-dl__row"><dt>カテゴリ</dt><dd>{catalogItem!.apparelCategory}</dd></div>}
                {catalogItem!.specialtyCategory && <div class="pdp-spec-dl__row"><dt>種別</dt><dd>{catalogItem!.specialtyCategory}</dd></div>}
                {catalogItem!.size && <div class="pdp-spec-dl__row"><dt>サイズ</dt><dd>{catalogItem!.size}</dd></div>}
                {catalogItem!.condition && <div class="pdp-spec-dl__row"><dt>状態</dt><dd>{catalogItem!.condition}</dd></div>}
                {catalogItem!.color && <div class="pdp-spec-dl__row"><dt>カラー</dt><dd>{catalogItem!.color}</dd></div>}
                {catalogItem!.weight && <div class="pdp-spec-dl__row"><dt>内容量</dt><dd>{catalogItem!.weight}</dd></div>}
              </dl>

              {catalogItem!.price !== undefined ? (
                <div class="pdp-purchase">
                  <div class="pdp-price">
                    <span class="pdp-price__num">{formatYen(catalogItem!.price)}</span>
                    <span class="pdp-price__unit">税込</span>
                  </div>
                  <div class="pdp-qty">
                    <label for={`qty-${catalogItem!.slug}`}>数量</label>
                    <select id={`qty-${catalogItem!.slug}`} class="qty-select" aria-label="購入数量">
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                    </select>
                  </div>
                  <button
                    type="button"
                    class="btn btn--primary btn--block btn--add-cart"
                    data-add-slug={catalogItem!.slug}
                    data-add-name={catalogItem!.title}
                    data-add-price={String(catalogItem!.price)}
                  >
                    カゴに追加
                  </button>
                </div>
              ) : (
                <div class="pdp-price-on-line">
                  <p class="pdp-price-on-line__msg">価格はLINEで相談</p>
                  <p class="pdp-price-on-line__sub">サイズ・在庫・送料をまとめてご案内します。</p>
                  <a href="https://line.me/" class="btn btn--primary btn--block" target="_blank" rel="noopener noreferrer">
                    LINEで価格を確認する
                  </a>
                </div>
              )}
            </div>
          </div>
        </section>
      </>
    )}

    {/* ── レビューセクション (rich / lite 共通) ── */}
    <section class="pdp-reviews" id="reviews">
      <div class="pdp-reviews__inner">
        <span class="section-eyebrow">REVIEWS</span>
        <h2>お客様の声</h2>
        <hr class="section-rule" />

        <div class="pdp-reviews__summary">
          <div class="pdp-reviews__avg">
            <span class="pdp-reviews__avg-num" id="reviews-avg-num">{reviewCount > 0 ? avgRating.toFixed(1) : '—'}</span>
            <span class="pdp-reviews__avg-stars" id="reviews-avg-stars" aria-label={`平均 ${avgRating} / 5`}>
              {reviewCount > 0 ? starString(Math.round(avgRaw)) : '☆☆☆☆☆'}
            </span>
            <span class="pdp-reviews__avg-count" id="reviews-count">{reviewCount}件のレビュー</span>
          </div>
          <ul class="pdp-reviews__dist">
            {ratingBuckets.map((b) => (
              <li class="pdp-reviews__dist-row">
                <span class="pdp-reviews__dist-label">★{b.star}</span>
                <span class="pdp-reviews__dist-bar"><span class="pdp-reviews__dist-fill" style={`width: ${b.pct}%`} data-star={b.star}></span></span>
                <span class="pdp-reviews__dist-count" data-star-count={b.star}>{b.count}</span>
              </li>
            ))}
          </ul>
        </div>

        <ul class="pdp-reviews__list" id="reviews-list" data-shown={initialShownCount}>
          {sortedReviews.map((r, i) => (
            <li class={`pdp-reviews__card${i >= 3 ? ' is-hidden' : ''}`} data-review-index={i} data-rating={r.rating}>
              <div class="pdp-reviews__head">
                <span class="pdp-reviews__avatar" aria-hidden="true">{r.reviewerInitial}</span>
                <div class="pdp-reviews__id">
                  <span class="pdp-reviews__name">{r.reviewerName} 様</span>
                  <span class="pdp-reviews__meta">
                    <span class="pdp-reviews__stars" aria-label={`評価 ${r.rating} / 5`}>{starString(r.rating)}</span>
                    <span class="pdp-reviews__date">{formatJaDate(r.postedAt)}</span>
                    {r.verified && <span class="pdp-reviews__verified">購入確認済み</span>}
                  </span>
                </div>
              </div>
              <div class="pdp-reviews__body">
                <p class="pdp-reviews__title">{r.title}</p>
                <p class="pdp-reviews__text">{r.body}</p>
              </div>
              <div class="pdp-reviews__foot">
                <span class="pdp-reviews__useful">役に立った {r.useful}</span>
              </div>
              {r.reply && (
                <blockquote class="pdp-reviews__reply">
                  <span class="pdp-reviews__reply-head">
                    <b>{r.reply.from}</b>
                    <span class="pdp-reviews__reply-date">{formatJaDate(r.reply.date)}</span>
                  </span>
                  <p>{r.reply.body}</p>
                </blockquote>
              )}
            </li>
          ))}
        </ul>

        {sortedReviews.length > 3 && (
          <div class="pdp-reviews__more-wrap">
            <button type="button" class="btn btn--outline pdp-reviews__more" data-review-more>
              もっと見る（残り {sortedReviews.length - 3} 件）
            </button>
          </div>
        )}

        {/* 投稿フォーム */}
        <div class="review-form-wrap" id="review-form-wrap">
          <h3 class="review-form__heading">レビューを投稿する</h3>
          <form class="review-form" id="review-form" novalidate>
            <div class="review-form__field">
              <label for="rf-name">お名前 <span aria-hidden="true">*</span></label>
              <input type="text" id="rf-name" name="name" maxlength="20" placeholder="例：田中" required />
            </div>
            <fieldset class="review-form__field review-form__stars-field">
              <legend>評価 <span aria-hidden="true">*</span></legend>
              <div class="review-form__star-row">
                {[5,4,3,2,1].map((n) => (
                  <>
                    <input type="radio" id={`rf-star-${n}`} name="rating" value={String(n)} required />
                    <label for={`rf-star-${n}`} aria-label={`★${n}`}>★</label>
                  </>
                ))}
              </div>
            </fieldset>
            <div class="review-form__field">
              <label for="rf-title">タイトル</label>
              <input type="text" id="rf-title" name="title" maxlength="40" placeholder="例：甘くて驚きました" />
            </div>
            <div class="review-form__field">
              <label for="rf-body">本文 <span aria-hidden="true">*</span></label>
              <textarea id="rf-body" name="body" rows="4" minlength="10" placeholder="10文字以上でご記入ください" required></textarea>
            </div>
            <p class="review-form__notice" role="status" id="review-form-notice" aria-live="polite"></p>
            <button type="submit" class="btn btn--primary review-form__submit" id="review-form-submit">レビューを送信する</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // カート追加
    document.querySelectorAll('.btn--add-cart').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.addSlug;
        const name = btn.dataset.addName;
        const price = parseInt(btn.dataset.addPrice, 10);
        const sel = document.getElementById('qty-' + slug);
        const qty = sel ? parseInt(sel.value, 10) : 1;
        if (window.cart && typeof window.cart.add === 'function') {
          window.cart.add(slug, name, price, qty);
        }
      });
    });

    // サムネ切替
    const thumbEls = document.querySelectorAll('.pdp-thumb');
    thumbEls.forEach((t) => {
      t.addEventListener('click', () => {
        thumbEls.forEach((x) => x.classList.remove('is-active'));
        t.classList.add('is-active');
      });
    });

    // レビュー「もっと見る」
    const moreBtn = document.querySelector('[data-review-more]');
    if (moreBtn) {
      const cards = Array.from(document.querySelectorAll('.pdp-reviews__card'));
      let shown = 3;
      moreBtn.addEventListener('click', () => {
        const next = Math.min(shown + 3, cards.length);
        for (let i = shown; i < next; i++) {
          cards[i].classList.remove('is-hidden');
        }
        shown = next;
        const remaining = cards.length - shown;
        if (remaining <= 0) {
          moreBtn.remove();
        } else {
          moreBtn.textContent = 'もっと見る（残り ' + remaining + ' 件）';
        }
      });
    }
  </script>

  <script is:inline define:vars={{ reviewSlug: slugForReview }}>
    // ── localStorage レビューの読込・投稿 ──
    (function () {
      var STORAGE_KEY = 'hkitchen_reviews_' + reviewSlug;
      var list = document.getElementById('reviews-list');
      var countEl = document.getElementById('reviews-count');
      var avgNumEl = document.getElementById('reviews-avg-num');
      var avgStarsEl = document.getElementById('reviews-avg-stars');
      var formWrap = document.getElementById('review-form-wrap');
      var form = document.getElementById('review-form');
      var notice = document.getElementById('review-form-notice');

      function starStr(n) {
        return '★★★★★☆☆☆☆☆'.slice(5 - n, 10 - n);
      }
      function pad2(n) { return String(n).padStart(2, '0'); }
      function todayStr() {
        var d = new Date();
        return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
      }
      function formatDate(s) {
        var parts = s.split('-');
        return parts[0] + '.' + parts[1] + '.' + parts[2];
      }
      function loadStored() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
        catch (e) { return []; }
      }
      function recalcAvg() {
        if (!countEl || !avgNumEl || !avgStarsEl || !list) return;
        var allCards = list.querySelectorAll('.pdp-reviews__card');
        var total = allCards.length;
        var sum = 0;
        allCards.forEach(function (c) { sum += parseInt(c.dataset.rating || '0', 10); });
        var avg = total > 0 ? (sum / total) : 0;
        countEl.textContent = total + '件のレビュー';
        avgNumEl.textContent = total > 0 ? avg.toFixed(1) : '—';
        avgStarsEl.textContent = total > 0 ? starStr(Math.round(avg)) : '☆☆☆☆☆';
        avgStarsEl.setAttribute('aria-label', '平均 ' + avg.toFixed(1) + ' / 5');
      }
      function createCard(rv) {
        var li = document.createElement('li');
        li.className = 'pdp-reviews__card ls-review';
        li.dataset.rating = String(rv.rating);
        li.innerHTML = [
          '<div class="pdp-reviews__head">',
          '<span class="pdp-reviews__avatar" aria-hidden="true">' + rv.name.charAt(0) + '</span>',
          '<div class="pdp-reviews__id">',
          '<span class="pdp-reviews__name"></span>',
          '<span class="pdp-reviews__meta">',
          '<span class="pdp-reviews__stars">' + starStr(rv.rating) + '</span>',
          '<span class="pdp-reviews__date">' + formatDate(rv.postedAt) + '</span>',
          '</span></div></div>',
          '<div class="pdp-reviews__body">',
          '<p class="pdp-reviews__title"></p>',
          '<p class="pdp-reviews__text"></p>',
          '</div>',
        ].join('');
        li.querySelector('.pdp-reviews__name').textContent = rv.name + ' 様';
        li.querySelector('.pdp-reviews__title').textContent = rv.title || '';
        li.querySelector('.pdp-reviews__text').textContent = rv.body;
        return li;
      }

      // 保存済みレビューをDOMに追加
      var stored = loadStored();
      if (list && stored.length > 0) {
        stored.slice().reverse().forEach(function (rv) {
          list.insertBefore(createCard(rv), list.firstChild);
        });
        recalcAvg();
      }

      // localStorage使用不可環境ではフォームを非表示
      if (formWrap) {
        try { localStorage.setItem('_ls_test', '1'); localStorage.removeItem('_ls_test'); }
        catch (e) { formWrap.hidden = true; return; }
      }

      // 投稿処理
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var nameVal = form.querySelector('#rf-name').value.trim();
          var ratingInput = form.querySelector('input[name="rating"]:checked');
          var ratingVal = ratingInput ? parseInt(ratingInput.value, 10) : 0;
          var titleVal = form.querySelector('#rf-title').value.trim();
          var bodyVal = form.querySelector('#rf-body').value.trim();

          if (!nameVal || !ratingVal || bodyVal.length < 10) {
            if (notice) notice.textContent = '名前・評価・本文(10文字以上)を入力してください。';
            return;
          }

          var rv = {
            id: 'ls-' + Date.now(),
            name: nameVal,
            rating: ratingVal,
            title: titleVal,
            body: bodyVal,
            postedAt: todayStr(),
          };

          var arr = loadStored();
          arr.push(rv);
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr)); }
          catch (e) {
            if (notice) notice.textContent = '保存に失敗しました。';
            return;
          }

          if (list) list.insertBefore(createCard(rv), list.firstChild);
          recalcAvg();
          form.reset();
          if (notice) {
            notice.textContent = 'レビューを投稿しました。ありがとうございます！';
            setTimeout(function () { notice.textContent = ''; }, 3000);
          }
        });
      }
    })();
  </script>
</Base>
