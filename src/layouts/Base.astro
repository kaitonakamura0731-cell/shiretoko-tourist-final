---
// 共通レイアウト — head / header / footer
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  robots?: string;
}
const { title, description, bodyClass = "", robots } = Astro.props;
const defaultDesc = "オホーツク産アスパラ、じゃがいも・玉ねぎ、Patagoniaウェアを北海道から直送。世界自然遺産・知床の現場ガイドが選ぶ北の食材と、店主と歩く知床ツアー。";
const path = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const navItems = [
  { href: "/products/specialty/", label: "産直" },
  { href: "/products/apparel/", label: "アパレル" },
  { href: "/bundles/", label: "セット" },
  { href: "/gift/", label: "ギフト" },
  { href: "/stories/", label: "ストーリー" },
  { href: "/ranking/", label: "ランキング" },
];

function isActive(href: string): boolean {
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? defaultDesc} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? defaultDesc} />
    <meta property="og:site_name" content="北の逸品堂 / 知床ツーリスト" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Inter:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="/cart.js" is:inline></script>
  </head>
  <body class={bodyClass}>
    <!-- 上部告知バー -->
    <div class="topbar">
      6月限定 / アスパラ・じゃがいも・玉ねぎを北海道から直送中 ・ ¥5,000以上で<b>送料無料</b> ・ <a href="/#retention">LINE登録で¥500 OFF</a>
    </div>

    <!-- ヘッダ -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark">北の逸品堂</span>
          <span class="brand__sub">知床ツーリスト / 1992 KIYOSATO</span>
        </a>
        <nav class="gnav" aria-label="主要メニュー">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={isActive(item.href) ? "is-tour" : undefined}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-utility">
          <a href="/account/" class="utility-link" aria-current={isActive("/account/") ? "page" : undefined}>マイページ</a>
          <a href="/cart" class="utility-cart" data-cart-link>カート</a>
          <details class="mobile-nav">
            <summary aria-label="メニューを開く">
              <span></span><span></span><span></span>
            </summary>
            <ul>
              {navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
                </li>
              ))}
              <li><a href="/account/" aria-current={isActive("/account/") ? "page" : undefined}>マイページ</a></li>
              <li><a href="/cart">カート</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <slot />

    <!-- フッタ -->
    <footer class="site-footer" id="company">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <span class="brand__mark">北の逸品堂</span>
            <span class="brand__sub">SHIRETOKO TOURIST / 1992</span>
            <p class="addr">
              株式会社 知床ツーリスト<br />
              〒099-4403 北海道斜里郡清里町字向陽282番地<br />
              旅行・ガイド: 0152-25-2642<br />
              ホステル: 0152-25-3995<br />
              北海道知事登録旅行業 第2-453号<br />
              全国旅行業協会 (ANTA) 所属
            </p>
          </div>
          <div>
            <h4>ショッピング</h4>
            <ul>
              <li><a href="/products/asparagus-1kg">朝採りアスパラ</a></li>
              <li><a href="/products/potato-onion-set">じゃがいも・玉ねぎ直送便</a></li>
              <li><a href="/products/potato-danshaku-30kg">男爵じゃがいも30kg</a></li>
              <li><a href="/products/patagonia-r1-air-hoodie">Patagonia R1</a></li>
              <li><a href="/products/patagonia-r1-zip-neck">R1ジップネック</a></li>
              <li><a href="/cart">カート</a></li>
            </ul>
          </div>
          <div>
            <h4>特集</h4>
            <ul>
              <li><a href="/ranking/">週間ランキング</a></li>
              <li><a href="/bundles/">セット販売</a></li>
              <li><a href="/gift/">ギフト・のし対応</a></li>
              <li><a href="/stories/">店主のフィールドノート</a></li>
            </ul>
          </div>
          <div>
            <h4>サポート / 会社</h4>
            <ul>
              <li><a href="/account/">送料・配送について</a></li>
              <li><a href="/account/">特定商取引法に基づく表記</a></li>
              <li><a href="https://shiretokotourist.com/" target="_blank" rel="noopener noreferrer">旅行業約款・取引条件説明書</a></li>
              <li><a href="/account/">プライバシーポリシー</a></li>
              <li><a href="/stories/">会社概要</a></li>
              <li><a href="/sitemap/">サイトマップ</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__legal">
          <span>(c) 1992-{currentYear} 株式会社 知床ツーリスト. All rights reserved.</span>
          <span class="payments">クレジットカード / コード決済 / 銀行振込 / 代引き</span>
        </div>
      </div>
    </footer>
  </body>
</html>
